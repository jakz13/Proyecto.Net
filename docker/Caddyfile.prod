# Balanceador y proxy inverso de producción.
# {$DOMINIO} lo toma de la variable de entorno; Caddy obtiene y renueva el certificado solo.

# Cabeceras de seguridad comunes a todos los sitios (OWASP): HTTPS forzado, sin sniffing de tipos, sin incrustación en marcos
(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "microphone=()"
		-Server
	}
}

# Interno (sin publicar): balanceador que usa el backoffice para llegar a la API.
:8081 {
	reverse_proxy api1:8080 api2:8080 {
		lb_policy round_robin
		health_uri /ready
		health_interval 10s
		health_timeout 8s
		health_fails 3
		lb_try_duration 5s
	}
}

{$DOMINIO} {
	import seguridad
	encode gzip

	# La API (REST, SignalR y salud) se reparte entre las dos instancias.
	# lb_policy cookie mantiene a cada cliente en la misma instancia (necesario para SignalR).
	@api path /api/* /hubs/* /swagger* /health /ready /live
	handle @api {
		reverse_proxy api1:8080 api2:8080 {
			lb_policy cookie
			health_uri /ready
			health_interval 10s
			health_timeout 8s
			health_fails 3
			lb_try_duration 5s
		}
	}

	# El resto es el backoffice (Razor Pages)
	handle {
		reverse_proxy backoffice:8080
	}
}

# Portal del comercio en su propio dominio. La API se sirve también aquí (mismo origen para el navegador).
{$DOMINIO_COMERCIO} {
	import seguridad
	encode gzip

	@api path /api/* /hubs/*
	handle @api {
		reverse_proxy api1:8080 api2:8080 {
			lb_policy cookie
			health_uri /ready
			health_interval 10s
			health_timeout 8s
			health_fails 3
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy portal-comercio:8080
	}
}

# Seguimiento público (sin login): el destinatario ingresa el código de envío. La API se sirve también aquí (mismo origen).
{$DOMINIO_SEGUIMIENTO} {
	import seguridad
	encode gzip

	@api path /api/* /hubs/*
	handle @api {
		reverse_proxy api1:8080 api2:8080 {
			lb_policy cookie
			health_uri /ready
			health_interval 10s
			health_timeout 8s
			health_fails 3
			lb_try_duration 5s
		}
	}

	handle {
		reverse_proxy seguimiento-publico:80
	}
}

# Panel de observabilidad (Grafana). Prometheus no se publica: solo Grafana lo consulta por la red interna.
{$DOMINIO_PANEL} {
	import seguridad
	encode gzip
	reverse_proxy grafana:3000
}
