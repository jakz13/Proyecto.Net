<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorCacheBootResources>false</BlazorCacheBootResources>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <DisableBuildCompression>true</DisableBuildCompression>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <Target Name="QuitarSimbolosPdbDeWasm" BeforeTargets="GeneratePublishWasmBootConfig;GenerateWasmBootConfig;_GenerateWasmBootConfig">
    <ItemGroup>
      <_WasmPdbFiles Remove="@(_WasmPdbFiles)" />
      <WasmBootConfigPdb Remove="@(WasmBootConfigPdb)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Frontend.Contracts\UltimaMilla.Frontend.Contracts.csproj" />
    <ProjectReference Include="..\Frontend.Infrastructure\UltimaMilla.Frontend.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

</Project>
