@inherits LayoutComponentBase
@inject ContextoSeguimientoOperador ContextoSeguimiento
@implements IDisposable

@* Inyección dinámica de variables CSS con transición fluida para la identidad visual *@
<style>
    :root {
        --color-primario: @ContextoSeguimiento.ColorPrimario;
        --color-secundario: @ContextoSeguimiento.ColorSecundario;
        --color-texto-primario: @ContextoSeguimiento.ColorTextoPrimario;
        --color-texto-secundario: @ContextoSeguimiento.ColorTextoSecundario;
    }
</style>

<div class="d-flex flex-column min-vh-100">
    <!-- Encabezado LittleBox Envíos con transición suave de color e identidad -->
    <header class="littlebox-header">
        <div class="container littlebox-header__contenedor">
            <div class="d-flex justify-content-between align-items-center">
                <a href="" class="littlebox-header__marca">
                    <div class="littlebox-header__logo-caja overflow-hidden">
                        <Icono Nombre="caja" Tamano="22" />
                    </div>
                    <div class="littlebox-header__titulos">
                        <span class="littlebox-header__nombre-app">LittleBox Envíos</span>
                        <span class="littlebox-header__subtitulo">Portal de Seguimiento de Envíos</span>
                    </div>
                </a>

                <!-- Datos del operador logístico (se muestran solo al ingresar el código del envío, fuera de etiquetas) -->
                @if (ContextoSeguimiento.TieneOperadorAsignado)
                {
                    <div class="d-flex align-items-center gap-2 animacion-fade-in" style="color: var(--color-texto-primario);">
                        @if (!string.IsNullOrEmpty(ContextoSeguimiento.LogoUrl))
                        {
                            <div class="bg-white p-1 rounded-2 shadow-xs d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px;">
                                <img src="@ContextoSeguimiento.LogoUrl" alt="@ContextoSeguimiento.NombreOperador" style="width: 100%; height: 100%; object-fit: contain;" />
                            </div>
                        }
                        <div class="text-end lh-1">
                            <div class="small opacity-75" style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em;">Operador</div>
                            <div class="fw-bold" style="font-size: 0.95rem;">@ContextoSeguimiento.NombreOperador</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow-1">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        ContextoSeguimiento.OnCambioIdentidad += ManejarCambioIdentidad;
    }

    private void ManejarCambioIdentidad()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ContextoSeguimiento.OnCambioIdentidad -= ManejarCambioIdentidad;
    }
}
