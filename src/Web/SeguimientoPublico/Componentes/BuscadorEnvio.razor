@using System.Text.RegularExpressions

@if (EsModoCompacto)
{
    <div class="buscador-seguimiento-compacto mb-4 p-2 px-3 bg-white border rounded-3 shadow-xs d-flex justify-content-between align-items-center flex-wrap gap-2">
        <form class="d-flex align-items-center gap-2 flex-grow-1" @onsubmit="ManejarBusqueda" style="max-width: 480px;">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0 text-muted">
                    <Icono Nombre="buscar" Tamano="14" />
                </span>
                <input type="text"
                       class="form-control form-control-sm border-start-0"
                       placeholder="Consultar otro código..."
                       @bind="CodigoSeguro"
                       @bind:event="oninput"
                       maxlength="30"
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="Código de seguimiento" />
            </div>
            <button type="submit" class="btn btn-outline-dark btn-sm px-3 d-inline-flex align-items-center gap-1" disabled="@EstaCargando">
                @if (EstaCargando)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <Icono Nombre="buscar" Tamano="14" />
                    <span>Rastrear</span>
                }
            </button>
        </form>
    </div>
}
else
{
    <div class="buscador-seguimiento">
        <h1 class="buscador-seguimiento__titulo">Consultá el estado de tu paquete</h1>
        <p class="buscador-seguimiento__subtitulo">Ingresá el código de seguimiento provisto por el comercio emisor.</p>

        <form class="buscador-seguimiento__form" @onsubmit="ManejarBusqueda">
            <div class="buscador-seguimiento__input-wrapper">
                <Icono Nombre="buscar" Tamano="18" Clase="buscador-seguimiento__icono-lupa" />
                <input type="text"
                       class="buscador-seguimiento__input"
                       placeholder="Ej: ENV-2026-00108"
                       @bind="CodigoSeguro"
                       @bind:event="oninput"
                       maxlength="30"
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="Código de seguimiento del paquete" />
            </div>
            <button type="submit" class="buscador-seguimiento__boton" disabled="@EstaCargando">
                @if (EstaCargando)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Buscando...</span>
                }
                else
                {
                    <Icono Nombre="buscar" Tamano="16" />
                    <span>Rastrear</span>
                }
            </button>
        </form>
    </div>
}

@code {
    [Parameter]
    public string CodigoInicial { get; set; } = string.Empty;

    [Parameter]
    public bool EstaCargando { get; set; } = false;

    [Parameter]
    public bool EsModoCompacto { get; set; } = false;

    [Parameter]
    public EventCallback<string> AlBuscar { get; set; }

    private string _codigo = string.Empty;

    // Propiedad protegida: sanitiza activamente en tiempo real cualquier caracter sospechoso o etiquetas
    private string CodigoSeguro
    {
        get => _codigo;
        set => _codigo = SanitizarEntrada(value);
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(CodigoInicial) && string.IsNullOrWhiteSpace(_codigo))
        {
            _codigo = SanitizarEntrada(CodigoInicial);
        }
    }

    private static string SanitizarEntrada(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return string.Empty;

        // Seguridad: solo permite caracteres alfanuméricos seguros y guiones.
        // Remueve activamente cualquier etiqueta HTML, comillas, scripts o código malicioso.
        var sanitizado = Regex.Replace(valor, @"[^A-Za-z0-9\-]", "");
        return sanitizado.Length > 30 ? sanitizado[..30] : sanitizado;
    }

    private async Task ManejarBusqueda()
    {
        var codigoLimpio = SanitizarEntrada(_codigo).Trim().ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(codigoLimpio))
        {
            _codigo = codigoLimpio;
            await AlBuscar.InvokeAsync(codigoLimpio);
        }
    }

}
