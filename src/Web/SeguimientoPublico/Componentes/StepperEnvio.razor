@using UltimaMilla.Frontend.Contracts.Enums

<div class="stepper-seguimiento shadow-xs">
    <ol class="stepper-seguimiento__lista">
        <!-- Paso 1: Admitido -->
        <li class="stepper-seguimiento__paso @ObtenerClasePaso(1)">
            <div class="stepper-seguimiento__nodo">
                <Icono Nombre="paquete" Tamano="16" />
            </div>
            <span class="stepper-seguimiento__etiqueta">Admitido</span>
            <div class="stepper-seguimiento__linea @(PasoActualNumero == 1 ? "stepper-seguimiento__linea--en-progreso" : "")"></div>
        </li>

        <!-- Paso 2: En Depósito -->
        <li class="stepper-seguimiento__paso @ObtenerClasePaso(2)">
            <div class="stepper-seguimiento__nodo">
                <Icono Nombre="deposito" Tamano="16" />
            </div>
            <span class="stepper-seguimiento__etiqueta">En depósito</span>
            <div class="stepper-seguimiento__linea @(PasoActualNumero == 2 ? "stepper-seguimiento__linea--en-progreso" : "")"></div>
        </li>

        <!-- Paso 3: En Tránsito / Reparto -->
        <li class="stepper-seguimiento__paso @ObtenerClasePaso(3)">
            <div class="stepper-seguimiento__nodo">
                <Icono Nombre="@IconoPaso3" Tamano="16" />
            </div>
            <span class="stepper-seguimiento__etiqueta">@EtiquetaPaso3</span>
            <div class="stepper-seguimiento__linea @(PasoActualNumero == 3 && Estado != EstadoEnvioDto.Entregado && Estado != EstadoEnvioDto.Devuelto ? "stepper-seguimiento__linea--en-progreso" : "")"></div>
        </li>

        <!-- Paso 4: Final (Entregado / Devuelto) -->
        <li class="stepper-seguimiento__paso @ObtenerClasePaso(4)">
            <div class="stepper-seguimiento__nodo">
                <Icono Nombre="@IconoPaso4" Tamano="16" />
            </div>
            <span class="stepper-seguimiento__etiqueta">@EtiquetaPaso4</span>
        </li>
    </ol>
</div>

@code {
    [Parameter, EditorRequired]
    public EstadoEnvioDto Estado { get; set; }

    private int PasoActualNumero => Estado switch
    {
        EstadoEnvioDto.Admitido => 1,
        EstadoEnvioDto.EnDeposito => 2,
EstadoEnvioDto.AsignadoARuta or EstadoEnvioDto.EnTransito or EstadoEnvioDto.NoEntregado or EstadoEnvioDto.Reprogramado or EstadoEnvioDto.EntregadoParcialmente => 3,
        EstadoEnvioDto.Entregado or EstadoEnvioDto.Devuelto or EstadoEnvioDto.Extraviado => 4,
        _ => 2
    };

    private string IconoPaso3 => Estado switch
    {
        EstadoEnvioDto.NoEntregado => "alerta",
        EstadoEnvioDto.Reprogramado => "reloj",
        EstadoEnvioDto.EnDevolucion => "alerta",
        _ => "camion"
    };

    private string EtiquetaPaso3 => Estado switch
    {
        EstadoEnvioDto.NoEntregado => "Intento fallido",
        EstadoEnvioDto.Reprogramado => "Reprogramado",
        EstadoEnvioDto.EnDevolucion => "En devolución",
        EstadoEnvioDto.AsignadoARuta => "En ruta",
        _ => "En camino"
    };

    private string IconoPaso4 => Estado switch
    {
        EstadoEnvioDto.Devuelto => "deposito",
        EstadoEnvioDto.Extraviado => "cerrar",
        _ => "check"
    };

    private string EtiquetaPaso4 => Estado switch
    {
        EstadoEnvioDto.Devuelto => "Devuelto",
        EstadoEnvioDto.Extraviado => "Extraviado",
        _ => "Entregado"
    };

    private string ObtenerClasePaso(int numeroPaso)
    {
        var completado = numeroPaso < PasoActualNumero || (numeroPaso == 4 && (Estado == EstadoEnvioDto.Entregado || Estado == EstadoEnvioDto.Devuelto));

        if (completado)
        {
            return "stepper-seguimiento__paso--completado";
        }

        if (numeroPaso == PasoActualNumero)
        {
            if (Estado == EstadoEnvioDto.NoEntregado || Estado == EstadoEnvioDto.Extraviado)
            {
                return "stepper-seguimiento__paso--alerta";
            }
            if (Estado == EstadoEnvioDto.Reprogramado || Estado == EstadoEnvioDto.EnDevolucion)
            {
                return "stepper-seguimiento__paso--reprogramado";
            }
            return "stepper-seguimiento__paso--activo";
        }

        return string.Empty;
    }
}
