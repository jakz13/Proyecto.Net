@page "/"
@page "/seguimiento/{CodigoUrl?}"
@inject ISeguimientoApi SeguimientoApi
@inject NavigationManager Navegador
@inject TiempoRealSeguimientoServicio TiempoReal
@inject ContextoSeguimientoOperador ContextoOperador
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>LittleBox Envíos — Seguimiento de Envíos</PageTitle>

<div class="container py-4 py-md-5" style="max-width: 720px;">
    <!-- Componente Modular: Buscador con Protección contra Código Malicioso y Pills Demo -->
    <BuscadorEnvio CodigoInicial="@codigoBuscado"
                   EstaCargando="@estaCargando"
                   EsModoCompacto="@(seguimiento != null)"
                   AlBuscar="EjecutarConsulta" />

    <!-- Notificaciones y Alertas (Anti-enumeración 404 y Límite de Tasa 429) -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <MensajeEstado Titulo="@(esErrorLimiteTasa ? "Límite de consultas temporalmente excedido" : "Código no encontrado")"
                       Mensaje="@mensajeError"
                       Tipo="@(esErrorLimiteTasa ? MensajeEstado.TipoAlerta.Aviso : MensajeEstado.TipoAlerta.Error)" />
    }

    <!-- Retiro en domicilio (RF 41): el comprador lo sigue por el mismo enlace que un envío -->
    @if (seguimiento != null && seguimiento.EsRetiro)
    {
        <div class="tarjeta-envio" data-tipo="retiro">
            <header class="tarjeta-envio__cabecera">
                <div class="tarjeta-envio__codigo-bloque">
                    <span class="tarjeta-envio__codigo-label">Código de seguimiento del retiro</span>
                    <h2 class="tarjeta-envio__codigo-valor mb-0">@seguimiento.CodigoSeguimiento</h2>
                </div>
                <span class="badge bg-dark align-self-center">@seguimiento.EstadoRetiro</span>
            </header>

            <div class="tarjeta-envio__cuerpo">
                <div class="alert @ClaseAlertaRetiro() border-0 shadow-xs rounded-3 p-3 mb-3" role="status">
                    <div class="fw-bold">@seguimiento.DescripcionEstado</div>
                    @if (!string.IsNullOrWhiteSpace(seguimiento.VentanaHorariaEstimada))
                    {
                        <div class="small text-secondary mt-1">Ventana estimada de la visita: @seguimiento.VentanaHorariaEstimada</div>
                    }
                </div>

                @if (seguimiento.TotalBultos > 0)
                {
                    <div class="alert alert-light border d-flex align-items-center justify-content-between py-2 px-3 mb-3">
                        <div class="d-flex align-items-center gap-2 small fw-semibold">
                            <Icono Nombre="paquete" Tamano="16" />
                            <span>Avance del retiro: @seguimiento.AvanceEntregaBultos</span>
                        </div>
                        <span class="badge bg-dark">@seguimiento.BultosEntregados / @seguimiento.TotalBultos retirados</span>
                    </div>
                }

                <div class="tarjeta-envio__actualizacion">
                    <Icono Nombre="reloj" Tamano="14" />
                    <span>Última actualización: @seguimiento.FechaUltimaActualizacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm") hs.</span>
                </div>

                <div class="linea-tiempo-bloque">
                    <h3 class="h6 fw-bold text-uppercase text-secondary mb-3">Historial del retiro</h3>
                    <ol class="linea-tiempo">
                        @foreach (var hito in seguimiento.HistorialEventos.OrderByDescending(h => h.Fecha))
                        {
                            <li class="linea-tiempo__item">
                                <span class="linea-tiempo__marcador"><Icono Nombre="paquete" Tamano="12" /></span>
                                <div class="linea-tiempo__cuerpo">
                                    <div class="linea-tiempo__encabezado">
                                        <span class="badge bg-secondary-subtle text-secondary border">@hito.EstadoTexto</span>
                                        <time class="linea-tiempo__fecha" datetime="@hito.Fecha.ToString("o")">@hito.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm") hs</time>
                                    </div>
                                    <p class="linea-tiempo__descripcion">@hito.DescripcionPublica</p>
                                </div>
                            </li>
                        }
                    </ol>
                </div>

                <div class="p-3 bg-light rounded-3 border mt-4 d-flex align-items-center gap-2">
                    <Icono Nombre="seguridad" Tamano="18" Clase="text-secondary flex-shrink-0" />
                    <div class="small text-secondary" style="font-size: 0.775rem;">
                        <strong>Privacidad garantizada:</strong> este seguimiento no muestra datos personales, domicilios ni contactos.
                    </div>
                </div>
            </div>
        </div>
    }
    else if (seguimiento != null)
    {
        <!-- Stepper de Etapas del Viaje con animación de progreso en tiempo real -->
        <StepperEnvio Estado="@seguimiento.EstadoActual" />

        <!-- Tarjeta Principal Unificada y Centralizada con Identidad Visual Dinámica -->
        <div class="tarjeta-envio @(seActualizoEnVivo ? "tarjeta-envio--actualizada" : "")">
            
            <!-- Cabecera Hero Unificada -->
            <header class="tarjeta-envio__cabecera-hero @ObtenerClaseHeroEstado(seguimiento.EstadoActual)">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <div class="tarjeta-envio__codigo-bloque">
                        <span class="tarjeta-envio__codigo-label">Código de seguimiento</span>
                        <h2 class="tarjeta-envio__codigo-valor mb-0">@seguimiento.CodigoSeguimiento</h2>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 d-inline-flex align-items-center gap-1 shadow-xs bg-white" @onclick="CopiarEnlace" title="Copiar enlace directo de seguimiento">
                        <Icono Nombre="copiar" Tamano="13" />
                        <span style="font-size: 0.75rem;">@(enlaceCopiado ? "¡Copiado!" : "Copiar enlace")</span>
                    </button>
                </div>

                <div class="d-flex align-items-center gap-3 pt-2 border-top border-light-subtle">
                    <div class="tarjeta-envio__icono-hero flex-shrink-0">
                        <Icono Nombre="@ObtenerIconoEstadoPrincipal(seguimiento.EstadoActual)" Tamano="22" />
                    </div>
                    <div>
                        <div class="fw-bold fs-6 tarjeta-envio__titulo-hero">
                            @ObtenerTituloEstadoPrincipal(seguimiento.EstadoActual)
                        </div>
                        <div class="small tarjeta-envio__subtitulo-hero">
                            @ObtenerDetalleEstadoPrincipal(seguimiento)
                        </div>
                    </div>
                </div>
            </header>

            <div class="tarjeta-envio__cuerpo">
                @if (seguimiento.TotalBultos > 0)
                {
                    <div class="alert @(seguimiento.EstadoActual == UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.EntregadoParcialmente ? "alert-warning" : "alert-light") border d-flex align-items-center justify-content-between py-2 px-3 mb-3">
                        <div class="d-flex align-items-center gap-2 small fw-semibold">
                            <Icono Nombre="paquete" Tamano="16" />
                            <span>Avance de entrega de bultos: @(seguimiento.AvanceEntregaBultos ?? $"{seguimiento.BultosEntregados} de {seguimiento.TotalBultos} bultos entregados")</span>
                        </div>
                        <span class="badge bg-dark">
                            @seguimiento.BultosEntregados / @seguimiento.TotalBultos entregados
                            @if (seguimiento.BultosPendientes > 0)
                            {
                                <span> (@seguimiento.BultosPendientes @(seguimiento.BultosPendientes == 1 ? "pendiente" : "pendientes"))</span>
                            }
                        </span>
                    </div>
                }

                <div class="tarjeta-envio__actualizacion mb-4">
                    <Icono Nombre="reloj" Tamano="14" />
                    <span>Última actualización: @seguimiento.FechaUltimaActualizacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm") hs.</span>
                </div>

                <!-- Reprogramación de Entrega (UC-34) -->
                @if (seguimiento.PermiteReprogramacion)
                {
                    <PanelReprogramacion CodigoSeguimiento="@seguimiento.CodigoSeguimiento"
                                         AlReprogramarExitoso="RefrescarEnvio" />
                }

                <!-- Línea de Tiempo de Hitos Históricos (Diseño sobrio y limpio) -->
                <LineaTiempoEventos Eventos="@seguimiento.HistorialEventos" />

                <!-- Garantía de Privacidad Explícita (Sin el texto RF-25) -->
                <div class="p-3 bg-light rounded-3 border mt-4 d-flex align-items-center gap-2">
                    <Icono Nombre="seguridad" Tamano="18" Clase="text-secondary flex-shrink-0" />
                    <div class="small text-secondary" style="font-size: 0.775rem;">
                        <strong>Privacidad garantizada:</strong> Este seguimiento público protege tu privacidad y la de terceros. No se exhiben datos personales, direcciones completas ni contactos en este enlace.
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? CodigoUrl { get; set; }

    private string codigoBuscado = string.Empty;
    private SeguimientoPublicoDto? seguimiento;
    private bool estaCargando = false;
    private string? mensajeError;
    private bool esErrorLimiteTasa = false;
    private bool enlaceCopiado = false;
    private bool seActualizoEnVivo = false;

    private string ClaseAlertaRetiro() => seguimiento?.EstadoRetiro switch
    {
        "EntregadoAlComercio" or "Retirado" or "EnDeposito" => "alert-success",
        "NoRetirado" or "Cancelado" => "alert-warning",
        _ => "alert-primary"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(CodigoUrl))
        {
            codigoBuscado = CodigoUrl;
            await EjecutarConsulta(CodigoUrl);
        }
    }

    private async Task CopiarEnlace()
    {
        try
        {
            var url = Navegador.Uri;
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            enlaceCopiado = true;
            StateHasChanged();
            await Task.Delay(2500);
            enlaceCopiado = false;
            StateHasChanged();
        }
        catch
        {
            // Continuar en caso de bloqueo de permisos de portapapeles
        }
    }

    private async Task EjecutarConsulta(string codigo)
    {
        if (string.IsNullOrWhiteSpace(codigo)) return;

        codigoBuscado = codigo.Trim().ToUpperInvariant();
        estaCargando = true;
        seguimiento = null;
        mensajeError = null;
        esErrorLimiteTasa = false;

        try
        {
            var resultado = await SeguimientoApi.ConsultarSeguimientoAsync(codigoBuscado);
            if (resultado != null)
            {
                seguimiento = resultado;
                // Al identificar el paquete se adopta suavemente la identidad del operador asignado
                ContextoOperador.FijarOperador(
                    resultado.OperadorNombre,
                    resultado.OperadorColorPrimario,
                    resultado.OperadorColorSecundario,
                    resultado.OperadorLogoUrl);

                await SeguirEnVivoAsync(codigoBuscado);
            }
            else
            {
                ContextoOperador.RestablecerNeutral();
                // Regla obligatoria: ante un código inexistente mostrar siempre el mismo mensaje genérico para evitar enumeración
                mensajeError = "No encontramos un envío asociado a este código. Verifique que esté bien escrito e intente nuevamente.";
            }
        }
        catch (ApiExcepcion ex) when (ex.EsLimiteDeTasa)
        {
            ContextoOperador.RestablecerNeutral();
            esErrorLimiteTasa = true;
            mensajeError = ex.Message;
        }
        catch (Exception)
        {
            ContextoOperador.RestablecerNeutral();
            mensajeError = "No fue posible consultar el estado en este momento. Por favor reintente más tarde.";
        }
        finally
        {
            estaCargando = false;
        }
    }

    private string? codigoEnVivo;
    private bool suscritoAlAviso;
    private CancellationTokenSource? _refrescoPendiente;

    // El destinatario ve el cambio de estado sin recargar: la señal llega por SignalR y la página consulta en silencio
    private async Task SeguirEnVivoAsync(string codigo)
    {
        if (!suscritoAlAviso)
        {
            TiempoReal.Actualizado += AlActualizarEnVivo;
            suscritoAlAviso = true;
        }

        codigoEnVivo = codigo;
        await TiempoReal.SeguirAsync(codigo);
    }

    private async Task AlActualizarEnVivo()
    {
        _refrescoPendiente?.Cancel();
        var cts = _refrescoPendiente = new CancellationTokenSource();
        try
        {
            await Task.Delay(600, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (string.IsNullOrEmpty(codigoEnVivo))
            return;

        await InvokeAsync(async () =>
        {
            try
            {
                var actualizado = await SeguimientoApi.ConsultarSeguimientoAsync(codigoEnVivo);
                if (actualizado != null)
                {
                    seguimiento = actualizado;
                    ContextoOperador.FijarOperador(
                        actualizado.OperadorNombre,
                        actualizado.OperadorColorPrimario,
                        actualizado.OperadorColorSecundario,
                        actualizado.OperadorLogoUrl);

                    // Animación visual de actualización en tiempo real
                    seActualizoEnVivo = true;
                    _ = Task.Delay(2500).ContinueWith(_ =>
                    {
                        seActualizoEnVivo = false;
                        InvokeAsync(StateHasChanged);
                    });
                }
            }
            catch
            {
                // Límite de tasa o red caída: se conserva lo que ya se muestra
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (suscritoAlAviso)
            TiempoReal.Actualizado -= AlActualizarEnVivo;

        _refrescoPendiente?.Cancel();
    }

    private async Task RefrescarEnvio()
    {
        if (!string.IsNullOrEmpty(codigoBuscado))
        {
            await EjecutarConsulta(codigoBuscado);
        }
    }

    private static string ObtenerIconoEstadoPrincipal(EstadoEnvioDto estado) => estado switch
    {
        EstadoEnvioDto.Admitido => "paquete",
        EstadoEnvioDto.EnDeposito => "deposito",
        EstadoEnvioDto.AsignadoARuta or EstadoEnvioDto.EnTransito => "camion",
        EstadoEnvioDto.Entregado => "check",
        EstadoEnvioDto.NoEntregado or EstadoEnvioDto.Extraviado => "alerta",
        EstadoEnvioDto.Reprogramado => "reloj",
        EstadoEnvioDto.EnDevolucion or EstadoEnvioDto.Devuelto => "deposito",
        _ => "info"
    };

    private static string ObtenerTituloEstadoPrincipal(EstadoEnvioDto estado) => estado switch
    {
        EstadoEnvioDto.Admitido => "Envío recibido y registrado",
        EstadoEnvioDto.EnDeposito => "En centro logístico de distribución",
        EstadoEnvioDto.AsignadoARuta => "Envío asignado a hoja de ruta",
        EstadoEnvioDto.EnTransito => "¡Tu paquete está en camino!",
        EstadoEnvioDto.Entregado => "¡Paquete entregado con éxito!",
        EstadoEnvioDto.NoEntregado => "No fue posible concretar la entrega",
        EstadoEnvioDto.Reprogramado => "Entrega reprogramada a nueva fecha",
        EstadoEnvioDto.EnDevolucion => "Paquete en devolución hacia el remitente",
        EstadoEnvioDto.Devuelto => "Paquete devuelto al comercio emisor",
        EstadoEnvioDto.Extraviado => "Incidencia en gestión operativa",
        _ => "Seguimiento en curso"
    };

    private static string ObtenerDetalleEstadoPrincipal(SeguimientoPublicoDto dto)
    {
        if (dto.EstadoActual == EstadoEnvioDto.Entregado)
            return !string.IsNullOrEmpty(dto.VentanaHorariaEstimada) ? dto.VentanaHorariaEstimada : "Entrega completada y confirmada en el domicilio.";

        if (!string.IsNullOrEmpty(dto.VentanaHorariaEstimada))
            return $"Horario estimado: {dto.VentanaHorariaEstimada}";

        return dto.EstadoActual switch
        {
            EstadoEnvioDto.EnTransito => "El repartidor se encuentra en ruta realizando las entregas del día en tu zona.",
            EstadoEnvioDto.NoEntregado => "Podés coordinar una nueva fecha u horario de entrega más abajo.",
            _ => "Seguimiento y actualizaciones automáticas del envío."
        };
    }

    private static string ObtenerClaseHeroEstado(EstadoEnvioDto estado) => estado switch
    {
        EstadoEnvioDto.NoEntregado or EstadoEnvioDto.Extraviado => "tarjeta-envio__cabecera-hero--error",
        EstadoEnvioDto.Reprogramado or EstadoEnvioDto.EnDevolucion or EstadoEnvioDto.Devuelto => "tarjeta-envio__cabecera-hero--aviso",
        _ => "tarjeta-envio__cabecera-hero--operador"
    };
}
