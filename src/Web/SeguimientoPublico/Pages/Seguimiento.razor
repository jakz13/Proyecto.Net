@page "/"
@page "/seguimiento/{CodigoUrl?}"
@inject ISeguimientoApi SeguimientoApi
@inject NavigationManager Navegador
@inject TiempoRealSeguimientoServicio TiempoReal
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>LittleBox Envíos — Seguimiento de Envíos</PageTitle>

<div class="container py-4 py-md-5" style="max-width: 720px;">
    <!-- Componente Modular: Buscador con Validación y Pills Demo -->
    <BuscadorEnvio CodigoInicial="@codigoBuscado"
                   EstaCargando="@estaCargando"
                   EsModoCompacto="@(seguimiento != null)"
                   AlBuscar="EjecutarConsulta" />

    <!-- Notificaciones y Alertas (Anti-enumeración 404 y Límite de Tasa 429) -->
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <MensajeEstado Titulo="@(esErrorLimiteTasa ? "Límite de consultas temporalmente excedido" : "Código no encontrado")"
                       Mensaje="@mensajeError"
                       Tipo="@(esErrorLimiteTasa ? MensajeEstado.TipoAlerta.Aviso : MensajeEstado.TipoAlerta.Error)" />
    }

    <!-- Información del Envío y Flujo Completo (UC-33) -->
    @if (seguimiento != null)
    {
        <!-- Stepper de Etapas del Viaje -->
        <StepperEnvio Estado="@seguimiento.EstadoActual" />

        <!-- Banner de Estado Hero -->
        @if (seguimiento.EstadoActual == EstadoEnvioDto.EnTransito)
        {
            <div class="alert alert-primary border-0 shadow-xs rounded-3 p-3 mb-3 d-flex align-items-center gap-3" role="status">
                <div class="p-2 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                    <Icono Nombre="camion" Tamano="20" />
                </div>
                <div>
                    <div class="fw-bold fs-6 text-primary">¡Tu paquete está en camino!</div>
                    <div class="small text-secondary">El repartidor se encuentra en ruta realizando las entregas del día en tu zona.</div>
                </div>
            </div>
        }
        else if (seguimiento.EstadoActual == EstadoEnvioDto.Entregado)
        {
            <div class="alert alert-success border-0 shadow-xs rounded-3 p-3 mb-3 d-flex align-items-center gap-3" role="status">
                <div class="p-2 bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                    <Icono Nombre="check" Tamano="20" />
                </div>
                <div>
                    <div class="fw-bold fs-6 text-success">¡Paquete entregado con éxito!</div>
                    <div class="small text-secondary">La entrega fue completada y confirmada en el domicilio.</div>
                </div>
            </div>
        }
        else if (seguimiento.EstadoActual == EstadoEnvioDto.NoEntregado)
        {
            <div class="alert alert-warning border-0 shadow-xs rounded-3 p-3 mb-3 d-flex align-items-center gap-3" role="status">
                <div class="p-2 bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                    <Icono Nombre="alerta" Tamano="20" />
                </div>
                <div>
                    <div class="fw-bold fs-6 text-dark">No fue posible concretar la entrega</div>
                    <div class="small text-secondary">No pudimos contactarte en el último intento. Podés coordinar una nueva fecha de entrega debajo.</div>
                </div>
            </div>
        }

        <div class="tarjeta-envio">
            <header class="tarjeta-envio__cabecera">
                <div class="tarjeta-envio__codigo-bloque">
                    <span class="tarjeta-envio__codigo-label">Código de Seguimiento</span>
                    <h2 class="tarjeta-envio__codigo-valor mb-0">@seguimiento.CodigoSeguimiento</h2>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2 d-inline-flex align-items-center gap-1 shadow-xs" @onclick="CopiarEnlace" title="Copiar enlace directo de seguimiento">
                        <Icono Nombre="copiar" Tamano="13" />
                        <span style="font-size: 0.75rem;">@(enlaceCopiado ? "¡Copiado!" : "Copiar enlace")</span>
                    </button>
                    <BadgeEstadoEnvio Estado="@seguimiento.EstadoActual" EsGrande="true" />
                </div>
            </header>

            <div class="tarjeta-envio__cuerpo">
                <!-- Ventana Horaria Estimada -->
                <VentanaHoraria Ventana="@seguimiento.VentanaHorariaEstimada" Estado="@seguimiento.EstadoActual" />

                @if (seguimiento.TotalBultos > 0)
                {
                    <div class="alert @(seguimiento.EstadoActual == UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.EntregadoParcialmente ? "alert-warning" : "alert-light") border d-flex align-items-center justify-content-between py-2 px-3 mb-3">
                        <div class="d-flex align-items-center gap-2 small fw-semibold">
                            <Icono Nombre="paquete" Tamano="16" />
                            <span>Avance de entrega de bultos: @(seguimiento.AvanceEntregaBultos ?? $"{seguimiento.BultosEntregados} de {seguimiento.TotalBultos} bultos entregados")</span>
                        </div>
                        <span class="badge bg-dark">
                            @seguimiento.BultosEntregados / @seguimiento.TotalBultos entregados
                            @if (seguimiento.BultosPendientes > 0)
                            {
                                <span> (@seguimiento.BultosPendientes @(seguimiento.BultosPendientes == 1 ? "pendiente" : "pendientes"))</span>
                            }
                        </span>
                    </div>
                }

                <div class="tarjeta-envio__actualizacion">
                    <Icono Nombre="reloj" Tamano="14" />
                    <span>Última actualización: @seguimiento.FechaUltimaActualizacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm") hs.</span>
                </div>

                <!-- Reprogramación de Entrega (UC-34) -->
                @if (seguimiento.PermiteReprogramacion)
                {
                    <PanelReprogramacion CodigoSeguimiento="@seguimiento.CodigoSeguimiento"
                                         AlReprogramarExitoso="RefrescarEnvio" />
                }

                <!-- Línea de Tiempo de Hitos Históricos -->
                <LineaTiempoEventos Eventos="@seguimiento.HistorialEventos" />

                <!-- Garantía de Privacidad Explícita (RF-25) -->
                <div class="p-3 bg-light rounded-3 border mt-4 d-flex align-items-center gap-2">
                    <Icono Nombre="seguridad" Tamano="18" Clase="text-secondary flex-shrink-0" />
                    <div class="small text-secondary" style="font-size: 0.775rem;">
                        <strong>Privacidad garantizada (RF-25):</strong> Este seguimiento público protege tu privacidad y la de terceros. No se exhiben datos personales, direcciones completas ni contactos en este enlace.
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? CodigoUrl { get; set; }

    private string codigoBuscado = string.Empty;
    private SeguimientoPublicoDto? seguimiento;
    private bool estaCargando = false;
    private string? mensajeError;
    private bool esErrorLimiteTasa = false;
    private bool enlaceCopiado = false;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(CodigoUrl))
        {
            codigoBuscado = CodigoUrl;
            await EjecutarConsulta(CodigoUrl);
        }
    }

    private async Task CopiarEnlace()
    {
        try
        {
            var url = Navegador.Uri;
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            enlaceCopiado = true;
            StateHasChanged();
            await Task.Delay(2500);
            enlaceCopiado = false;
            StateHasChanged();
        }
        catch
        {
            // Continuar en caso de bloqueo de permisos de portapapeles
        }
    }

    private async Task EjecutarConsulta(string codigo)
    {
        if (string.IsNullOrWhiteSpace(codigo)) return;

        codigoBuscado = codigo.Trim().ToUpperInvariant();
        estaCargando = true;
        seguimiento = null;
        mensajeError = null;
        esErrorLimiteTasa = false;

        try
        {
            var resultado = await SeguimientoApi.ConsultarSeguimientoAsync(codigoBuscado);
            if (resultado != null)
            {
                seguimiento = resultado;
                await SeguirEnVivoAsync(codigoBuscado);
            }
            else
            {
                // Regla obligatoria: ante un código inexistente mostrar siempre el mismo mensaje genérico para evitar enumeración
                mensajeError = "No encontramos un envío asociado a este código. Verifique que esté bien escrito e intente nuevamente.";
            }
        }
        catch (ApiExcepcion ex) when (ex.EsLimiteDeTasa)
        {
            // Regla obligatoria: manejar 429 con mensaje claro
            esErrorLimiteTasa = true;
            mensajeError = ex.Message;
        }
        catch (Exception)
        {
            mensajeError = "No fue posible consultar el estado en este momento. Por favor reintente más tarde.";
        }
        finally
        {
            estaCargando = false;
        }
    }

    private string? codigoEnVivo;
    private bool suscritoAlAviso;
    private CancellationTokenSource? _refrescoPendiente;

    // El destinatario ve el cambio de estado sin recargar: la señal llega por SignalR y la página consulta de nuevo en silencio
    private async Task SeguirEnVivoAsync(string codigo)
    {
        if (!suscritoAlAviso)
        {
            TiempoReal.Actualizado += AlActualizarEnVivo;
            suscritoAlAviso = true;
        }

        codigoEnVivo = codigo;
        await TiempoReal.SeguirAsync(codigo);
    }

    private async Task AlActualizarEnVivo()
    {
        _refrescoPendiente?.Cancel();
        var cts = _refrescoPendiente = new CancellationTokenSource();
        try
        {
            await Task.Delay(600, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (string.IsNullOrEmpty(codigoEnVivo))
            return;

        await InvokeAsync(async () =>
        {
            try
            {
                // Consulta silenciosa: no se limpia la pantalla ni se muestra el indicador de carga
                var actualizado = await SeguimientoApi.ConsultarSeguimientoAsync(codigoEnVivo);
                if (actualizado != null)
                    seguimiento = actualizado;
            }
            catch
            {
                // Límite de tasa o red caída: se conserva lo que ya se muestra
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (suscritoAlAviso)
            TiempoReal.Actualizado -= AlActualizarEnVivo;

        _refrescoPendiente?.Cancel();
    }

    private async Task RefrescarEnvio()
    {
        if (!string.IsNullOrEmpty(codigoBuscado))
        {
            await EjecutarConsulta(codigoBuscado);
        }
    }
}
