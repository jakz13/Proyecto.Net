@page "{id:guid}"
@model UltimaMilla.Backoffice.Pages.Usuarios.EditarModel
@{
    ViewData["Title"] = "Editar Usuario y Asignar Perfil";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Editar Usuario y Perfil</h1>
        <p class="text-secondary small mb-0">Modificación de información de usuario, asignación de perfil (rol) y cambio de estado.</p>
    </div>
    <a asp-page="/Comercios/Index" asp-route-tab="usuarios" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a Usuarios</span>
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger small py-2 mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@Model.ErrorMessage</span>
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 760px;">
    <div class="card-body p-4">
        <form method="post">
            <input type="hidden" asp-for="Id" />

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Usuario.Nombre" class="form-label small fw-semibold">Nombre y Apellido *</label>
                    <input asp-for="Usuario.Nombre" class="form-control form-control-sm" />
                    <span asp-validation-for="Usuario.Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Usuario.Email" class="form-label small fw-semibold">Correo Electrónico *</label>
                    <input asp-for="Usuario.Email" type="email" class="form-control form-control-sm" />
                    <span asp-validation-for="Usuario.Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Usuario.PerfilId" class="form-label small fw-semibold">Asignar Perfil (Rol) *</label>
                    <select asp-for="Usuario.PerfilId" class="form-select form-select-sm">
                        @foreach (var perfil in Model.Perfiles)
                        {
                            <option value="@perfil.Id" selected="@(Model.Usuario.PerfilId == perfil.Id)">
                                @perfil.Nombre — @perfil.Descripcion
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Usuario.PerfilId" class="text-danger small"></span>
                    <div class="form-text small">
                        El perfil determina los módulos visibles y permisos operativos del usuario en el sistema.
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Ámbito / Comercio Vinculado</label>
                    <input class="form-control form-control-sm" value="@(Model.NombreComercio ?? "Operador Logístico (Directo)")" disabled />
                    <div class="form-text small">
                        El comercio asignado queda determinado en el registro inicial del usuario.
                    </div>
                </div>
            </div>

            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" asp-for="Usuario.Activo" id="usuarioActivo" />
                <label class="form-check-label small fw-semibold" for="usuarioActivo">Usuario habilitado para iniciar sesión (Activo)</label>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-page="/Comercios/Index" asp-route-tab="usuarios" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                <button type="submit" class="btn btn-dark btn-sm px-3 d-inline-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Guardar Cambios</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
