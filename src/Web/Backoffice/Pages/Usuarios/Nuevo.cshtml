@page
@model UltimaMilla.Backoffice.Pages.Usuarios.NuevoModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Registrar Nuevo Usuario</h1>
        <p class="text-secondary small mb-0">Alta de cuenta de acceso y asignación de perfil (rol) para el operador o comercio asociado.</p>
    </div>
    <a asp-page="/Comercios/Index" asp-route-tab="usuarios" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a Usuarios</span>
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger small py-2 mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@Model.ErrorMessage</span>
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 760px;">
    <div class="card-body p-4">
        <form method="post">
            <!-- Fila 1: Nombre y Apellido separados -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Nombre" class="form-label small fw-semibold">Nombre *</label>
                    <input asp-for="NuevoUsuario.Nombre" class="form-control form-control-sm" placeholder="Ej: Marcela" required />
                    <span asp-validation-for="NuevoUsuario.Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Apellido" class="form-label small fw-semibold">Apellido *</label>
                    <input asp-for="NuevoUsuario.Apellido" class="form-control form-control-sm" placeholder="Ej: González" required />
                    <span asp-validation-for="NuevoUsuario.Apellido" class="text-danger small"></span>
                </div>
            </div>

            <!-- Fila 2: Correo y Contraseña -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Email" class="form-label small fw-semibold">Correo Electrónico (Login) *</label>
                    <input asp-for="NuevoUsuario.Email" type="email" class="form-control form-control-sm" placeholder="ejemplo@operador.uy" required />
                    <span asp-validation-for="NuevoUsuario.Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Password" class="form-label small fw-semibold">Contraseña Provisional *</label>
                    <input asp-for="NuevoUsuario.Password" type="password" class="form-control form-control-sm" placeholder="Mínimo 8 caracteres" minlength="8" required />
                    <span asp-validation-for="NuevoUsuario.Password" class="text-danger small"></span>
                </div>
            </div>

            <!-- Fila 3: Perfil con sólo el título del cargo -->
            <div class="mb-3">
                <label asp-for="NuevoUsuario.PerfilId" class="form-label small fw-semibold">Perfil / Rol a Asignar *</label>
                <select asp-for="NuevoUsuario.PerfilId" id="selectPerfilUsuario" class="form-select form-select-sm" required onchange="actualizarCamposSegunRol()">
                    <option value="">-- Seleccionar Rol --</option>
                    @foreach (var perfil in Model.Perfiles)
                    {
                        var etiquetaPerfil = string.Equals(perfil.Nombre, "Comercio", StringComparison.OrdinalIgnoreCase)
                            ? "Administrador de Comercio"
                            : perfil.Nombre;
                        <option value="@perfil.Id" data-nombre-rol="@perfil.Nombre">@etiquetaPerfil</option>
                    }
                </select>
                <span asp-validation-for="NuevoUsuario.PerfilId" class="text-danger small"></span>
            </div>

            <!-- Bloque operativo para Repartidor (unificado con Repartidores y Vehículos) -->
            <div id="bloqueDatosRepartidor" class="p-3 mb-3 rounded-3 border bg-light" style="display: none;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-dark">Datos Operativos del Repartidor (Sincronizado con Flota)</span>
                    <span class="badge bg-dark-subtle text-dark border" style="font-size: 0.7rem;">Padrón de Repartidores</span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NuevoUsuario.Documento" class="form-label small fw-semibold">Cédula / DNI *</label>
                        <input asp-for="NuevoUsuario.Documento" id="inputDocumentoRepartidor" class="form-control form-control-sm font-monospace" placeholder="Ej: 4.512.980-3" maxlength="30" />
                        <span asp-validation-for="NuevoUsuario.Documento" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NuevoUsuario.Telefono" class="form-label small fw-semibold">Teléfono Celular *</label>
                        <input asp-for="NuevoUsuario.Telefono" id="inputTelefonoRepartidor" class="form-control form-control-sm" placeholder="+598 99 111 222" maxlength="30" />
                        <span asp-validation-for="NuevoUsuario.Telefono" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="NuevoUsuario.VehiculoAsignadoId" class="form-label small fw-semibold">Asociar a Vehículo (Opcional)</label>
                        <select asp-for="NuevoUsuario.VehiculoAsignadoId" id="selectVehiculoRepartidor" class="form-select form-select-sm">
                            <option value="">-- Sin vehículo asignado inicialmente --</option>
                            @foreach (var vehiculo in Model.Vehiculos.Where(v => v.Activo))
                            {
                                <option value="@vehiculo.Id">
                                    @vehiculo.Patente - @vehiculo.Tipo (@vehiculo.CapacidadPeso.ToString("N0") kg / @vehiculo.CapacidadVolumen.ToString("N1") m³) @(vehiculo.RepartidorAsignadoId.HasValue ? $"[Reasignará desde {vehiculo.RepartidorAsignadoNombre}]" : "[Disponible]")
                                </option>
                            }
                        </select>
                        <div class="form-text small" style="font-size: 0.725rem;">
                            El repartidor quedará registrado automáticamente en el panel de Repartidores y Vehículos.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fila 4: Asociación a comercio cliente (opcional) -->
            <div class="mb-4" id="bloqueComercioAsociado">
                <label asp-for="NuevoUsuario.ComercioId" class="form-label small fw-semibold">Comercio Cliente Asociado (Opcional)</label>
                <select asp-for="NuevoUsuario.ComercioId" id="selectComercioAsociado" class="form-select form-select-sm">
                    <option value="">-- Ninguno (Usuario interno del Operador) --</option>
                    @foreach (var comercio in Model.Comercios)
                    {
                        <option value="@comercio.Id">Comercio: @comercio.NombreFantasia (@comercio.RazonSocial)</option>
                    }
                </select>
                <div class="form-text small" style="font-size: 0.725rem;">
                    Seleccione un comercio cliente si el usuario administra una tienda externa. Déjelo sin seleccionar para miembros del operador logístico.
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-page="/Comercios/Index" asp-route-tab="usuarios" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                <button type="submit" class="btn btn-dark btn-sm px-3 d-inline-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Guardar Usuario</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function actualizarCamposSegunRol() {
            const selectPerfil = document.getElementById('selectPerfilUsuario');
            if (!selectPerfil) return;
            const opcion = selectPerfil.options[selectPerfil.selectedIndex];
            const nombreRol = (opcion ? (opcion.getAttribute('data-nombre-rol') || opcion.text) : '').trim().toLowerCase();
            const esRepartidor = nombreRol === 'repartidor';

            const bloqueRepartidor = document.getElementById('bloqueDatosRepartidor');
            const inputDoc = document.getElementById('inputDocumentoRepartidor');
            const inputTel = document.getElementById('inputTelefonoRepartidor');
            const bloqueComercio = document.getElementById('bloqueComercioAsociado');
            const selectComercio = document.getElementById('selectComercioAsociado');

            if (bloqueRepartidor) {
                bloqueRepartidor.style.display = esRepartidor ? 'block' : 'none';
            }
            if (inputDoc) {
                inputDoc.required = esRepartidor;
            }
            if (inputTel) {
                inputTel.required = esRepartidor;
            }
            if (bloqueComercio) {
                bloqueComercio.style.display = esRepartidor ? 'none' : 'block';
                if (esRepartidor && selectComercio) {
                    selectComercio.value = '';
                }
            }
        }
        document.addEventListener('DOMContentLoaded', actualizarCamposSegunRol);
    </script>
}
