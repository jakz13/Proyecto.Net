@page
@model UltimaMilla.Backoffice.Pages.Usuarios.NuevoModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Registrar Nuevo Usuario</h1>
        <p class="text-secondary small mb-0">Alta de cuenta de acceso y asignación de perfil (rol) para el operador o comercio asociado.</p>
    </div>
    <a asp-page="/Comercios/Index" asp-route-tab="usuarios" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a Usuarios</span>
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger small py-2 mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@Model.ErrorMessage</span>
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 760px;">
    <div class="card-body p-4">
        <form method="post">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Nombre" class="form-label small fw-semibold">Nombre y Apellido *</label>
                    <input asp-for="NuevoUsuario.Nombre" class="form-control form-control-sm" placeholder="Ej: Marcela González" />
                    <span asp-validation-for="NuevoUsuario.Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Email" class="form-label small fw-semibold">Correo Electrónico (Login) *</label>
                    <input asp-for="NuevoUsuario.Email" type="email" class="form-control form-control-sm" placeholder="ejemplo@operador.uy" />
                    <span asp-validation-for="NuevoUsuario.Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Password" class="form-label small fw-semibold">Contraseña Provisional *</label>
                    <input asp-for="NuevoUsuario.Password" type="password" class="form-control form-control-sm" placeholder="Mínimo 6 caracteres" />
                    <span asp-validation-for="NuevoUsuario.Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.PerfilId" class="form-label small fw-semibold">Perfil / Rol a Asignar *</label>
                    <select asp-for="NuevoUsuario.PerfilId" class="form-select form-select-sm">
                        <option value="">-- Seleccionar Rol --</option>
                        @foreach (var perfil in Model.Perfiles)
                        {
                            <option value="@perfil.Id">@perfil.Nombre — @perfil.Descripcion</option>
                        }
                    </select>
                    <span asp-validation-for="NuevoUsuario.PerfilId" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="NuevoUsuario.ComercioId" class="form-label small fw-semibold">Ámbito del Usuario (Opcional)</label>
                <select asp-for="NuevoUsuario.ComercioId" class="form-select form-select-sm">
                    <option value="">Operador Logístico (Acceso interno)</option>
                    @foreach (var comercio in Model.Comercios)
                    {
                        <option value="@comercio.Id">Comercio: @comercio.NombreFantasia (@comercio.RazonSocial)</option>
                    }
                </select>
                <div class="form-text small">
                    Si el usuario es un administrador de comercio (ComercioAdmin), asócielo a su comercio cliente correspondiente.
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-page="/Comercios/Index" asp-route-tab="usuarios" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                <button type="submit" class="btn btn-dark btn-sm px-3 d-inline-flex align-items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Guardar Usuario</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
