@page
@model UltimaMilla.Backoffice.Pages.ReglasOperativas.NuevaVersionModel
@{
    ViewData["Title"] = "Publicar Nueva Versión de Reglas Operativas";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h4 fw-bold text-dark mb-0">Publicar Nueva Versión de Reglas Operativas (UC-04)</h1>
        <partial name="_BotonAyuda" model='"Al publicar, esta versión pasará a ser la vigente y la anterior se archivará cerrando su vigencia (RF-04)."' />
    </div>
    <a asp-page="/ReglasOperativas/Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a Reglas Operativas</span>
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger small py-2 mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
                <strong>Error de validación:</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        </div>
    </div>
}

<form method="post" id="formularioNuevaRegla">
    <!-- 1. Parámetros de la Versión -->
    <div class="panel-estandar mb-4">
        <div class="panel-estandar-header">
            <div class="d-flex align-items-center gap-2">
                <h2 class="h6 fw-bold mb-0 text-dark">1. Identificación y Vigencia de la Versión</h2>
                <partial name="_BotonAyuda" model='"Los envíos ya iniciados conservarán los plazos bajo los que fueron recibidos. La nueva versión aplica a partir de la fecha indicada."' />
            </div>
        </div>
        <div class="panel-estandar-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="NuevaVersion.Comentario" class="form-label small fw-semibold">Motivo / Justificación del Cambio Operativo</label>
                    <input asp-for="NuevaVersion.Comentario" class="form-control form-control-sm" placeholder="Ej: Ajuste de SLA para temporada alta y requerimiento de foto obligatoria" />
                    <span asp-validation-for="NuevaVersion.Comentario" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NuevaVersion.VigenteDesde" class="form-label small fw-semibold">Vigente a partir de</label>
                    <input asp-for="NuevaVersion.VigenteDesde" type="datetime-local" class="form-control form-control-sm"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    <span asp-validation-for="NuevaVersion.VigenteDesde" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Protocolo de Intentos y Reintentos -->
    <div class="panel-estandar mb-4">
        <div class="panel-estandar-header">
            <div class="d-flex align-items-center gap-2">
                <h2 class="h6 fw-bold mb-0 text-dark">2. Intentos de Entrega y Plazos entre Reintentos</h2>
                <partial name="_BotonAyuda" model='"Define la cantidad máxima de visitas antes de devolver el paquete y la separación mínima de horas entre intentos."' />
            </div>
        </div>
        <div class="panel-estandar-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NuevaVersion.MaxIntentosEntrega" class="form-label small fw-semibold">Cantidad Máxima de Intentos</label>
                    <div class="input-group input-group-sm">
                        <input asp-for="NuevaVersion.MaxIntentosEntrega" type="number" min="1" max="10" class="form-control" required />
                        <span class="input-group-text">intentos</span>
                    </div>
                    <span asp-validation-for="NuevaVersion.MaxIntentosEntrega" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NuevaVersion.HorasEntreIntentos" class="form-label small fw-semibold">Plazo Mínimo entre Intentos</label>
                    <div class="input-group input-group-sm">
                        <input asp-for="NuevaVersion.HorasEntreIntentos" type="number" min="1" max="168" class="form-control" required />
                        <span class="input-group-text">horas de espera</span>
                    </div>
                    <span asp-validation-for="NuevaVersion.HorasEntreIntentos" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Prueba de Entrega y Política de Devolución -->
    <div class="panel-estandar mb-4">
        <div class="panel-estandar-header">
            <div class="d-flex align-items-center gap-2">
                <h2 class="h6 fw-bold mb-0 text-dark">3. Prueba de Entrega y Política de Devolución</h2>
                <partial name="_BotonAyuda" model='"Determina los requisitos obligatorios para registrar la entrega y el protocolo al agotarse las visitas permitidas."' />
            </div>
        </div>
        <div class="panel-estandar-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NuevaVersion.TipoPruebaEntregaExigida" class="form-label small fw-semibold">Tipo de Prueba de Entrega Exigida</label>
                    <select asp-for="NuevaVersion.TipoPruebaEntregaExigida" class="form-select form-select-sm mb-2" id="selectorPrueba" onchange="actualizarPruebaTexto(this)">
                        <option value="Firma digital del receptor y Foto del paquete en domicilio">Firma digital + Foto del paquete en domicilio</option>
                        <option value="Firma digital simple del receptor">Firma digital simple</option>
                        <option value="Foto del paquete entregado en puerta o buzón">Foto del paquete en puerta</option>
                        <option value="Código PIN OTP de seguridad y Documento de Identidad">Código PIN OTP + Documento</option>
                        <option value="personalizado">Otro (especificar texto libre)...</option>
                    </select>
                    <input asp-for="NuevaVersion.TipoPruebaEntregaExigida" class="form-control form-control-sm" id="inputPruebaTexto" required />
                    <span asp-validation-for="NuevaVersion.TipoPruebaEntregaExigida" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NuevaVersion.PoliticaDevolucion" class="form-label small fw-semibold">Política de Devolución al Agotar Intentos</label>
                    <select asp-for="NuevaVersion.PoliticaDevolucion" class="form-select form-select-sm mb-2" id="selectorDevolucion" onchange="actualizarDevolucionTexto(this)">
                        <option value="Custodia por 72 horas en depósito central antes de retorno definitivo al comercio remitente">Custodia 72h en depósito central antes de retorno</option>
                        <option value="Devolución automática e inmediata al comercio remitente">Devolución inmediata al comercio remitente</option>
                        <option value="Custodia temporal por 5 días hábiles en punto Pickup cercano">Custodia 5 días en punto Pickup</option>
                        <option value="personalizado">Otro (especificar texto libre)...</option>
                    </select>
                    <input asp-for="NuevaVersion.PoliticaDevolucion" class="form-control form-control-sm" id="inputDevolucionTexto" required />
                    <span asp-validation-for="NuevaVersion.PoliticaDevolucion" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Plazos Comprometidos SLA por Modalidad -->
    <div class="panel-estandar mb-4">
        <div class="panel-estandar-header">
            <div class="d-flex align-items-center gap-2">
                <h2 class="h6 fw-bold mb-0 text-dark">4. Plazos Comprometidos SLA por Modalidad</h2>
                <partial name="_BotonAyuda" model='"Horas máximas comprometidas de entrega desde la admisión según la modalidad contratada."' />
            </div>
        </div>
        <div class="panel-estandar-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NuevaVersion.HorasPlazoComprometidoEstandar" class="form-label small fw-semibold">Plazo SLA Modalidad Estándar</label>
                    <div class="input-group input-group-sm">
                        <input asp-for="NuevaVersion.HorasPlazoComprometidoEstandar" type="number" min="1" max="240" class="form-control" required />
                        <span class="input-group-text">horas máximas</span>
                    </div>
                    <span asp-validation-for="NuevaVersion.HorasPlazoComprometidoEstandar" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NuevaVersion.HorasPlazoComprometidoUrgente" class="form-label small fw-semibold">Plazo SLA Modalidad Urgente / Express</label>
                    <div class="input-group input-group-sm">
                        <input asp-for="NuevaVersion.HorasPlazoComprometidoUrgente" type="number" min="1" max="72" class="form-control" required />
                        <span class="input-group-text">horas máximas</span>
                    </div>
                    <span asp-validation-for="NuevaVersion.HorasPlazoComprometidoUrgente" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="panel-estandar-footer d-flex justify-content-end gap-2">
            <a asp-page="/ReglasOperativas/Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
            <button type="submit" class="btn btn-dark btn-sm px-4 d-inline-flex align-items-center gap-1 shadow-sm"
                    onclick="return confirm('¿Confirma la publicación de esta nueva versión de reglas operativas? La versión anterior cerrará su vigencia y los nuevos envíos se regirán bajo estos parámetros.');">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Publicar como Versión Vigente</span>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function actualizarPruebaTexto(select) {
            if (select.value !== 'personalizado') {
                document.getElementById('inputPruebaTexto').value = select.value;
            }
        }

        function actualizarDevolucionTexto(select) {
            if (select.value !== 'personalizado') {
                document.getElementById('inputDevolucionTexto').value = select.value;
            }
        }
    </script>
}
