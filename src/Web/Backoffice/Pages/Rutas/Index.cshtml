@page
@model UltimaMilla.Backoffice.Pages.Rutas.IndexModel
@{
    ViewData["Title"] = "Hojas de Ruta y Despacho";
    var fechaSeleccionada = !string.IsNullOrEmpty(Model.FechaFiltro) ? Model.FechaFiltro : DateTime.UtcNow.ToString("yyyy-MM-dd");
}

<!-- Encabezado Principal -->
<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h4 fw-bold mb-0">Hojas de Ruta y Despacho</h1>
        <partial name="_BotonAyuda" model='"Planificación diaria de rutas de entrega para repartidores. Permite validar capacidad de vehículos, paradas máximas, ordenar paradas y liberar las rutas para su ejecución móvil."' />
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-page="/Rutas/Armar" class="btn btn-dark btn-sm d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span class="fw-semibold">Armar Hoja de Ruta</span>
        </a>
    </div>
</div>

<!-- Alertas de Notificación -->
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <div>@Model.MensajeExito</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div>@Model.MensajeError</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Tarjetas Métricas de la Jornada -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
            <span class="text-secondary small fw-semibold mb-1">Hojas de Ruta</span>
            <div class="h3 fw-bold mb-0 text-dark">@Model.HojasDeRuta.Count</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
            <span class="text-secondary small fw-semibold mb-1">Pendientes en Depósito</span>
            <div class="h3 fw-bold mb-0 text-dark">@Model.EnviosPendientesCount</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
            <span class="text-secondary small fw-semibold mb-1">Paradas Programadas</span>
            <div class="h3 fw-bold mb-0 text-dark">@Model.HojasDeRuta.Sum(r => r.CantidadParadas)</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white d-flex flex-column justify-content-between">
            <span class="text-secondary small fw-semibold mb-1">Acción Inmediata</span>
            <a asp-page="/Rutas/Armar" class="btn btn-outline-dark btn-sm w-100 fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                <span>Nueva Planificación →</span>
            </a>
        </div>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted">Fecha</span>
                    <input type="date" name="fechaFiltro" value="@Model.FechaFiltro" class="form-control" onchange="this.form.submit()" />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="repartidorFiltro" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Todos los repartidores</option>
                    @foreach (var rep in Model.Repartidores)
                    {
                        <option value="@rep.Id" selected="@(Model.RepartidorFiltro == rep.Id)">@rep.NombreCompleto</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="estadoFiltro" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="todos" selected="@(Model.EstadoFiltro == "todos")">Todos los estados</option>
                    <option value="Liberada" selected="@(Model.EstadoFiltro == "Liberada")">Liberada</option>
                    <option value="EnCarga" selected="@(Model.EstadoFiltro == "EnCarga")">En Carga</option>
                    <option value="Despachada" selected="@(Model.EstadoFiltro == "Despachada")">Despachada</option>
                    <option value="EnTransito" selected="@(Model.EstadoFiltro == "EnTransito")">En Tránsito</option>
                    <option value="Finalizada" selected="@(Model.EstadoFiltro == "Finalizada")">Finalizada</option>
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-1">
                <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control form-control-sm" placeholder="Buscar por número o matrícula..." />
                <button type="submit" class="btn btn-dark btn-sm px-3">Filtrar</button>
                @if (!string.IsNullOrEmpty(Model.FechaFiltro) || Model.RepartidorFiltro.HasValue || Model.EstadoFiltro != "todos" || !string.IsNullOrEmpty(Model.Busqueda))
                {
                    <a asp-page="/Rutas/Index" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros">✕</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Listado de Hojas de Ruta -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 14%;">Número de Ruta</th>
                    <th style="width: 12%;">Fecha / Viaje</th>
                    <th style="width: 22%;">Repartidor y Vehículo</th>
                    <th class="text-center" style="width: 10%;">Paradas</th>
                    <th style="width: 22%;">Ocupación del Vehículo</th>
                    <th class="text-center" style="width: 10%;">Estado</th>
                    <th class="text-end" style="width: 10%;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.HojasDeRuta.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-2 text-secondary opacity-50" aria-hidden="true">
                                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                                <line x1="8" y1="2" x2="8" y2="18"></line>
                                <line x1="16" y1="6" x2="16" y2="22"></line>
                            </svg>
                            <div class="fw-semibold">No se encontraron hojas de ruta para los filtros aplicados</div>
                            <p class="small mb-3">Puedes armar una nueva hoja de ruta seleccionando repartidor, vehículo y envíos en depósito.</p>
                            <a asp-page="/Rutas/Armar" class="btn btn-dark btn-sm">Armar Nueva Hoja de Ruta</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ruta in Model.HojasDeRuta)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark font-monospace">@ruta.NumeroRuta</div>
                                <div class="text-muted small" style="font-size: 0.725rem;">Creada: @ruta.FechaCreacion.ToLocalTime().ToString("dd/MM HH:mm")</div>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">@ruta.Fecha.ToString("dd/MM/yyyy")</div>
                                <div>
                                    <span class="badge @(ruta.ViajeNumero > 1 ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-light text-secondary border")" style="font-size: 0.7rem;">
                                        Viaje @ruta.ViajeNumero · @ruta.Turno
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark small">@ruta.RepartidorNombre</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">
                                    <span class="badge bg-dark-subtle text-dark border font-monospace me-1">@ruta.VehiculoMatricula</span>
                                    <span>@ruta.VehiculoModelo</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-2 py-1 fw-bold font-monospace" style="font-size: 0.8rem;">
                                    @ruta.CantidadParadas
                                </span>
                                <div class="text-muted" style="font-size: 0.68rem;">paradas</div>
                            </td>
                            <td>
                                <!-- Ocupación de Peso -->
                                <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.725rem;">
                                    <span class="text-muted">Peso: <strong>@ruta.PesoTotalKg.ToString("N1")</strong> / @ruta.CapacidadPesoMaxKg.ToString("N0") kg</span>
                                    <span class="fw-semibold @(ruta.PorcentajeOcupacionPeso > 90 ? "text-danger" : "text-dark")">@ruta.PorcentajeOcupacionPeso%</span>
                                </div>
                                <div class="progress mb-2" style="height: 6px;">
                                    <div class="progress-bar @(ruta.PorcentajeOcupacionPeso > 90 ? "bg-danger" : (ruta.PorcentajeOcupacionPeso > 75 ? "bg-warning" : "bg-success"))" 
                                         role="progressbar" 
                                         style="width: @ruta.PorcentajeOcupacionPeso%" 
                                         aria-valuenow="@ruta.PorcentajeOcupacionPeso" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                    </div>
                                </div>

                                <!-- Ocupación de Volumen -->
                                <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.725rem;">
                                    <span class="text-muted">Volumen: <strong>@ruta.VolumenTotalM3.ToString("N2")</strong> / @ruta.CapacidadVolumenMaxM3.ToString("N1") m³</span>
                                    <span class="fw-semibold @(ruta.PorcentajeOcupacionVolumen > 90 ? "text-danger" : "text-dark")">@ruta.PorcentajeOcupacionVolumen%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @(ruta.PorcentajeOcupacionVolumen > 90 ? "bg-danger" : (ruta.PorcentajeOcupacionVolumen > 75 ? "bg-warning" : "bg-info"))" 
                                         role="progressbar" 
                                         style="width: @ruta.PorcentajeOcupacionVolumen%" 
                                         aria-valuenow="@ruta.PorcentajeOcupacionVolumen" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (ruta.Estado == "Liberada")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
                                        ● Liberada
                                    </span>
                                }
                                else if (ruta.Estado == "EnCarga")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" style="font-size: 0.75rem;">
                                        ● En Carga
                                    </span>
                                }
                                else if (ruta.Estado == "EnTransito" || ruta.Estado == "Despachada")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 0.75rem;">
                                        ● En Tránsito
                                    </span>
                                }
                                else if (ruta.Estado == "Finalizada")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1" style="font-size: 0.75rem;">
                                        ✓ Finalizada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.75rem;">
                                        @ruta.Estado
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="/Rutas/Detalle" asp-route-id="@ruta.Id" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" title="Ver Itinerario y Paradas">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <span>Itinerario</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
