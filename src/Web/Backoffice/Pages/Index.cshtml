@page
@model UltimaMilla.Backoffice.Pages.IndexModel
@{
    ViewData["Title"] = "Panel de Control";
    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Sin perfil";
}

<div class="mb-4">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h4 fw-bold mb-0">Panel de Control del Operador</h1>
        <partial name="_BotonAyuda" model='"Métricas clave de operación, cuentas activas y flujo reciente de despachos en la red."' />
    </div>
    <p class="text-muted small mb-0 mt-1">
        Bienvenido <strong>@User.Identity?.Name</strong>. Sesión activa con perfil <strong>@rol</strong>.
    </p>
</div>

<!-- Tarjetas de Métricas Rápidas Estandarizadas con Componentes -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <partial name="_TarjetaMetrica" model='new TarjetaMetricaViewModel(
            "Comercios Clientes",
            Model.TotalComercios.ToString(),
            "Comercios clientes registrados en la red del operador logístico.",
            "text-dark",
            "Gestionar Comercios →",
            Url.Page("/Comercios/Index", new { tab = "comercios" })
        )' />
    </div>
    <div class="col-sm-6 col-md-3">
        <partial name="_TarjetaMetrica" model='new TarjetaMetricaViewModel(
            "Usuarios del Operador",
            Model.TotalUsuarios.ToString(),
            "Cuentas internas del operador con perfiles asignados (RF-31).",
            "text-dark",
            "Gestionar Usuarios →",
            Url.Page("/Comercios/Index", new { tab = "usuarios" })
        )' />
    </div>
    <div class="col-sm-6 col-md-3">
        <partial name="_TarjetaMetrica" model='new TarjetaMetricaViewModel(
            "Total Envíos",
            Model.TotalEnvios.ToString(),
            "Total de órdenes de envío registradas en la plataforma logística.",
            "text-primary",
            "Ver Envíos →",
            "#envios-recientes"
        )' />
    </div>
    <div class="col-sm-6 col-md-3">
        <partial name="_TarjetaMetrica" model='new TarjetaMetricaViewModel(
            "Mi Perfil Activo",
            rol,
            "Perfil y nivel de acceso asociado a la sesión activa.",
            "text-dark",
            "Cambiar Perfil →",
            Url.Page("/Login")
        )' />
    </div>
</div>

<!-- Envíos Recientes de la Red con Panel Estandarizado -->
<div class="panel-estandar" id="envios-recientes">
    <div class="panel-estandar-header">
        <div class="d-flex align-items-center gap-2">
            <h2 class="h6 fw-bold mb-0 text-dark">Últimos Envíos Registrados en la Red</h2>
            <partial name="_BotonAyuda" model='"Listado cronológico de los despachos procesados recientemente en la plataforma."' />
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-compacta mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Destinatario</th>
                    <th>Dirección</th>
                    <th>Fecha Alta</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.EnviosRecientes.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No hay envíos registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var envio in Model.EnviosRecientes)
                    {
                        <tr>
                            <td class="font-monospace fw-bold text-primary">@envio.CodigoSeguimiento</td>
                            <td>@envio.NombreDestinatario</td>
                            <td class="text-muted small">@envio.DireccionDestino</td>
                            <td class="small">@envio.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @switch (envio.Estado)
                                {
                                    case EstadoEnvioDto.Entregado:
                                        <span class="estado-entregado">Entregado</span>
                                        break;
                                    case EstadoEnvioDto.NoEntregado:
                                        <span class="estado-fallo">No Entregado</span>
                                        break;
                                    case EstadoEnvioDto.Admitido:
                                        <span class="estado-intermedio">Admitido</span>
                                        break;
                                    case EstadoEnvioDto.EnDeposito:
                                        <span class="estado-intermedio">En Depósito</span>
                                        break;
                                    case EstadoEnvioDto.AsignadoARuta:
                                        <span class="estado-intermedio">Asignado a Ruta</span>
                                        break;
                                    case EstadoEnvioDto.EnTransito:
                                        <span class="estado-intermedio">En Tránsito</span>
                                        break;
                                    default:
                                        <span class="estado-intermedio">@envio.Estado</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
