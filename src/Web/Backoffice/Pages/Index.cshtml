@page
@model IndexModel
@{
    ViewData["Title"] = "Backoffice — Envíos";
}

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-end">
        <div>
            <h1 class="fs-4 fw-semibold mb-1">Envíos registrados</h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Listado de órdenes de despacho de última milla.</p>
        </div>
        <a href="/" class="btn btn-sm btn-outline-secondary">Actualizar</a>
    </div>
    <hr class="mt-3 mb-0" />
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger mb-4" role="alert">
        <strong>Error de conexión.</strong>
        <div class="small mt-1">@Model.ErrorMessage</div>
    </div>
}

<div class="card border rounded-2 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Envios.Count == 0 && Model.IsApiReachable)
        {
            <div class="text-center py-5 text-muted">
                <p class="mb-1">No hay envíos registrados.</p>
                <p class="small mb-0">Los envíos creados desde el Portal del Comercio aparecerán aquí.</p>
            </div>
        }
        else if (Model.Envios.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 25%;">Destinatario</th>
                            <th scope="col" style="width: 35%;">Dirección</th>
                            <th scope="col" style="width: 25%;">Fecha de creación</th>
                            <th scope="col" style="width: 15%;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var envio in Model.Envios)
                        {
                            <tr>
                                <td>
                                    <div class="fw-medium">@envio.NombreDestinatario</div>
                                    <small class="text-muted font-monospace" style="font-size: 0.72rem;">@envio.Id</small>
                                </td>
                                <td class="text-muted">@envio.DireccionDestino</td>
                                <td class="text-muted">@envio.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge text-bg-success">@envio.Estado</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
