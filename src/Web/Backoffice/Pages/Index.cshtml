@page
@model UltimaMilla.Backoffice.Pages.IndexModel
@{
    ViewData["Title"] = "Panel de Control";
    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Sin perfil";
}

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">Panel de Control del Operador</h1>
    <p class="text-muted small mb-0">
        Bienvenido <strong>@User.Identity?.Name</strong>. Sesión activa con perfil <strong>@rol</strong>.
    </p>
</div>

<!-- Tarjetas de Métricas Rápidas -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold text-uppercase">Comercios Clientes</div>
            <div class="h2 fw-bold mb-0 text-dark">@Model.TotalComercios</div>
            <div class="small text-secondary mt-1">Registrados en la red</div>
            @if (User.IsInRole("Administrador"))
            {
                <div class="mt-2">
                    <a asp-page="/Comercios/Index" asp-route-tab="comercios" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: 0.775rem;">
                        Gestionar &rarr;
                    </a>
                </div>
            }
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold text-uppercase">Usuarios del Operador</div>
            <div class="h2 fw-bold mb-0 text-dark">@Model.TotalUsuarios</div>
            <div class="small text-secondary mt-1">Cuentas con roles (RF-31)</div>
            @if (User.IsInRole("Administrador"))
            {
                <div class="mt-2">
                    <a asp-page="/Comercios/Index" asp-route-tab="usuarios" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: 0.775rem;">
                        Gestionar &rarr;
                    </a>
                </div>
            }
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold text-uppercase">Total Envíos</div>
            <div class="h2 fw-bold mb-0 text-primary">@Model.TotalEnvios</div>
            <div class="small text-secondary mt-1">En el sistema logístico</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold text-uppercase">Mi Perfil Activo</div>
            <div class="h4 fw-bold mb-0 text-dark">@rol</div>
            <div class="small text-secondary mt-1">Permisos adaptados al rol</div>
            <div class="mt-2">
                <a asp-page="/Login" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.775rem;">
                    Cambiar Perfil &rarr;
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Envíos Recientes de la Red -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom">
        <h2 class="h6 fw-bold mb-0">Últimos Envíos Registrados en la Red</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-compacta mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Destinatario</th>
                    <th>Dirección</th>
                    <th>Fecha Alta</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.EnviosRecientes.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No hay envíos registrados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var envio in Model.EnviosRecientes)
                    {
                        <tr>
                            <td class="font-monospace fw-bold text-primary">@envio.CodigoSeguimiento</td>
                            <td>@envio.NombreDestinatario</td>
                            <td class="text-muted small">@envio.DireccionDestino</td>
                            <td class="small">@envio.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge-estado badge-estado-@envio.Estado.ToString().ToLowerInvariant()">
                                    ● @envio.Estado
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
