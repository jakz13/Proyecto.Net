@inject UltimaMilla.Backoffice.Seguridad.IdentidadDelOperadorEnSesion IdentidadOperador
@inject IWebHostEnvironment Entorno
@inject IConfiguration Configuracion
@{
    var operadorActivo = await IdentidadOperador.ObtenerAsync();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Backoffice del Operador</title>
    <link rel="stylesheet" href="~/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --color-primario: @operadorActivo.ColorPrimario;
            --color-secundario: @operadorActivo.ColorSecundario;
            --color-texto-primario: @operadorActivo.ColorTextoSobrePrimario;
            --color-texto-secundario: @operadorActivo.ColorTextoSobreSecundario;
        }
    </style>
    <script>
        // Evita el parpadeo de layout aplicando el estado colapsado antes del render
        if (localStorage.getItem('sidebar_colapsada') === 'true') {
            document.documentElement.classList.add('sidebar-colapsada');
        }
    </script>
</head>
@{
    // Todas las pantallas se actualizan solas ante cualquier cambio de datos (otra sesión de la misma cuenta, otro usuario del operador), salvo las de alta o edición
    // (Nuevo, Nueva, NuevaVersion, Editar) y las de acceso: ahí hay formularios armados con JavaScript que una actualización automática podría pisar.
    // Una página puede forzarlo con ViewData["TiempoRealEnvios"] = true | false.
    var paginaActual = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    var esPaginaDeFormulario = System.Text.RegularExpressions.Regex.IsMatch(paginaActual, "/(Nuevo|Nueva|NuevaVersion|Editar|Login|Logout|Error|AccesoDenegado)$");
    var tiempoRealActivo = ViewData["TiempoRealEnvios"] is bool forzado ? forzado : !esPaginaDeFormulario;
}
<body data-tiempo-real-envios="@(tiempoRealActivo ? "true" : "false")" data-despachador="@(User.IsInRole("Despachador") ? "true" : "false")">
    <!-- Componente de Barra Lateral Anclada y Colapsable -->
    <partial name="_Sidebar" />

    <!-- Contenedor Principal con margen dinámico y scroll independiente -->
    <div class="layout-contenido-principal">
        @* El banner es solo del modo demo (selector de perfil sin contraseña); con login real no se muestra, ni en desarrollo *@
        @if (UltimaMilla.Backoffice.Pages.LoginModel.ModoDemoActivo(Configuracion, Entorno))
        {
            <!-- Banner de desarrollo: Selector de operador y conmutador rápido de perfiles para demo oral -->
            <div class="banner-demo-dev d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge bg-warning text-dark me-2">DEMO MODO DEV</span>
                    <span>Operador: <strong>@operadorActivo.NombreComercial</strong> (@operadorActivo.OperadorId)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small fw-semibold text-dark">Perfil actual:</span>
                    <span class="badge bg-dark text-white fw-bold px-2 py-1 shadow-sm border border-secondary badge-perfil-demo">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Sin rol")</span>
                    <a asp-page="/Login" class="btn btn-outline-dark btn-sm py-0 px-2 fw-semibold fs-tamano-xs">Cambiar Perfil</a>
                </div>
            </div>
        }

        <main role="main" class="p-4 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <!-- Panel de confirmación reutilizable: cualquier botón de envío con data-confirmar="texto" lo abre en lugar del confirm() del navegador -->
    <div class="modal fade" id="modalConfirmacionGlobal" tabindex="-1" aria-labelledby="tituloConfirmacionGlobal" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h6 fw-bold" id="tituloConfirmacionGlobal">Confirmar acción</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body small">
                    <p class="mb-0" id="textoConfirmacionGlobal"></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-dark btn-sm" id="botonConfirmacionGlobal">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/bootstrap/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var modalEl = document.getElementById('modalConfirmacionGlobal');
            var pendiente = null;
            document.addEventListener('click', function (e) {
                var boton = e.target.closest('[data-confirmar]');
                if (!boton || !modalEl || !window.bootstrap) return;
                if (boton.dataset.confirmado === '1') { delete boton.dataset.confirmado; return; }
                e.preventDefault();
                pendiente = boton;
                document.getElementById('tituloConfirmacionGlobal').textContent = boton.dataset.confirmarTitulo || 'Confirmar acción';
                document.getElementById('textoConfirmacionGlobal').textContent = boton.dataset.confirmar;
                var si = document.getElementById('botonConfirmacionGlobal');
                si.textContent = boton.dataset.confirmarBoton || 'Confirmar';
                window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
            document.getElementById('botonConfirmacionGlobal').addEventListener('click', function () {
                var boton = pendiente; pendiente = null;
                if (!boton) return;
                window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                boton.dataset.confirmado = '1';
                boton.click();
            });
        })();
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/mapas-leaflet.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous"></script>
    <script src="~/js/tiempo-real-envios.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>