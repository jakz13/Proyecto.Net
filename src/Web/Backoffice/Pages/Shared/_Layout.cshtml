@inject MockContextoOperador ContextoOperador
@inject IWebHostEnvironment Entorno
@{
    var operadorActivo = ContextoOperador.OperadorActivo;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Backoffice del Operador</title>
    <link rel="stylesheet" href="~/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --color-primario: @operadorActivo.ColorPrimario;
            --color-secundario: @operadorActivo.ColorSecundario;
            --color-texto-primario: @operadorActivo.ColorTextoSobrePrimario;
            --color-texto-secundario: @operadorActivo.ColorTextoSobreSecundario;
        }
    </style>
    <script>
        // Evita el parpadeo de layout aplicando el estado colapsado antes del render
        if (localStorage.getItem('sidebar_colapsada') === 'true') {
            document.documentElement.classList.add('sidebar-colapsada');
        }
    </script>
</head>
<body>
    <!-- Componente de Barra Lateral Anclada y Colapsable -->
    <partial name="_Sidebar" />

    <!-- Contenedor Principal con margen dinámico y scroll independiente -->
    <div class="layout-contenido-principal">
        @if (Entorno.IsDevelopment())
        {
            <!-- Banner de desarrollo: Selector de operador y conmutador rápido de perfiles para demo oral -->
            <div class="banner-demo-dev d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge bg-warning text-dark me-2">DEMO MODO DEV</span>
                    <span>Operador: <strong>@operadorActivo.NombreComercial</strong> (@operadorActivo.OperadorId)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">Perfil actual:</span>
                    <span class="badge bg-dark">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Sin rol")</span>
                    <a asp-page="/Login" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: 0.75rem;">Cambiar Perfil</a>
                </div>
            </div>
        }

        <main role="main" class="p-4 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <script src="~/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>