@inject MockContextoOperador ContextoOperador
@inject IWebHostEnvironment Entorno
@{
    var operadorActivo = ContextoOperador.OperadorActivo;
    var esAdmin = User.IsInRole("Administrador");
    var esDespachador = User.IsInRole("Despachador");
    var esOperario = User.IsInRole("Operario");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Backoffice del Operador</title>
    <link rel="stylesheet" href="~/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (Entorno.IsDevelopment())
    {
        <!-- Banner de desarrollo: Selector de operador y conmutador rápido de perfiles para demo oral -->
        <div class="banner-demo-dev d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-warning text-dark me-2">DEMO MODO DEV</span>
                <span>Operador: <strong>@operadorActivo.NombreComercial</strong> (@operadorActivo.OperadorId)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted">Perfil actual:</span>
                <span class="badge bg-dark">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Sin rol")</span>
                <a asp-page="/Login" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: 0.75rem;">Cambiar Perfil</a>
            </div>
        </div>
    }

    <div class="d-flex min-vh-100">
        <!-- Barra Lateral Oscura (Sidebar) -->
        <nav class="sidebar-oscura p-3 d-flex flex-column flex-shrink-0" style="width: 250px;">
            <div class="d-flex align-items-center gap-2 pb-3 mb-3 border-bottom border-secondary">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                     style="width: 32px; height: 32px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                </div>
                <div>
                    <div class="fw-bold text-white small">@operadorActivo.NombreComercial</div>
                    <div class="text-secondary" style="font-size: 0.75rem;">Backoffice Logístico</div>
                </div>
            </div>

            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-page="/Index">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Inicio</span>
                    </a>
                </li>

                @* Menú según perfil: Administrador *@
                @if (esAdmin)
                {
                    <li class="sidebar-seccion">Administración</li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Comercios") == true || ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Usuarios") == true ? "active" : "")" asp-page="/Comercios/Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span>Comercios y Usuarios (UC-01)</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Zonas") == true ? "active" : "")" asp-page="/Zonas/Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                                <line x1="8" y1="2" x2="8" y2="18"></line>
                                <line x1="16" y1="6" x2="16" y2="22"></line>
                            </svg>
                            <span>Zonas y Franjas (UC-02)</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Tarifas") == true ? "active" : "")" asp-page="/Tarifas/Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="12" y1="1" x2="12" y2="23"></line>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                            <span>Cuadro Tarifario (UC-03)</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/ReglasOperativas") == true ? "active" : "")" asp-page="/ReglasOperativas/Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                            </svg>
                            <span>Reglas Operativas (UC-04)</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/MotivosNoEntrega") == true ? "active" : "")" asp-page="/MotivosNoEntrega/Index">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                            </svg>
                            <span>Motivos No Entrega (UC-05)</span>
                        </a>
                    </li>
                }

                @* Menú según perfil: Despachador *@
                @if (esDespachador || esAdmin)
                {
                    <li class="sidebar-seccion">Despacho & Rutas</li>
                    <li class="nav-item">
                        <span class="nav-link d-flex align-items-center gap-2 text-muted" style="cursor: not-allowed;" title="Próximas iteraciones">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                                <line x1="8" y1="2" x2="8" y2="18"></line>
                                <line x1="16" y1="6" x2="16" y2="22"></line>
                            </svg>
                            <span>Hojas de Ruta (UC-09)</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <span class="nav-link d-flex align-items-center gap-2 text-muted" style="cursor: not-allowed;" title="Próximas iteraciones">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="2"></circle>
                                <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
                            </svg>
                            <span>Tablero en Vivo (UC-12)</span>
                        </span>
                    </li>
                }

                @* Menú según perfil: Operario *@
                @if (esOperario || esAdmin)
                {
                    <li class="sidebar-seccion">Depósito</li>
                    <li class="nav-item">
                        <span class="nav-link d-flex align-items-center gap-2 text-muted" style="cursor: not-allowed;" title="Próximas iteraciones">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
                                <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
                            </svg>
                            <span>Recepción Depósito (UC-16)</span>
                        </span>
                    </li>
                }
            </ul>

            <div class="pt-3 border-top border-secondary">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="small text-truncate" style="max-width: 140px;">
                        <div class="fw-semibold text-white">@User.Identity?.Name</div>
                        <div class="text-secondary" style="font-size: 0.75rem;">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                    </div>
                    <a asp-page="/Logout" class="btn btn-outline-danger btn-sm py-1 px-2 d-inline-flex align-items-center" title="Cerrar Sesión">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Contenedor Principal de Contenido -->
        <div class="flex-grow-1 bg-light">
            <header class="bg-white border-bottom py-2 px-4 d-flex justify-content-between align-items-center">
                <div class="fw-semibold text-secondary small">
                    Plataforma SaaS Multioperador · .NET 10
                </div>
                <div class="text-muted small">
                    Tenant: <strong class="text-dark">@operadorActivo.NombreComercial</strong>
                </div>
            </header>

            <main role="main" class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>