@page "{id:guid}"
@model UltimaMilla.Backoffice.Pages.Despacho.VerificarModel
@{
    ViewData["Title"] = "Control de Carga y Despacho";
    var control = Model.Control;
}

@if (control == null)
{
    <div class="alert alert-warning">Hoja de ruta no encontrada.</div>
}
else
{
    <!-- Encabezado Principal -->
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="h4 fw-bold text-dark mb-0 font-monospace">@control.NumeroRuta</h1>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        ● @control.EstadoRuta
                    </span>
                    <span class="badge @(control.ViajeNumero > 1 ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-light text-secondary border")">
                        Viaje @control.ViajeNumero · @control.Turno
                    </span>
                </div>
                <div class="text-secondary small mt-1">
                    Control físico de bultos en muelle antes de autorizar la salida del vehículo.
                </div>
            </div>
        </div>
        <a asp-page="/Despacho/Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Volver a Salidas</span>
        </a>
    </div>

    <!-- Errores de Precondición o Validación Fallida -->
    @if (Model.ErroresValidacion.Count > 0)
    {
        <div class="alert alert-danger border-danger shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2 mb-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <h2 class="h6 fw-bold mb-0 text-danger">Impedimento para Despachar la Hoja de Ruta</h2>
            </div>
            <ul class="small mb-0 ps-3">
                @foreach (var err in Model.ErroresValidacion)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    <!-- Panel de Validación de Precondiciones del Repartidor y Flota -->
    <div class="row g-3 mb-4">
        <!-- Repartidor y Verificación de Rendición Previa -->
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="text-secondary small fw-semibold mb-1">Repartidor Asignado</div>
                <div class="h5 fw-bold text-dark mb-1">@control.RepartidorNombre</div>
                <div class="mt-2">
                    @if (control.TieneRutaPendienteDeRendir)
                    {
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 text-danger small fw-semibold">
                            <div class="d-flex align-items-center gap-2">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="15" y1="9" x2="9" y2="15"></line>
                                    <line x1="9" y1="9" x2="15" y2="15"></line>
                                </svg>
                                <span>Tiene ruta previa sin rendir: <strong>@control.NumeroRutaPendienteRendicion</strong></span>
                            </div>
                            <button type="submit" form="formRendirPrevia" class="btn btn-outline-warning btn-sm py-0 px-2 text-dark fw-semibold" style="font-size: 0.75rem;">
                                Registrar Rendición en Depósito
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 text-success small fw-semibold">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            <span>Habilitado: no posee hojas de ruta pendientes de liquidación/rendición.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Vehículo Asignado y Capacidad Nominal -->
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="text-secondary small fw-semibold mb-1">Vehículo Asignado</div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-dark-subtle text-dark border font-monospace fs-6">@control.VehiculoMatricula</span>
                    <span class="h6 fw-bold mb-0 text-dark">@control.VehiculoModelo</span>
                </div>
                <div class="text-muted small mt-2">
                    Capacidad máxima: <strong class="text-dark">@control.CapacidadPesoMaxKg.ToString("N0") kg</strong> · <strong class="text-dark">@control.CapacidadVolumenMaxM3.ToString("N1") m³</strong>
                </div>
            </div>
        </div>
    </div>

    @if (control.TieneRutaPendienteDeRendir)
    {
        <form method="post" asp-page-handler="RendirRutaPrevia" id="formRendirPrevia" style="display: none;">
            <input type="hidden" name="Formulario.HojaDeRutaId" value="@control.HojaDeRutaId" />
            <input type="hidden" name="numeroRuta" value="@control.NumeroRutaPendienteRendicion" />
        </form>
    }

    <form method="post" id="formDespacho">
        <input type="hidden" asp-for="Formulario.HojaDeRutaId" value="@control.HojaDeRutaId" />

        <div class="row g-4">
            <!-- =========================================================================
                 Columna Izquierda: Tabla de Verificación de Carga de Bultos
                 ========================================================================= -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                                <span>Verificación de Bultos Cargados en el Vehículo</span>
                                <span class="badge bg-secondary-subtle text-dark border font-monospace" id="badgeTotalBultos">@control.TotalBultos bultos</span>
                            </h2>
                            <span class="text-muted small" style="font-size: 0.75rem;">
                                La carga del vehículo fue escaneada y sincronizada (UC-18). Desmarque los bultos no encontrados o dañados.
                            </span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="tablaVerificacionBultos">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 14%;">Escaneo</th>
                                    <th style="width: 22%;">Envío / Bulto</th>
                                    <th style="width: 26%;">Destinatario / Dirección</th>
                                    <th class="text-end" style="width: 13%;">Peso / Vol.</th>
                                    <th class="text-center" style="width: 25%;">Carga Efectiva</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < control.Bultos.Count; i++)
                                {
                                    var bulto = control.Bultos[i];
                                    <tr class="fila-bulto" 
                                        id="fila-bulto-@bulto.EnvioId"
                                        data-envioid="@bulto.EnvioId"
                                        data-codigo="@bulto.CodigoSeguimiento"
                                        data-destinatario="@bulto.Destinatario"
                                        data-peso="@bulto.PesoKg"
                                        data-volumen="@bulto.VolumenM3">
                                        <td>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                <span>Escaneado</span>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark font-monospace small">@bulto.CodigoSeguimiento</div>
                                            <div class="text-muted font-monospace" style="font-size: 0.68rem;">@bulto.CodigoBulto</div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark small">@bulto.Destinatario</div>
                                            <div class="text-muted" style="font-size: 0.725rem;">@bulto.Direccion</div>
                                            <span class="badge bg-secondary-subtle text-secondary border mt-1" style="font-size: 0.65rem;">
                                                @bulto.Zona
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="small fw-semibold text-dark">@bulto.PesoKg.ToString("N1") kg</div>
                                            <div class="text-muted" style="font-size: 0.68rem;">@bulto.VolumenM3.ToString("N3") m³</div>
                                        </td>
                                        <td class="text-center">
                                            <div class="form-check form-switch d-inline-flex align-items-center gap-2 mb-1">
                                                <input class="form-check-input chk-carga" 
                                                       type="checkbox" 
                                                       id="chk_@bulto.EnvioId" 
                                                       checked 
                                                       onchange="alternarEstadoCarga('@bulto.EnvioId')" />
                                                <label class="form-check-label small fw-semibold text-success lbl-estado-carga" id="lbl_@bulto.EnvioId" for="chk_@bulto.EnvioId">
                                                    Cargado
                                                </label>
                                            </div>

                                            <!-- Sub-panel para especificar discrepancia si NO fue cargado -->
                                            <div class="panel-no-carga mt-2 p-2 bg-light border border-warning rounded text-start" id="panel_no_carga_@bulto.EnvioId" style="display: none;">
                                                <div class="text-danger fw-semibold small mb-1 d-flex align-items-center gap-1" style="font-size: 0.725rem;">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <circle cx="12" cy="12" r="10"></circle>
                                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                                    </svg>
                                                    <span>No se cargó (Vuelve a depósito)</span>
                                                </div>
                                                <select class="form-select form-select-sm mb-1 sel-motivo" id="sel_motivo_@bulto.EnvioId" onchange="actualizarResumen()">
                                                    <option value="NoEncontrado">No se encontró en depósito</option>
                                                    <option value="Danado">Bulto dañado</option>
                                                    <option value="DireccionIlegible">Etiqueta ilegible</option>
                                                    <option value="Discrepancia">Discrepancia de peso / volumen</option>
                                                </select>
                                                <input type="text" class="form-control form-control-sm inp-detalle" id="inp_detalle_@bulto.EnvioId" placeholder="Detalle u observación..." onchange="actualizarResumen()" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- =========================================================================
                 Columna Derecha: Resumen de Despacho y Botón de Salida
                 ========================================================================= -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 sticky-top" style="top: 20px;">
                    <div class="card-header bg-white border-bottom py-3">
                        <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center justify-content-between">
                            <span>Resumen del Despacho</span>
                            <span class="badge bg-secondary-subtle text-dark border font-monospace" id="lblTotalCargados">@control.TotalBultos / @control.TotalBultos</span>
                        </h2>
                    </div>

                    <div class="card-body p-3">
                        <!-- Balance de Carga Efectiva -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-dark">Bultos en Tránsito:</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" id="txtConteoEnTransito">@control.TotalBultos cargados</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-dark">Reintegrados a Depósito:</span>
                                <span class="badge bg-secondary-subtle text-secondary border font-monospace" id="txtConteoReintegrados">0 retirados</span>
                            </div>
                        </div>

                        <!-- Panel de Alerta para Despachador si hay discrepancias -->
                        <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3" id="alertaDiscrepanciaDespachador" style="display: none;">
                            <div class="fw-bold mb-1">⚠️ Aviso Automático al Despachador</div>
                            <div id="txtDetalleDiscrepancia" style="font-size: 0.75rem;">
                                Los bultos no cargados volverán a "En Depósito" y quedarán inmediatamente disponibles para otra hoja de ruta del mismo día.
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- Ocupación Efectiva Recalculada -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-dark">Peso Efectivo Cargado:</span>
                                <span class="small font-monospace" id="lblPesoEfectivo">0.0 kg</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-dark">Volumen Efectivo:</span>
                                <span class="small font-monospace" id="lblVolumenEfectivo">0.00 m³</span>
                            </div>
                        </div>

                        <!-- Observaciones de Salida del Operario -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Observaciones del Operario:</label>
                            <textarea asp-for="Formulario.ObservacionesSalida" class="form-control form-control-sm" rows="2" placeholder="Notas sobre el estado de la carga o vehículo..."></textarea>
                        </div>

                        <!-- Toggle de Simulación de Precondición: Ruta previa sin rendir -->
                        <div class="p-2 bg-light border rounded mb-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" asp-for="Formulario.SimularRutaPreviaSinRendir" id="checkSimularSinRendir">
                                <label class="form-check-label small text-secondary" for="checkSimularSinRendir" style="font-size: 0.75rem;">
                                    Simular repartidor con ruta previa sin rendir
                                </label>
                            </div>
                        </div>

                        <!-- Contenedor oculto de campos para bultos no cargados -->
                        <div id="contenedorBultosNoCargadosOcultos"></div>

                        <!-- Botón de Confirmación de Despacho -->
                        <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold shadow-sm d-inline-flex align-items-center justify-content-center gap-2" id="btnConfirmarSalida">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Confirmar Salida del Vehículo</span>
                        </button>
                        <div class="text-center mt-2">
                            <span class="text-muted" style="font-size: 0.72rem;">Pasa a "En Tránsito" solo los envíos efectivamente cargados.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            actualizarResumen();
        });

        function alternarEstadoCarga(envioId) {
            var chk = document.getElementById('chk_' + envioId);
            var lbl = document.getElementById('lbl_' + envioId);
            var panel = document.getElementById('panel_no_carga_@Model.Control?.HojaDeRutaId' ? document.getElementById('panel_no_carga_' + envioId) : null);
            var fila = document.getElementById('fila-bulto-' + envioId);

            if (chk.checked) {
                lbl.textContent = 'Cargado';
                lbl.className = 'form-check-label small fw-semibold text-success lbl-estado-carga';
                if (panel) panel.style.display = 'none';
                if (fila) fila.classList.remove('table-warning');
            } else {
                lbl.textContent = 'No cargado';
                lbl.className = 'form-check-label small fw-semibold text-danger lbl-estado-carga';
                if (panel) panel.style.display = 'block';
                if (fila) fila.classList.add('table-warning');
            }

            actualizarResumen();
        }

        function actualizarResumen() {
            var filas = document.querySelectorAll('.fila-bulto');
            var totalBultos = filas.length;
            var cargados = 0;
            var noCargados = 0;
            var pesoTotal = 0;
            var volumenTotal = 0;
            var itemsNoCargados = [];

            filas.forEach(function (f) {
                var envioId = f.getAttribute('data-envioid');
                var codigo = f.getAttribute('data-codigo');
                var peso = parseFloat(f.getAttribute('data-peso') || '0');
                var vol = parseFloat(f.getAttribute('data-volumen') || '0');
                var chk = document.getElementById('chk_' + envioId);

                if (chk && chk.checked) {
                    cargados++;
                    pesoTotal += peso;
                    volumenTotal += vol;
                } else {
                    noCargados++;
                    var selMotivo = document.getElementById('sel_motivo_' + envioId);
                    var inpDetalle = document.getElementById('inp_detalle_' + envioId);
                    var motivo = selMotivo ? selMotivo.value : 'NoEncontrado';
                    var detalle = inpDetalle ? inpDetalle.value : '';

                    itemsNoCargados.push({
                        envioId: envioId,
                        codigo: codigo,
                        motivo: motivo,
                        detalle: detalle
                    });
                }
            });

            // Actualizar etiquetas
            document.getElementById('lblTotalCargados').textContent = cargados + ' / ' + totalBultos;
            document.getElementById('txtConteoEnTransito').textContent = cargados + ' cargados';
            document.getElementById('txtConteoReintegrados').textContent = noCargados + ' devueltos';
            document.getElementById('lblPesoEfectivo').textContent = pesoTotal.toFixed(1) + ' kg';
            document.getElementById('lblVolumenEfectivo').textContent = volumenTotal.toFixed(2) + ' m³';

            // Alerta si hay discrepancia
            var alerta = document.getElementById('alertaDiscrepanciaDespachador');
            if (noCargados > 0) {
                alerta.style.display = 'block';
                document.getElementById('txtDetalleDiscrepancia').textContent =
                    noCargados + ' bulto(s) excluidos volverán inmediatamente a "En Depósito" y se informará al despachador.';
            } else {
                alerta.style.display = 'none';
            }

            // Habilitar/Deshabilitar botón de confirmar salida
            var btn = document.getElementById('btnConfirmarSalida');
            if (cargados === 0) {
                btn.disabled = true;
            } else {
                btn.disabled = false;
            }

            // Inyectar campos ocultos en el formulario para los bultos no cargados
            var contenedorOculto = document.getElementById('contenedorBultosNoCargadosOcultos');
            contenedorOculto.innerHTML = '';

            itemsNoCargados.forEach(function (it, idx) {
                var inputId = document.createElement('input');
                inputId.type = 'hidden';
                inputId.name = 'Formulario.BultosNoCargados[' + idx + '].EnvioId';
                inputId.value = it.envioId;
                contenedorOculto.appendChild(inputId);

                var inputCod = document.createElement('input');
                inputCod.type = 'hidden';
                inputCod.name = 'Formulario.BultosNoCargados[' + idx + '].CodigoSeguimiento';
                inputCod.value = it.codigo;
                contenedorOculto.appendChild(inputCod);

                var inputMot = document.createElement('input');
                inputMot.type = 'hidden';
                inputMot.name = 'Formulario.BultosNoCargados[' + idx + '].Motivo';
                inputMot.value = it.motivo;
                contenedorOculto.appendChild(inputMot);

                var inputDet = document.createElement('input');
                inputDet.type = 'hidden';
                inputDet.name = 'Formulario.BultosNoCargados[' + idx + '].Detalle';
                inputDet.value = it.detalle;
                contenedorOculto.appendChild(inputDet);
            });
        }
    </script>
}
