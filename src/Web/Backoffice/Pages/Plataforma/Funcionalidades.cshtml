@page
@model UltimaMilla.Backoffice.Pages.Plataforma.FuncionalidadesModel
@{
    ViewData["Title"] = "Funcionalidades por operador";
    var hayFiltros = !string.IsNullOrWhiteSpace(Model.Q) || !string.IsNullOrEmpty(Model.Funcionalidad) || !string.IsNullOrEmpty(Model.Estado);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h1 class="h4 fw-bold mb-1">Funcionalidades por operador</h1>
        <p class="text-muted small mb-0">Active o desactive funcionalidades para cada operador sin desplegar. El cambio rige de inmediato y sus usuarios web reciben un aviso en el momento.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success small py-2" role="status">@Model.MensajeExito</div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger small py-2" role="alert">@Model.MensajeError</div>
}

<form method="get" class="card border-0 shadow-sm rounded-3 mb-3" data-sin-refresco>
    <div class="card-body row g-2 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label small fw-semibold mb-1" for="q">Buscar operador</label>
            <input id="q" name="q" value="@Model.Q" class="form-control form-control-sm" placeholder="Nombre del operador" autocomplete="off" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small fw-semibold mb-1" for="funcionalidad">Funcionalidad</label>
            <select id="funcionalidad" name="funcionalidad" class="form-select form-select-sm">
                <option value="">Todas</option>
                @foreach (var c in Model.Catalogo)
                {
                    <option value="@c.Clave" selected="@(Model.Funcionalidad == c.Clave)">@c.Nombre</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-semibold mb-1" for="estado">Estado</label>
            <select id="estado" name="estado" class="form-select form-select-sm">
                <option value="">Cualquiera</option>
                <option value="habilitada" selected="@(Model.Estado == "habilitada")">Habilitada</option>
                <option value="deshabilitada" selected="@(Model.Estado == "deshabilitada")">Deshabilitada</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-sm flex-grow-1">Buscar</button>
            @if (hayFiltros)
            {
                <a asp-page="/Plataforma/Funcionalidades" class="btn btn-outline-secondary btn-sm">Limpiar</a>
            }
        </div>
    </div>
</form>

<p class="text-muted small mb-2">Mostrando @Model.Operadores.Count de @Model.TotalOperadores operadores.</p>

@if (Model.Operadores.Count == 0)
{
    <div class="alert alert-light border small">@(hayFiltros ? "Ningún operador coincide con la búsqueda." : "No hay operadores para mostrar.")</div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Operador</th>
                        @foreach (var c in Model.Catalogo)
                        {
                            <th>@c.Nombre</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var operador in Model.Operadores)
                    {
                        <tr>
                            <td class="fw-semibold">@operador.Nombre</td>
                            @foreach (var c in Model.Catalogo)
                            {
                                var f = operador.Funcionalidades.FirstOrDefault(x => x.Clave == c.Clave);
                                <td>
                                    @if (f is null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Cambiar" class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="operadorId" value="@operador.OperadorId" />
                                            <input type="hidden" name="clave" value="@f.Clave" />
                                            <input type="hidden" name="habilitada" value="@((!f.Habilitada).ToString().ToLowerInvariant())" />
                                            <input type="hidden" name="q" value="@Model.Q" />
                                            <input type="hidden" name="funcionalidad" value="@Model.Funcionalidad" />
                                            <input type="hidden" name="estado" value="@Model.Estado" />
                                            <span class="badge @(f.Habilitada ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle")">
                                                @(f.Habilitada ? "Habilitada" : "Deshabilitada")
                                            </span>
                                            <button type="submit" class="btn btn-sm py-0 @(f.Habilitada ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(f.ModificadaEn.HasValue ? $"Último cambio: {f.ModificadaEn.Value.ToLocalTime():dd/MM/yyyy HH:mm} · {f.ModificadaPor}" : "Sin cambios (habilitada por defecto)")">
                                                @(f.Habilitada ? "Deshabilitar" : "Habilitar")
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
