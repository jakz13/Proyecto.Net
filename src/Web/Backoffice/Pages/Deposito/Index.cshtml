@page
@model UltimaMilla.Backoffice.Pages.Deposito.IndexModel
@{
    ViewData["Title"] = "Muelle de Recepción - Depósito";
}

<!-- Encabezado de la Vista -->
<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold text-dark mb-0">Muelle de Recepción en Depósito</h1>
        <div class="text-secondary small mt-1">
            Ingreso y contraste físico de bultos declarados por comercios previo al pase a estado <strong>En Depósito</strong>.
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Deposito/Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            <span>Actualizar Arribos</span>
        </a>
    </div>
</div>

<!-- Mensajes de Notificación -->
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success flex-shrink-0">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <div>@Model.MensajeExito</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div>@Model.MensajeError</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Filtro de Búsqueda Rápida y Escaneo de Arribos -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-secondary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" name="TerminoBusqueda" value="@Model.TerminoBusqueda"
                           class="form-control border-start-0 ps-0"
                           placeholder="Escanear o buscar código de seguimiento, bulto o destinatario (ej: TRK-2026-0005)..."
                           autofocus />
                </div>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100 d-inline-flex align-items-center justify-content-center gap-1">
                    <span>Buscar</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.TerminoBusqueda))
                {
                    <a asp-page="/Deposito/Index" class="btn btn-outline-secondary" title="Limpiar filtro">✕</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Envíos Admitidos Pendientes de Recepción -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
        <h2 class="h6 fw-bold mb-0 text-dark">
            Envíos Admitidos en Espera de Recepción
        </h2>
        <span class="text-secondary small font-monospace">@Model.EnviosAdmitidos.Count registros</span>
    </div>

    @if (Model.EnviosAdmitidos.Count == 0)
    {
        <div class="p-5 text-center">
            <div class="text-secondary mb-3">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted opacity-50">
                    <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
                    <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
                </svg>
            </div>
            <div class="h5 fw-bold text-dark">No hay envíos admitidos pendientes de recepción</div>
            <p class="text-secondary small mb-0">
                Todos los envíos arribados ya han sido recepcionados en depósito o no coinciden con el filtro de búsqueda aplicado.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-3">Código de Seguimiento</th>
                        <th>Destinatario & Destino</th>
                        <th>Modalidad</th>
                        <th>Bultos Declarados</th>
                        <th>Peso Total</th>
                        <th>Fecha Admisión</th>
                        <th class="text-end pe-3">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var envio in Model.EnviosAdmitidos)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold text-dark">
                                @envio.CodigoSeguimiento
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@envio.NombreDestinatario</div>
                                <div class="text-secondary small text-truncate" style="max-width: 280px;" title="@envio.DireccionDestino">
                                    @envio.DireccionDestino
                                </div>
                            </td>
                            <td>
                                <span class="@(envio.ModalidadServicio == "Express" || envio.ModalidadServicio == "Urgente" ? "text-danger fw-semibold" : "text-secondary")">
                                    @envio.ModalidadServicio
                                </span>
                            </td>
                            <td>
                                <div>
                                    <span class="text-dark fw-medium">@envio.CantidadBultos @(envio.CantidadBultos == 1 ? "bulto" : "bultos")</span>
                                    <span class="text-muted small">
                                        (@string.Join(", ", envio.Bultos.Take(2).Select(b => b.Identificacion))@(envio.Bultos.Count > 2 ? "..." : ""))
                                    </span>
                                </div>
                            </td>
                            <td class="font-monospace small">
                                @envio.PesoTotal.ToString("N1") kg
                            </td>
                            <td class="text-secondary small">
                                @envio.FechaAlta.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end pe-3">
                                <a asp-page="/Deposito/Recepcion" asp-route-id="@envio.EnvioId"
                                   class="btn btn-sm btn-dark d-inline-flex align-items-center gap-1 shadow-sm px-3">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="9 11 12 14 22 4"></polyline>
                                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                                    </svg>
                                    <span>Recepcionar Bultos</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
