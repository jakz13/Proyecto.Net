@page
@using UltimaMilla.Frontend.Contracts.Modelos.Envios
@model UltimaMilla.Backoffice.Pages.Deposito.ClasificacionModel
@{
    ViewData["Title"] = "Clasificación de Bultos - Depósito";
    ViewData["TiempoRealEnvios"] = true;
    var envio = Model.EnvioSeleccionado;
}

<!-- Encabezado de la Vista -->
<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold text-dark mb-0">Clasificación Operativa de Bultos</h1>
        <div class="text-secondary small mt-1">
            Organice los bultos recepcionados según <strong>zona de cobertura, prioridad y tipo</strong> para dejarlos listos para su inclusión en una hoja de ruta.
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Deposito/Clasificacion" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            <span>Actualizar</span>
        </a>
    </div>
</div>

<!-- Mensajes de Notificación -->
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success flex-shrink-0">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <div>@Model.MensajeExito</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div>@Model.MensajeError</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model.ErroresValidacion.Count > 0)
{
    <div class="alert alert-danger shadow-sm rounded-3 p-3 mb-4 border-danger" role="alert" id="panelErroresValidacion">
        <div class="d-flex align-items-start gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0 mt-1">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div class="flex-grow-1">
                <div class="fw-bold text-danger mb-1">No se pudo guardar la clasificación física de los bultos:</div>
                <ul class="mb-0 ps-3 small text-danger-emphasis">
                    @foreach (var error in Model.ErroresValidacion)
                    {
                        <li><strong>@error</strong></li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<div id="alertaClasificacionJs" class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4 d-none" role="alert">
    <div class="d-flex align-items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span id="textoAlertaJs" class="fw-semibold small"></span>
        <button type="button" class="btn-close ms-auto" onclick="cerrarAlertaJs()" aria-label="Cerrar"></button>
    </div>
</div>

<!-- Tarjetas de Métricas -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-secondary small fw-semibold text-uppercase">Pendientes de Clasificar</div>
            <div class="h3 fw-bold text-dark mb-0 mt-1">@Model.TotalPendientesClasificar</div>
            <div class="text-secondary small mt-2">Envíos con bultos sin zona o prioridad asignada</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-secondary small fw-semibold text-uppercase">Listos para Hoja de Ruta</div>
            <div class="h3 fw-bold text-dark mb-0 mt-1">@Model.TotalListosParaRuta</div>
            <div class="text-secondary small mt-2">Disponibles para asignación a un repartidor</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <div class="text-secondary small fw-semibold text-uppercase">Zonas de Cobertura</div>
            <div class="h3 fw-bold text-dark mb-0 mt-1">@Model.ZonasDisponibles.Count</div>
            <div class="text-secondary small mt-2">Zonas operativas activas para clasificación</div>
        </div>
    </div>
</div>

<div class="row g-4 @(envio == null ? "align-items-stretch" : "align-items-start")">
    <!-- =========================================================================
         Columna Izquierda: Listado de Envíos en Depósito para Seleccionar
         ========================================================================= -->
    <div class="col-lg-5 col-xl-4 d-flex flex-column">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden flex-grow-1 d-flex flex-column" style="min-height: 520px;">
            <div class="card-header bg-white border-bottom p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 fw-bold mb-0 text-dark">Envíos en Depósito</h2>
                    <span class="text-secondary small font-monospace">@Model.EnviosEnDeposito.Count registros</span>
                </div>

                <!-- Tabs de Filtro: Pendientes vs Todos -->
                <ul class="nav nav-pills nav-fill small gap-1 mb-2">
                    <li class="nav-item">
                        <a class="nav-link py-1 px-2 @(Model.Vista == "pendientes" ? "active" : "bg-light text-secondary")"
                           asp-page="/Deposito/Clasificacion" asp-route-vista="pendientes" asp-route-TerminoBusqueda="@Model.TerminoBusqueda">
                            Pendientes (@Model.TotalPendientesClasificar)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link py-1 px-2 @(Model.Vista == "todos" ? "active" : "bg-light text-secondary")"
                           asp-page="/Deposito/Clasificacion" asp-route-vista="todos" asp-route-TerminoBusqueda="@Model.TerminoBusqueda">
                            Todos
                        </a>
                    </li>
                </ul>

                <!-- Filtro de Búsqueda Rápida -->
                <form method="get" class="d-flex gap-1">
                    <input type="hidden" name="vista" value="@Model.Vista" />
                    <input type="text" name="TerminoBusqueda" value="@Model.TerminoBusqueda"
                           class="form-control form-control-sm"
                           placeholder="Buscar por código, bulto o destinatario..." />
                    <button type="submit" class="btn btn-sm btn-dark">Buscar</button>
                    @if (!string.IsNullOrWhiteSpace(Model.TerminoBusqueda))
                    {
                        <a asp-page="/Deposito/Clasificacion" asp-route-vista="@Model.Vista" class="btn btn-sm btn-outline-secondary">✕</a>
                    }
                </form>
            </div>

            <!-- Lista scrolleable de envíos -->
            <div class="list-group list-group-flush overflow-auto flex-grow-1" style="max-height: 580px;">
                @if (Model.EnviosEnDeposito.Count == 0)
                {
                    <div class="p-4 text-center text-muted small my-auto">
                        No hay envíos en depósito que coincidan con el filtro seleccionado.
                    </div>
                }
                else
                {
                    @foreach (var item in Model.EnviosEnDeposito)
                    {
                        var seleccionado = envio?.EnvioId == item.EnvioId;
                        <a asp-page="/Deposito/Clasificacion" asp-route-id="@item.EnvioId" asp-route-vista="@Model.Vista" asp-route-TerminoBusqueda="@Model.TerminoBusqueda"
                           class="list-group-item list-group-item-action p-3 border-bottom @(seleccionado ? "bg-primary-subtle border-start border-primary border-4" : "")">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold font-monospace @(seleccionado ? "text-primary" : "text-dark")">
                                    @item.CodigoSeguimiento
                                </span>
                                @if (item.EstaClasificado)
                                {
                                    <span class="text-success small fw-semibold" style="font-size: 0.75rem;">
                                        Listo para ruta
                                    </span>
                                }
                                else
                                {
                                    <span class="text-warning-emphasis small fw-semibold" style="font-size: 0.75rem;">
                                        @item.CantidadClasificados / @item.CantidadBultos clasif.
                                    </span>
                                }
                            </div>
                            <div class="small text-dark fw-semibold text-truncate">@item.NombreDestinatario</div>
                            <div class="small text-secondary text-truncate" style="font-size: 0.75rem;">@item.DireccionDestino</div>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-1 border-top border-light" style="font-size: 0.7rem;">
                                <span class="text-muted font-monospace">@item.CantidadBultos bulto(s) · @item.PesoTotal.ToString("N1") kg</span>
                                <span class="text-secondary">@item.ModalidadServicio</span>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <!-- =========================================================================
         Columna Derecha: Estación de Clasificación del Envío Seleccionado
         ========================================================================= -->
    <div class="col-lg-7 col-xl-8 d-flex flex-column">
        @if (envio == null)
        {
            <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white flex-grow-1 d-flex flex-column justify-content-center align-items-center" style="min-height: 520px;">
                <div class="text-secondary mb-3">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted opacity-50">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </div>
                <div class="h5 fw-bold text-dark">Seleccione un envío en depósito para clasificar sus bultos</div>
                <p class="text-secondary small mb-0" style="max-width: 480px;">
                    Elija uno de los envíos arribados de la lista de la izquierda para registrar su zona de cobertura, prioridad de entrega y tipo operativo.
                </p>
            </div>
        }
        else
        {
            <!-- Tarjeta Principal del Envío Seleccionado -->
            <div class="card border-0 shadow-sm rounded-3 bg-white flex-grow-1 d-flex flex-column" style="min-height: 520px;">
                <div class="card-header bg-white border-bottom p-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <span class="h5 fw-bold text-dark mb-0 font-monospace">@envio.CodigoSeguimiento</span>
                                <span class="text-secondary small">
                                    · En Depósito · @(envio.EstaClasificado ? "Clasificación completa" : $"{envio.CantidadBultos - envio.CantidadClasificados} bulto(s) pendiente(s)")
                                </span>
                            </div>
                            <div class="text-secondary small mt-1">
                                Destinatario: <strong>@envio.NombreDestinatario</strong> · Destino: @envio.DireccionDestino
                            </div>
                        </div>

                        <!-- Lector / Escáner rápido de etiqueta para operario de depósito -->
                        <div class="d-flex align-items-center gap-1" style="max-width: 340px; width: 100%;">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
                                        <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
                                        <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
                                        <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
                                    </svg>
                                </span>
                                <input type="text" id="inputEscanearBultoClasif" class="form-control border-start-0"
                                       placeholder="Escanear etiqueta de bulto (ej: -B01)..."
                                       autocomplete="off" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-3 d-flex flex-column flex-grow-1">
                    <!-- Barra de herramientas para clasificación masiva rápida -->
                    <div class="bg-light p-2 rounded-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <span class="small fw-semibold text-secondary">Acciones de clasificación rápida:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary" onclick="copiarZonaATodos()" title="Copia la zona del primer bulto a todos">
                                Mover todos a misma Zona
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="establecerPrioridad('Normal')">
                                Prioridad Normal
                            </button>
                            <button type="button" class="btn btn-outline-warning text-dark fw-semibold" onclick="establecerPrioridad('Alta')">
                                Prioridad Alta
                            </button>
                            <button type="button" class="btn btn-outline-danger" onclick="establecerPrioridad('Urgente')">
                                Prioridad Urgente
                            </button>
                        </div>
                    </div>

                    <!-- Formulario de Clasificación de Bultos -->
                    <form method="post" id="formClasificacion" onsubmit="return validarClasificacionAntesDeEnviar();" class="d-flex flex-column flex-grow-1">
                        <input type="hidden" asp-for="Formulario.EnvioId" />

                        <div class="table-responsive flex-grow-1">
                            <table class="table align-middle table-hover mb-0">
                                <thead class="table-light text-secondary small text-uppercase">
                                    <tr>
                                        <th class="ps-3" style="width: 22%;">Bulto</th>
                                        <th style="width: 30%;">Zona de Cobertura *</th>
                                        <th style="width: 24%;">Prioridad</th>
                                        <th style="width: 24%;">Tipo Operativo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Formulario.Bultos.Count; i++)
                                    {
                                        var bulto = Model.Formulario.Bultos[i];
                                        var sinZona = (!bulto.ZonaCoberturaId.HasValue || bulto.ZonaCoberturaId.Value == Guid.Empty);
                                        var claseErrorFila = (Model.ErroresValidacion.Count > 0 && sinZona) ? "table-danger" : "";

                                        <tr id="fila_bulto_@i" class="fila-bulto-clasif @claseErrorFila" data-codigo="@bulto.CodigoBulto">
                                            <td class="ps-3">
                                                <input type="hidden" asp-for="Formulario.Bultos[i].BultoId" />
                                                <input type="hidden" asp-for="Formulario.Bultos[i].CodigoBulto" />
                                                <input type="hidden" asp-for="Formulario.Bultos[i].Peso" />
                                                <input type="hidden" asp-for="Formulario.Bultos[i].EstadoBulto" />

                                                <div class="font-monospace fw-bold text-dark d-flex align-items-center gap-1">
                                                    <span>@bulto.CodigoBulto</span>
                                                    @if (sinZona)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle badge-sin-zona" id="badge_alerta_@i" style="font-size: 0.65rem;">
                                                            Sin Zona
                                                        </span>
                                                    }
                                                </div>
                                                <div class="text-muted small" style="font-size: 0.72rem;">
                                                    @bulto.Peso.ToString("N1") kg · @bulto.EstadoBulto
                                                </div>
                                                @{
                                                    var patronBarrasClasif = GeneradorDocumentoEtiquetas.CalcularPatronBarras(bulto.CodigoBulto);
                                                }
                                                <div class="mt-1" style="max-width: 175px;">
                                                    <svg viewBox="0 0 260 36" width="100%" height="30" role="img" aria-label="Código de barras @bulto.CodigoBulto" class="border rounded bg-white p-1">
                                                        @foreach (var barra in patronBarrasClasif)
                                                        {
                                                            <rect x="@barra.PosicionX" y="2" width="@barra.Ancho" height="32" fill="#0f172a" />
                                                        }
                                                    </svg>
                                                </div>
                                            </td>
                                            <td>
                                                <!-- Selector de Zona de Cobertura con feedback de error -->
                                                <select asp-for="Formulario.Bultos[i].ZonaCoberturaId"
                                                        class="form-select form-select-sm sel-zona @(Model.ErroresValidacion.Count > 0 && sinZona ? "is-invalid" : "")"
                                                        id="sel_zona_@i"
                                                        onchange="alCambiarZona(@i)">
                                                    <option value="">-- Sin zona asignada --</option>
                                                    @foreach (var z in Model.ZonasDisponibles)
                                                    {
                                                        <option value="@z.Id">@z.Nombre</option>
                                                    }
                                                </select>
                                                <div class="invalid-feedback small fw-semibold" id="feedback_zona_@i">
                                                    Debe seleccionar una zona de cobertura obligatoria para este bulto.
                                                </div>
                                            </td>
                                            <td>
                                                <!-- Selector de Prioridad -->
                                                <select asp-for="Formulario.Bultos[i].Prioridad" class="form-select form-select-sm sel-prioridad" id="sel_prioridad_@i">
                                                    <option value="Baja">Baja</option>
                                                    <option value="Normal">Normal</option>
                                                    <option value="Alta">Alta</option>
                                                    <option value="Urgente">Urgente</option>
                                                </select>
                                            </td>
                                            <td>
                                                <!-- Selector / Input de Tipo Operativo -->
                                                <select asp-for="Formulario.Bultos[i].Tipo" class="form-select form-select-sm sel-tipo" id="sel_tipo_@i">
                                                    <option value="Estándar">Estándar</option>
                                                    <option value="Frágil">Frágil / Vidrio</option>
                                                    <option value="Pesado">Pesado (> 10kg)</option>
                                                    <option value="Refrigerado">Refrigerado / Cadena Frío</option>
                                                    <option value="Voluminoso">Voluminoso</option>
                                                    <option value="Documentación">Documentación / Sobre</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Panel de Confirmación y Guardado -->
                        <div class="p-3 bg-light rounded-3 mt-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div class="small text-secondary">
                                Al clasificar todos los bultos recepcionados, el envío queda automáticamente disponible para la planificación de rutas.
                            </div>
                            <button type="submit" class="btn btn-dark px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2" id="btnGuardarClasificacion">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>Guardar Clasificación de Bultos</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var inputEscaner = document.getElementById('inputEscanearBultoClasif');
            if (inputEscaner) {
                inputEscaner.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        procesarEscaneoClasificacion(this.value);
                        this.value = '';
                    }
                });
            }
        });

        function procesarEscaneoClasificacion(codigo) {
            if (!codigo) return;
            var texto = codigo.trim().toUpperCase();
            if (!texto) return;

            var filas = document.querySelectorAll('.fila-bulto-clasif');
            var encontrado = false;

            filas.forEach(function (fila, idx) {
                var codigoFila = (fila.getAttribute('data-codigo') || '').trim().toUpperCase();
                // Coincidencia exacta o contiene el código (ej: si escanean TRK-2026-0001-B01 y la fila es BLT-01 o -B01)
                if (codigoFila === texto || texto.endsWith(codigoFila) || codigoFila.endsWith(texto) || texto.indexOf(codigoFila) >= 0) {
                    encontrado = true;
                    fila.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    fila.classList.add('table-info');
                    setTimeout(function () {
                        fila.classList.remove('table-info');
                    }, 2500);

                    var selectZona = document.getElementById('sel_zona_' + idx);
                    if (selectZona) {
                        selectZona.focus();
                    }
                }
            });

            if (!encontrado) {
                mostrarAlertaJs('El código escaneado "' + texto + '" no coincide con ningún bulto del envío seleccionado.');
            }
        }

        function alCambiarZona(indice) {
            var selectZona = document.getElementById('sel_zona_' + indice);
            var fila = document.getElementById('fila_bulto_' + indice);
            var badge = document.getElementById('badge_alerta_' + indice);

            if (selectZona && selectZona.value) {
                selectZona.classList.remove('is-invalid');
                if (fila) fila.classList.remove('table-danger');
                if (badge) badge.classList.add('d-none');
            } else {
                if (badge) badge.classList.remove('d-none');
            }

            var algunInvalido = document.querySelector('.sel-zona.is-invalid');
            if (!algunInvalido) {
                cerrarAlertaJs();
                var panelErrores = document.getElementById('panelErroresValidacion');
                if (panelErrores) panelErrores.style.display = 'none';
            }
        }

        function validarClasificacionAntesDeEnviar() {
            var selects = document.querySelectorAll('.sel-zona');
            var hayFaltantes = false;
            var primerSelectInvalido = null;

            selects.forEach(function (sel, idx) {
                var fila = document.getElementById('fila_bulto_' + idx);
                var badge = document.getElementById('badge_alerta_' + idx);

                if (!sel.value || sel.value.trim() === '') {
                    sel.classList.add('is-invalid');
                    if (fila) fila.classList.add('table-danger');
                    if (badge) badge.classList.remove('d-none');
                    hayFaltantes = true;
                    if (!primerSelectInvalido) primerSelectInvalido = sel;
                } else {
                    sel.classList.remove('is-invalid');
                    if (fila) fila.classList.remove('table-danger');
                    if (badge) badge.classList.add('d-none');
                }
            });

            if (hayFaltantes) {
                mostrarAlertaJs('Atención: Hay bultos sin zona de cobertura asignada. Debe seleccionar la zona para cada bulto antes de guardar.');
                if (primerSelectInvalido) {
                    primerSelectInvalido.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    primerSelectInvalido.focus();
                }
                return false;
            }

            return true;
        }

        function mostrarAlertaJs(mensaje) {
            var alerta = document.getElementById('alertaClasificacionJs');
            var texto = document.getElementById('textoAlertaJs');
            if (alerta && texto) {
                texto.textContent = mensaje;
                alerta.classList.remove('d-none');
                alerta.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        function cerrarAlertaJs() {
            var alerta = document.getElementById('alertaClasificacionJs');
            if (alerta) {
                alerta.classList.add('d-none');
            }
        }

        function copiarZonaATodos() {
            var primeraZona = document.getElementById('sel_zona_0');
            if (!primeraZona || !primeraZona.value) {
                mostrarAlertaJs('Seleccione primero una zona en el primer bulto para copiarla a los demás.');
                return;
            }

            var valorZona = primeraZona.value;
            var selects = document.querySelectorAll('.sel-zona');
            selects.forEach(function (sel, idx) {
                sel.value = valorZona;
                alCambiarZona(idx);
            });
            cerrarAlertaJs();
        }

        function establecerPrioridad(prioridad) {
            var selects = document.querySelectorAll('.sel-prioridad');
            selects.forEach(function (sel) {
                sel.value = prioridad;
            });
        }
    </script>
}
