@page "{id:guid}"
@model UltimaMilla.Backoffice.Pages.Zonas.EditarModel
@{
    ViewData["Title"] = "Editar Zona de Cobertura y Franjas";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Editar Zona de Cobertura y Franjas</h1>
        <p class="text-secondary small mb-0">
            Modifique el polígono geográfico escribiendo calles/intersecciones o haciendo clic en el mapa, y gestione las franjas horarias de entrega asignadas.
        </p>
    </div>
    <a asp-page="/Zonas/Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a Zonas</span>
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger small py-2 mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
                <strong>Error de validación:</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        </div>
    </div>
}

<form method="post" id="formularioEdicionZona">
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">
        <!-- Columna Izquierda: Datos y Polígono -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                        </svg>
                        <span>1. Delimitación Territorial</span>
                    </h2>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Zona.Nombre" class="form-label small fw-semibold">Nombre de la Zona *</label>
                        <input asp-for="Zona.Nombre" class="form-control form-control-sm" required />
                        <span asp-validation-for="Zona.Nombre" class="text-danger small"></span>
                    </div>

                    <!-- Selector de Color en Tiempo Real -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Color Identificador en Mapa</label>
                        <div class="d-flex align-items-center gap-2">
                            <input asp-for="Zona.ColorHex" type="color" class="form-control form-control-color form-control-sm" id="selectorColor" style="width: 48px;" oninput="sincronizarColor(this.value)" />
                            <select class="form-select form-select-sm" id="comboColor" onchange="sincronizarColor(this.value)">
                                <option value="#2563eb" selected="@(Model.Zona.ColorHex == "#2563eb")">Azul Clásico (#2563eb)</option>
                                <option value="#10b981" selected="@(Model.Zona.ColorHex == "#10b981")">Verde Esmeralda (#10b981)</option>
                                <option value="#f59e0b" selected="@(Model.Zona.ColorHex == "#f59e0b")">Ámbar Dorado (#f59e0b)</option>
                                <option value="#8b5cf6" selected="@(Model.Zona.ColorHex == "#8b5cf6")">Púrpura Logístico (#8b5cf6)</option>
                                <option value="#ef4444" selected="@(Model.Zona.ColorHex == "#ef4444")">Rojo Coral (#ef4444)</option>
                                <option value="#06b6d4" selected="@(Model.Zona.ColorHex == "#06b6d4")">Cian Moderno (#06b6d4)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Asistente de Delimitación por Calles / Esquinas -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-semibold text-dark mb-0 d-flex align-items-center gap-1">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                <span>Agregar Calle o Intersección</span>
                            </label>
                            <span class="text-muted" style="font-size: 0.7rem;">Montevideo / Canelones</span>
                        </div>
                        <p class="text-secondary small mb-2" style="font-size: 0.725rem;">
                            Escriba esquinas de referencia (ej: <em>18 de Julio y Ejido</em>, <em>Rivera y Soca</em>) para ajustar el polígono:
                        </p>
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" id="inputEsquina" class="form-control" placeholder="Ej: 18 de Julio y Ejido, Rivera y Bvar. Artigas..." list="sugerenciasEsquinas" onkeydown="if(event.key==='Enter'){event.preventDefault(); agregarEsquinaManual();}" />
                            <datalist id="sugerenciasEsquinas">
                                <option value="18 de Julio y Ejido">Centro</option>
                                <option value="18 de Julio y Río Negro">Centro</option>
                                <option value="18 de Julio y Bvar. Artigas">Tres Cruces</option>
                                <option value="Rivera y Bvar. Artigas">Pocitos</option>
                                <option value="Rivera y Soca">Pocitos</option>
                                <option value="Av. Brasil y Benito Blanco">Pocitos</option>
                                <option value="21 de Setiembre y Ellauri">Punta Carretas</option>
                                <option value="Agraciada y Joaquín Suárez">Bella Vista / Prado</option>
                                <option value="8 de Octubre y Garibaldi">La Blanqueada</option>
                                <option value="8 de Octubre y Comercio">Unión</option>
                                <option value="Av. Italia y Propios">Malvín Norte</option>
                                <option value="Av. Italia y Bolivia">Carrasco</option>
                                <option value="Rambla y Kibón">Pocitos</option>
                                <option value="Giannattasio y Calcagno">Ciudad de la Costa</option>
                            </datalist>
                            <button type="button" class="btn btn-dark" id="btnAgregarEsquina" onclick="agregarEsquinaManual()">
                                + Agregar Esquina
                            </button>
                        </div>

                        <!-- Lista visual de esquinas añadidas -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-secondary fw-semibold" style="font-size: 0.725rem;">Esquinas añadidas al perímetro (haga clic en una para quitarla):</span>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.7rem;" onclick="deshacerEsquina()">Deshacer</button>
                                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.7rem;" onclick="limpiarEsquinas()">Limpiar</button>
                            </div>
                        </div>
                        <div id="listaEsquinasVisual" class="d-flex flex-wrap gap-1 p-2 bg-white rounded border" style="min-height: 48px; max-height: 120px; overflow-y: auto;">
                            <span class="text-muted small fst-italic" style="font-size: 0.75rem;" id="textoSinEsquinas">Cargando esquinas del polígono...</span>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="Zona.Activa" id="zonaActiva" />
                        <label class="form-check-label small fw-semibold" for="zonaActiva">Zona habilitada para despacho y tarifas</label>
                    </div>

                    <!-- Coordenadas Técnicas (Desplegable Avanzado) -->
                    <details class="small">
                        <summary class="text-secondary fw-semibold cursor-pointer">Ver coordenadas GeoJSON (Avanzado)</summary>
                        <div class="mt-2">
                            <textarea asp-for="Zona.PoligonoGeografico" class="form-control form-control-sm font-monospace" rows="3"
                                      id="campoPoligono" required></textarea>
                            <span asp-validation-for="Zona.PoligonoGeografico" class="text-danger small"></span>
                        </div>
                    </details>
                </div>
            </div>

            <!-- Previsualizador y Editor Interactivo con Leaflet -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="small fw-semibold text-secondary d-flex align-items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                        </svg>
                        <span>Delimitación en Mapa en Vivo (Leaflet)</span>
                    </span>
                    
                </div>
                <div class="card-body p-2 bg-white">
                    <div id="mapaZonaLeaflet" class="border rounded-2" style="height: 260px; width: 100%;"></div>
                    <div class="text-muted small mt-2 d-flex justify-content-between align-items-center px-1" style="font-size: 0.725rem;">
                        <span>Haga clic en el mapa para trazar o ajustar esquinas.</span>
                        <span class="text-success fw-semibold">● Tiempo real</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Franjas Horarias -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>2. Franjas Horarias de Entrega</span>
                        </h2>
                        <span class="text-secondary small" style="font-size: 0.75rem;">
                            Ventanas horarias disponibles para los envíos de esta zona.
                        </span>
                    </div>
                    <button type="button" class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" onclick="agregarFilaFranja()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>Agregar Franja</span>
                    </button>
                </div>

                <div class="card-body p-3">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0" id="tablaFranjas">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 25%;">Día de la Semana *</th>
                                    <th style="width: 23%;">Hora Inicio *</th>
                                    <th style="width: 23%;">Hora Fin *</th>
                                    <th style="width: 20%;">Capacidad Máx. *</th>
                                    <th style="width: 9%;" class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="cuerpoTablaFranjas">
                                @for (int i = 0; i < Model.Franjas.Count; i++)
                                {
                                    <tr class="fila-franja">
                                        <td>
                                            <select name="Franjas[@i].DiaSemana" class="form-select form-select-sm" required>
                                                <option value="Monday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Monday)">Lunes</option>
                                                <option value="Tuesday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Tuesday)">Martes</option>
                                                <option value="Wednesday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Wednesday)">Miércoles</option>
                                                <option value="Thursday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Thursday)">Jueves</option>
                                                <option value="Friday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Friday)">Viernes</option>
                                                <option value="Saturday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Saturday)">Sábado</option>
                                                <option value="Sunday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Sunday)">Domingo</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="time" name="Franjas[@i].HoraInicio" value="@Model.Franjas[i].HoraInicio.ToString(@"hh\:mm")"
                                                   class="form-control form-control-sm" required />
                                        </td>
                                        <td>
                                            <input type="time" name="Franjas[@i].HoraFin" value="@Model.Franjas[i].HoraFin.ToString(@"hh\:mm")"
                                                   class="form-control form-control-sm" required />
                                        </td>
                                        <td>
                                            <input type="number" name="Franjas[@i].CapacidadMaximaEnvios" value="@Model.Franjas[i].CapacidadMaximaEnvios"
                                                   class="form-control form-control-sm" min="1" max="500" required />
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" title="Eliminar fila" onclick="eliminarFila(this)">
                                                &times;
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="card-footer bg-white p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-warning btn-sm" onclick="simularSuperposicionDemo()" title="Genera dos franjas solapadas el mismo día para evaluar validación">
                        Simular Superposición Inconsistente (Demo)
                    </button>

                    <div class="d-flex gap-2">
                        <a asp-page="/Zonas/Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                        <button type="submit" class="btn btn-dark btn-sm px-4 d-inline-flex align-items-center gap-1 shadow-sm">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Guardar Cambios</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var editorMapaZona = null;

        function sincronizarColor(color) {
            document.getElementById('selectorColor').value = color;
            document.getElementById('comboColor').value = color;
            if (editorMapaZona && typeof editorMapaZona.cambiarColor === 'function') {
                editorMapaZona.cambiarColor(color);
            }
        }

        async function agregarEsquinaManual() {
            var input = document.getElementById('inputEsquina');
            var btn = document.getElementById('btnAgregarEsquina');
            var valor = input.value.trim();
            if (!valor) return;

            var textoOriginalBtn = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Buscando...';
            }

            try {
                if (editorMapaZona && typeof editorMapaZona.agregarPorDireccion === 'function') {
                    var resultado = await editorMapaZona.agregarPorDireccion(valor);
                    if (resultado) {
                        input.value = '';
                    } else {
                        alert('No se pudo encontrar la ubicación "' + valor + '". Verifique el nombre o esquina (ej: "18 de Julio y Ejido", "Av. Italia y Propios") o haga clic directamente en el mapa para marcar el punto.');
                    }
                }
            } catch (err) {
                alert('Ocurrió un error al consultar el servicio de mapas. Puede marcar el punto haciendo clic en el mapa.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = textoOriginalBtn;
                }
            }
        }

        function deshacerEsquina() {
            if (editorMapaZona && typeof editorMapaZona.eliminarUltimoVertice === 'function') {
                editorMapaZona.eliminarUltimoVertice();
            }
        }

        function limpiarEsquinas() {
            if (editorMapaZona && typeof editorMapaZona.limpiarVertices === 'function') {
                editorMapaZona.limpiarVertices();
            }
        }

        function actualizarListaEsquinasVisual(vertices, descripciones) {
            var contenedor = document.getElementById('listaEsquinasVisual');
            if (!contenedor) return;

            if (!descripciones || descripciones.length === 0) {
                contenedor.innerHTML = '<span class="text-muted small fst-italic" style="font-size: 0.75rem;" id="textoSinEsquinas">No hay esquinas añadidas. Escriba arriba o haga clic en el mapa.</span>';
                return;
            }

            var html = '';
            descripciones.forEach(function (item, idx) {
                html += '<button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 py-1 px-2 border rounded-pill shadow-xs esquina-item" style="font-size: 0.725rem; background: #fff;" onclick="eliminarEsquinaEspecifica(' + idx + ')" title="Haga clic para quitar esta esquina">' +
                    '<strong class="text-primary">' + item.indice + '.</strong> ' +
                    '<span>' + item.descripcion + '</span>' +
                    '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-danger ms-1" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>' +
                    '</button>';
            });
            contenedor.innerHTML = html;
        }

        function eliminarEsquinaEspecifica(indice) {
            if (editorMapaZona && typeof editorMapaZona.eliminarVerticeEn === 'function') {
                editorMapaZona.eliminarVerticeEn(indice);
            }
        }

        function agregarFilaFranja() {
            var tbody = document.getElementById('cuerpoTablaFranjas');
            var indice = tbody.querySelectorAll('tr.fila-franja').length;

            var fila = document.createElement('tr');
            fila.className = 'fila-franja';
            fila.innerHTML = `
                <td>
                    <select name="Franjas[${indice}].DiaSemana" class="form-select form-select-sm" required>
                        <option value="Monday">Lunes</option>
                        <option value="Tuesday">Martes</option>
                        <option value="Wednesday">Miércoles</option>
                        <option value="Thursday">Jueves</option>
                        <option value="Friday">Viernes</option>
                        <option value="Saturday">Sábado</option>
                        <option value="Sunday">Domingo</option>
                    </select>
                </td>
                <td>
                    <input type="time" name="Franjas[${indice}].HoraInicio" value="10:00" class="form-control form-control-sm" required />
                </td>
                <td>
                    <input type="time" name="Franjas[${indice}].HoraFin" value="14:00" class="form-control form-control-sm" required />
                </td>
                <td>
                    <input type="number" name="Franjas[${indice}].CapacidadMaximaEnvios" value="30" class="form-control form-control-sm" min="1" max="500" required />
                </td>
                <td class="text-end">
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" title="Eliminar fila" onclick="eliminarFila(this)">
                        &times;
                    </button>
                </td>
            `;
            tbody.appendChild(fila);
            renumerarFilas();
        }

        function eliminarFila(btn) {
            var fila = btn.closest('tr');
            var tbody = document.getElementById('cuerpoTablaFranjas');
            if (tbody.querySelectorAll('tr.fila-franja').length <= 1) {
                alert('Debe conservar al menos una franja horaria para la zona.');
                return;
            }
            fila.remove();
            renumerarFilas();
        }

        function renumerarFilas() {
            var filas = document.querySelectorAll('#cuerpoTablaFranjas tr.fila-franja');
            filas.forEach(function (fila, idx) {
                fila.querySelectorAll('select, input').forEach(function (campo) {
                    var nombre = campo.getAttribute('name');
                    if (nombre) {
                        campo.setAttribute('name', nombre.replace(/Franjas\[\d+\]/, 'Franjas[' + idx + ']'));
                    }
                });
            });
        }

        function simularSuperposicionDemo() {
            var tbody = document.getElementById('cuerpoTablaFranjas');
            tbody.innerHTML = '';
            tbody.innerHTML = `
                <tr class="fila-franja table-warning">
                    <td>
                        <select name="Franjas[0].DiaSemana" class="form-select form-select-sm" required>
                            <option value="Tuesday" selected>Martes (Franja A)</option>
                        </select>
                    </td>
                    <td><input type="time" name="Franjas[0].HoraInicio" value="10:00" class="form-control form-control-sm" required /></td>
                    <td><input type="time" name="Franjas[0].HoraFin" value="15:00" class="form-control form-control-sm" required /></td>
                    <td><input type="number" name="Franjas[0].CapacidadMaximaEnvios" value="30" class="form-control form-control-sm" required /></td>
                    <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" onclick="eliminarFila(this)">&times;</button></td>
                </tr>
                <tr class="fila-franja table-warning">
                    <td>
                        <select name="Franjas[1].DiaSemana" class="form-select form-select-sm" required>
                            <option value="Tuesday" selected>Martes (Franja B - Conflicto)</option>
                        </select>
                    </td>
                    <td><input type="time" name="Franjas[1].HoraInicio" value="14:00" class="form-control form-control-sm" required /></td>
                    <td><input type="time" name="Franjas[1].HoraFin" value="19:00" class="form-control form-control-sm" required /></td>
                    <td><input type="number" name="Franjas[1].CapacidadMaximaEnvios" value="35" class="form-control form-control-sm" required /></td>
                    <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" onclick="eliminarFila(this)">&times;</button></td>
                </tr>
            `;
            alert('Se cargaron dos franjas solapadas para el Martes (10:00 - 15:00 y 14:00 - 19:00). Presione "Guardar Cambios" para verificar la validación de superposiciones inconsistentes.');
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (window.MapasUltimaMilla && typeof window.MapasUltimaMilla.renderizarEditorPoligonoZona === 'function') {
                editorMapaZona = window.MapasUltimaMilla.renderizarEditorPoligonoZona(
                    'mapaZonaLeaflet',
                    'campoPoligono',
                    'selectorColor',
                    'contadorVertices',
                    {
                        onVerticesCambiados: actualizarListaEsquinasVisual
                    }
                );
            }
        });
    </script>
}
