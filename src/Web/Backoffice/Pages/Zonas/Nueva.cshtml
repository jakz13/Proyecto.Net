@page
@model UltimaMilla.Backoffice.Pages.Zonas.NuevaModel
@{
    ViewData["Title"] = "Nueva Zona de Cobertura";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Definir Zona de Cobertura y Franjas</h1>
        <p class="text-secondary small mb-0">
            Configure el polígono geográfico y asocie las ventanas horarias de reparto habilitadas para este operador.
        </p>
    </div>
    <a asp-page="/Zonas/Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a Zonas</span>
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger small py-2 mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
                <strong>Error de validación:</strong>
                <span>@Model.ErrorMessage</span>
            </div>
        </div>
    </div>
}

<form method="post" id="formularioZona">
    <div class="row g-4">
        <!-- Columna Izquierda: Datos de la Zona y Polígono Geográfico -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                        </svg>
                        <span>1. Información de la Zona</span>
                    </h2>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="NuevaZona.Nombre" class="form-label small fw-semibold">Nombre de la Zona *</label>
                        <input asp-for="NuevaZona.Nombre" class="form-control form-control-sm" placeholder="Ej: Montevideo Centro y Cordón" required />
                        <span asp-validation-for="NuevaZona.Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NuevaZona.ColorHex" class="form-label small fw-semibold">Color Identificador en Mapa</label>
                        <div class="d-flex align-items-center gap-2">
                            <input asp-for="NuevaZona.ColorHex" type="color" class="form-control form-control-color form-control-sm" id="selectorColor" style="width: 48px;" />
                            <select class="form-select form-select-sm" onchange="document.getElementById('selectorColor').value = this.value; document.getElementById('NuevaZona_ColorHex').value = this.value; actualizarMapa();">
                                <option value="#2563eb" selected>Azul Clásico (#2563eb)</option>
                                <option value="#10b981">Verde Esmeralda (#10b981)</option>
                                <option value="#f59e0b">Ámbar Dorado (#f59e0b)</option>
                                <option value="#8b5cf6">Púrpura Logístico (#8b5cf6)</option>
                                <option value="#ef4444">Rojo Coral (#ef4444)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="NuevaZona.PoligonoGeografico" class="form-label small fw-semibold mb-0">Polígono Geográfico (Coordenadas) *</label>
                            <span class="text-secondary" style="font-size: 0.7rem;">GeoJSON / Lat, Lng</span>
                        </div>
                        <textarea asp-for="NuevaZona.PoligonoGeografico" class="form-control form-control-sm font-monospace" rows="4"
                                  id="campoPoligono" oninput="actualizarMapa()" required></textarea>
                        <span asp-validation-for="NuevaZona.PoligonoGeografico" class="text-danger small"></span>
                        <div class="form-text small" style="font-size: 0.725rem;">
                            Defina los vértices del polígono en formato de pares [latitud, longitud].
                        </div>
                    </div>

                    <!-- Plantillas Rápidas para Demostración -->
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="small fw-semibold text-secondary mb-2">Cargar Plantilla Geográfica Rápida:</div>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.725rem;"
                                    onclick="cargarPlantilla('Centro & Pocitos', '[[-34.9080, -56.2120], [-34.9030, -56.1780], [-34.9180, -56.1480], [-34.9310, -56.1600], [-34.9190, -56.2080], [-34.9080, -56.2120]]', '#2563eb')">
                                Centro & Pocitos
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.725rem;"
                                    onclick="cargarPlantilla('Montevideo Prado & Norte', '[[-34.8550, -56.2150], [-34.8450, -56.1850], [-34.8750, -56.1750], [-34.8850, -56.2050], [-34.8550, -56.2150]]', '#10b981')">
                                Prado & Norte
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.725rem;"
                                    onclick="cargarPlantilla('Ciudad de la Costa', '[[-34.8800, -56.0500], [-34.8500, -55.9700], [-34.8850, -55.9500], [-34.9050, -56.0350], [-34.8800, -56.0500]]', '#f59e0b')">
                                Costa de Oro
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Previsualizador Gráfico del Polígono Geográfico -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="small fw-semibold text-secondary">Vista Previa del Polígono</span>
                    <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.7rem;">Vectorial 2D</span>
                </div>
                <div class="card-body p-3 text-center bg-white">
                    <svg id="svgMapa" width="100%" height="180" viewBox="0 0 300 180" class="border rounded-2 bg-light">
                        <polygon id="svgPoligono" points="40,40 180,30 260,110 200,160 50,140"
                                 fill="#2563eb" fill-opacity="0.25" stroke="#2563eb" stroke-width="2.5" />
                    </svg>
                    <div class="text-muted small mt-2" style="font-size: 0.725rem;">
                        Coordenadas normalizadas para validación visual de cobertura.
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Franjas Horarias y Validación de Superposiciones -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                            <span>2. Franjas Horarias de Entrega</span>
                        </h2>
                        <span class="text-secondary small" style="font-size: 0.75rem;">
                            Asocie una o más ventanas horarias. El sistema validará que no haya superposiciones inconsistentes.
                        </span>
                    </div>
                    <button type="button" class="btn btn-outline-dark btn-sm d-inline-flex align-items-center gap-1" onclick="agregarFilaFranja()">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span>Agregar Franja</span>
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-compacta mb-0 align-middle" id="tablaFranjas">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 25%;">Día de la Semana *</th>
                                    <th style="width: 23%;">Hora Inicio *</th>
                                    <th style="width: 23%;">Hora Fin *</th>
                                    <th style="width: 20%;">Capacidad (Envíos)</th>
                                    <th style="width: 9%;" class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody id="cuerpoTablaFranjas">
                                @for (int i = 0; i < Model.Franjas.Count; i++)
                                {
                                    <tr class="fila-franja">
                                        <td>
                                            <select name="Franjas[@i].DiaSemana" class="form-select form-select-sm" required>
                                                <option value="Monday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Monday)">Lunes</option>
                                                <option value="Tuesday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Tuesday)">Martes</option>
                                                <option value="Wednesday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Wednesday)">Miércoles</option>
                                                <option value="Thursday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Thursday)">Jueves</option>
                                                <option value="Friday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Friday)">Viernes</option>
                                                <option value="Saturday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Saturday)">Sábado</option>
                                                <option value="Sunday" selected="@(Model.Franjas[i].DiaSemana == DayOfWeek.Sunday)">Domingo</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="time" name="Franjas[@i].HoraInicio" value="@Model.Franjas[i].HoraInicio.ToString("HH:mm")"
                                                   class="form-control form-control-sm" required />
                                        </td>
                                        <td>
                                            <input type="time" name="Franjas[@i].HoraFin" value="@Model.Franjas[i].HoraFin.ToString("HH:mm")"
                                                   class="form-control form-control-sm" required />
                                        </td>
                                        <td>
                                            <input type="number" name="Franjas[@i].CapacidadMaximaEnvios" value="@Model.Franjas[i].CapacidadMaximaEnvios"
                                                   class="form-control form-control-sm" min="1" max="500" required />
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" title="Eliminar fila" onclick="eliminarFila(this)">
                                                &times;
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Botones de Acción y Prueba de Validación 400 -->
                <div class="card-footer bg-white p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <!-- Botón de prueba para simular superposición inconsistente durante la defensa oral -->
                    <button type="button" class="btn btn-outline-warning btn-sm" onclick="simularSuperposicionDemo()" title="Genera dos franjas solapadas el mismo día para evaluar validación">
                        Simular Superposición Inconsistente (Demo)
                    </button>

                    <div class="d-flex gap-2">
                        <a asp-page="/Zonas/Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                        <button type="submit" class="btn btn-dark btn-sm px-4 d-inline-flex align-items-center gap-1 shadow-sm">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Guardar Configuración</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function cargarPlantilla(nombre, poligono, color) {
            document.getElementById('NuevaZona_Nombre').value = nombre;
            document.getElementById('campoPoligono').value = poligono;
            document.getElementById('selectorColor').value = color;
            document.getElementById('NuevaZona_ColorHex').value = color;
            actualizarMapa();
        }

        function actualizarMapa() {
            var color = document.getElementById('selectorColor').value || '#2563eb';
            var poligono = document.getElementById('svgPoligono');
            if (poligono) {
                poligono.setAttribute('fill', color);
                poligono.setAttribute('stroke', color);
            }
        }

        function agregarFilaFranja() {
            var tbody = document.getElementById('cuerpoTablaFranjas');
            var indice = tbody.querySelectorAll('tr.fila-franja').length;

            var fila = document.createElement('tr');
            fila.className = 'fila-franja';
            fila.innerHTML = `
                <td>
                    <select name="Franjas[${indice}].DiaSemana" class="form-select form-select-sm" required>
                        <option value="Monday">Lunes</option>
                        <option value="Tuesday">Martes</option>
                        <option value="Wednesday">Miércoles</option>
                        <option value="Thursday">Jueves</option>
                        <option value="Friday">Viernes</option>
                        <option value="Saturday">Sábado</option>
                        <option value="Sunday">Domingo</option>
                    </select>
                </td>
                <td>
                    <input type="time" name="Franjas[${indice}].HoraInicio" value="09:00" class="form-control form-control-sm" required />
                </td>
                <td>
                    <input type="time" name="Franjas[${indice}].HoraFin" value="13:00" class="form-control form-control-sm" required />
                </td>
                <td>
                    <input type="number" name="Franjas[${indice}].CapacidadMaximaEnvios" value="30" class="form-control form-control-sm" min="1" max="500" required />
                </td>
                <td class="text-end">
                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" title="Eliminar fila" onclick="eliminarFila(this)">
                        &times;
                    </button>
                </td>
            `;
            tbody.appendChild(fila);
            renumerarFilas();
        }

        function eliminarFila(btn) {
            var fila = btn.closest('tr');
            var tbody = document.getElementById('cuerpoTablaFranjas');
            if (tbody.querySelectorAll('tr.fila-franja').length <= 1) {
                alert('Debe conservar al menos una franja horaria para la zona.');
                return;
            }
            fila.remove();
            renumerarFilas();
        }

        function renumerarFilas() {
            var filas = document.querySelectorAll('#cuerpoTablaFranjas tr.fila-franja');
            filas.forEach(function (fila, idx) {
                fila.querySelectorAll('select, input').forEach(function (campo) {
                    var nombre = campo.getAttribute('name');
                    if (nombre) {
                        campo.setAttribute('name', nombre.replace(/Franjas\[\d+\]/, 'Franjas[' + idx + ']'));
                    }
                });
            });
        }

        function simularSuperposicionDemo() {
            var tbody = document.getElementById('cuerpoTablaFranjas');
            tbody.innerHTML = '';
            // Insertar deliberadamente dos franjas solapadas el mismo día (Lunes 09:00 - 14:00 y Lunes 13:00 - 18:00)
            tbody.innerHTML = `
                <tr class="fila-franja table-warning">
                    <td>
                        <select name="Franjas[0].DiaSemana" class="form-select form-select-sm" required>
                            <option value="Monday" selected>Lunes (Franja A)</option>
                        </select>
                    </td>
                    <td><input type="time" name="Franjas[0].HoraInicio" value="09:00" class="form-control form-control-sm" required /></td>
                    <td><input type="time" name="Franjas[0].HoraFin" value="14:00" class="form-control form-control-sm" required /></td>
                    <td><input type="number" name="Franjas[0].CapacidadMaximaEnvios" value="35" class="form-control form-control-sm" required /></td>
                    <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" onclick="eliminarFila(this)">&times;</button></td>
                </tr>
                <tr class="fila-franja table-warning">
                    <td>
                        <select name="Franjas[1].DiaSemana" class="form-select form-select-sm" required>
                            <option value="Monday" selected>Lunes (Franja B - Conflicto)</option>
                        </select>
                    </td>
                    <td><input type="time" name="Franjas[1].HoraInicio" value="13:00" class="form-control form-control-sm" required /></td>
                    <td><input type="time" name="Franjas[1].HoraFin" value="18:00" class="form-control form-control-sm" required /></td>
                    <td><input type="number" name="Franjas[1].CapacidadMaximaEnvios" value="40" class="form-control form-control-sm" required /></td>
                    <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" onclick="eliminarFila(this)">&times;</button></td>
                </tr>
            `;
            alert('Se cargaron dos franjas horarias con superposición para el Lunes (09:00 - 14:00 y 13:00 - 18:00). Presione "Guardar Configuración" para comprobar cómo el sistema rechaza la superposición inconsistente.');
        }

        document.addEventListener('DOMContentLoaded', function () {
            actualizarMapa();
        });
    </script>
}
