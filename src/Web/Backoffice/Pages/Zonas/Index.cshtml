@page
@model UltimaMilla.Backoffice.Pages.Zonas.IndexModel
@{
    ViewData["Title"] = "Zonas de Cobertura y Franjas Horarias";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h4 fw-bold mb-0">Zonas de Cobertura y Franjas Horarias</h1>
        <partial name="_BotonAyuda" model='"Polígonos geográficos de entrega y ventanas horarias disponibles para planificación y ruteo."' />
    </div>
    <a asp-page="/Zonas/Nueva" class="btn btn-dark btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Definir Nueva Zona</span>
    </a>
</div>

<!-- Tarjetas de Métricas de Cobertura -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-4">
        <div class="metrica-card">
            <div class="metrica-card__header">
                <span class="metrica-card__label">Zonas Activas</span>
                <partial name="_BotonAyuda" model='"Zonas con polígono operativo delimitado y disponibles para despacho."' />
            </div>
            <div class="metrica-card__valor text-success">
                @Model.TotalZonasActivas
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="metrica-card">
            <div class="metrica-card__header">
                <span class="metrica-card__label">Zonas Inactivas (Bajas)</span>
                <partial name="_BotonAyuda" model='"Zonas dadas de baja temporalmente o fuera de servicio."' />
            </div>
            <div class="metrica-card__valor text-secondary">
                @Model.TotalZonasInactivas
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="metrica-card">
            <div class="metrica-card__header">
                <span class="metrica-card__label">Franjas de Entrega</span>
                <partial name="_BotonAyuda" model='"Ventanas horarias configuradas validadas sin superposiciones."' />
            </div>
            <div class="metrica-card__valor text-primary">
                @Model.TotalFranjasConfiguradas
            </div>
        </div>
    </div>
</div>

<!-- Alertas y Mensajes de Retroalimentación -->
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show py-2 small mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>@Model.MensajeExito</span>
        </div>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show py-2 small mb-3 border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@Model.MensajeError</span>
        </div>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Barra de Pestañas y Paneles de Cobertura -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <ul class="nav nav-pills gap-1" role="tablist">
        <li class="nav-item">
            <a asp-page="/Zonas/Index" asp-route-Estado="activas" asp-route-Busqueda="@Model.Busqueda"
               class="nav-link py-1 px-3 d-flex align-items-center gap-2 @(Model.Estado == "activas" || string.IsNullOrEmpty(Model.Estado) ? "active bg-dark text-white" : "bg-white text-dark border")"
               style="font-size: 0.85rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Zonas Activas</span>
                <span class="badge @(Model.Estado == "activas" || string.IsNullOrEmpty(Model.Estado) ? "bg-white text-dark" : "bg-success text-white") rounded-pill">
                    @Model.TotalZonasActivas
                </span>
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Zonas/Index" asp-route-Estado="inactivas" asp-route-Busqueda="@Model.Busqueda"
               class="nav-link py-1 px-3 d-flex align-items-center gap-2 @(Model.Estado == "inactivas" ? "active bg-secondary text-white" : "bg-white text-dark border")"
               style="font-size: 0.85rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
                <span>Panel de Zonas Inactivas (Bajas)</span>
                <span class="badge @(Model.Estado == "inactivas" ? "bg-white text-dark" : "bg-secondary text-white") rounded-pill">
                    @Model.TotalZonasInactivas
                </span>
            </a>
        </li>
        <li class="nav-item">
            <a asp-page="/Zonas/Index" asp-route-Estado="todos" asp-route-Busqueda="@Model.Busqueda"
               class="nav-link py-1 px-3 d-flex align-items-center gap-2 @(Model.Estado == "todos" ? "active bg-dark text-white" : "bg-white text-dark border")"
               style="font-size: 0.85rem;">
                <span>Todas</span>
                <span class="badge @(Model.Estado == "todos" ? "bg-white text-dark" : "bg-light text-dark border") rounded-pill">
                    @(Model.TotalZonasActivas + Model.TotalZonasInactivas)
                </span>
            </a>
        </li>
    </ul>

    <!-- Buscador Integrado -->
    <form method="get" class="d-flex align-items-center gap-2">
        <input type="hidden" name="Estado" value="@Model.Estado" />
        <div class="input-group input-group-sm" style="min-width: 260px;">
            <span class="input-group-text bg-white border-end-0">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </span>
            <input type="text" name="Busqueda" value="@Model.Busqueda"
                   class="form-control border-start-0" placeholder="Buscar zona..." />
            @if (!string.IsNullOrEmpty(Model.Busqueda))
            {
                <a asp-page="/Zonas/Index" asp-route-Estado="@Model.Estado" class="btn btn-outline-secondary btn-sm" title="Limpiar búsqueda">✕</a>
            }
            <button type="submit" class="btn btn-dark btn-sm">Buscar</button>
        </div>
    </form>
</div>

<!-- Panel de Zonas Inactivas (Aviso Explicativo cuando está activo el panel) -->
@if (Model.Estado == "inactivas")
{
    <div class="card border-0 bg-warning-subtle text-dark border-start border-4 border-warning shadow-sm rounded-3 p-3 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning-emphasis flex-shrink-0" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div>
                    <strong class="d-block text-warning-emphasis">Panel Activo: Zonas Dadas de Baja (Inactivas)</strong>
                    <span class="small text-muted">Las zonas listadas a continuación están inactivadas y no participan del cálculo tarifario ni de la planificación de rutas. Puede reactivarlas presionando el botón "Reactivar".</span>
                </div>
            </div>
            <a asp-page="/Zonas/Index" asp-route-Estado="activas" class="btn btn-outline-dark btn-sm">
                ← Volver a Zonas Activas
            </a>
        </div>
    </div>
}

<!-- Visualizador Global de Cobertura con Leaflet -->
@if (Model.Zonas.Count > 0)
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                </svg>
                <span>Mapa de Cobertura Territorial de Zonas</span>
            </h2>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.725rem;">
                @Model.Zonas.Count zonas en este panel
            </span>
        </div>
        <div class="card-body p-2 bg-white">
            <div id="mapaZonasGeneralLeaflet" class="border rounded-2" style="height: 320px; width: 100%;"></div>
        </div>
    </div>
}

<!-- Listado de Zonas y Franjas Horarias -->
<div class="row g-3">
    @if (Model.Zonas.Count == 0)
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
                @if (Model.Estado == "inactivas")
                {
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2 text-success" aria-hidden="true">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <h3 class="h6 fw-bold text-dark mb-1">No hay zonas inactivas</h3>
                    <p class="mb-3 small">Todas las zonas de cobertura se encuentran actualmente activas y operativas.</p>
                    <div>
                        <a asp-page="/Zonas/Index" asp-route-Estado="activas" class="btn btn-outline-dark btn-sm">Ver Zonas Activas</a>
                    </div>
                }
                else
                {
                    <p class="mb-2">No se encontraron zonas de cobertura que coincidan con los criterios de búsqueda.</p>
                    <div>
                        <a asp-page="/Zonas/Nueva" class="btn btn-outline-dark btn-sm">Definir una nueva zona</a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @foreach (var zona in Model.Zonas)
        {
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100 @(!zona.Activa ? "bg-light-subtle opacity-90" : "")" style="border-left: 5px solid @zona.ColorHex !important;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-circle" style="width: 12px; height: 12px; background-color: @zona.ColorHex;"></span>
                                    <h2 class="h5 fw-bold mb-0 text-dark">@zona.Nombre</h2>
                                </div>
                                <span class="text-secondary small font-monospace">Polígono: @(zona.PoligonoGeografico.Length > 45 ? zona.PoligonoGeografico.Substring(0, 45) + "..." : zona.PoligonoGeografico)</span>
                            </div>
                            <div>
                                @if (zona.Activa)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white px-2 py-1">
                                        Inactiva (Baja)
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Sección de Franjas Horarias de la Zona -->
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-semibold text-dark d-flex align-items-center gap-1">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span>Franjas Horarias Disponibles (@zona.TotalFranjas)</span>
                                </span>
                            </div>

                            @if (zona.FranjasHorarias.Count == 0)
                            {
                                <div class="small text-muted fst-italic">
                                    No hay franjas horarias configuradas para esta zona.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var franja in zona.FranjasHorarias.OrderBy(f => f.DiaSemana).ThenBy(f => f.HoraInicio))
                                    {
                                        <div class="badge bg-light text-dark border p-2 text-start d-flex flex-column gap-1" style="min-width: 140px;">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong class="text-primary small">@franja.NombreDia</strong>
                                                <span class="text-secondary" style="font-size: 0.7rem;">Cap: @franja.CapacidadMaximaEnvios</span>
                                            </div>
                                            <div class="font-monospace small">
                                                @franja.HorarioTexto
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Acciones sobre la Zona -->
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <span class="text-secondary" style="font-size: 0.75rem;">
                                Creada: @zona.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")
                            </span>
                            <div class="d-flex gap-2">
                                <a asp-page="/Zonas/Editar" asp-route-id="@zona.Id" class="btn btn-outline-secondary btn-sm py-1 px-3" style="font-size: 0.8rem;">
                                    Editar y Franjas
                                </a>

                                <form method="post" asp-page-handler="CambiarEstado" class="d-inline">
                                    <input type="hidden" name="id" value="@zona.Id" />
                                    <input type="hidden" name="nuevoEstado" value="@(!zona.Activa ? "true" : "false")" />
                                    @if (zona.Activa)
                                    {
                                        <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" style="font-size: 0.8rem;"
                                                title="Inactivar zona de cobertura"
                                                onclick="return confirm('¿Está seguro de que desea inactivar esta zona? Se moverá al Panel de Zonas Inactivas y sus franjas no estarán disponibles para nuevos envíos.');">
                                            Inactivar
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-success btn-sm py-1 px-3 text-white" style="font-size: 0.8rem;"
                                                title="Reactivar zona de cobertura">
                                            Reactivar Zona
                                        </button>
                                    }
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var zonasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Zonas, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            if (window.MapasUltimaMilla && typeof window.MapasUltimaMilla.renderizarMapaVisualizadorZonas === 'function') {
                window.MapasUltimaMilla.renderizarMapaVisualizadorZonas('mapaZonasGeneralLeaflet', zonasData);
            }
        });
    </script>
}
