@page "{id:guid}"
@model UltimaMilla.Backoffice.Pages.Comercios.EditarModel
@{
    ViewData["Title"] = "Editar Comercio";
}

<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Editar Comercio Asociado (UC-01)</h1>
        <p class="text-secondary small mb-0">Actualización de datos y verificación de concurrencia optimista.</p>
    </div>
    <a asp-page="/Comercios/Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver al listado</span>
    </a>
</div>

<!-- Alerta de Concurrencia Optimista (Regla 7) -->
@if (!string.IsNullOrEmpty(Model.ErrorConcurrencia))
{
    <div class="alert alert-warning border-warning shadow-sm rounded-3 mb-3" role="alert">
        <div class="d-flex align-items-center">
            <div class="text-warning me-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <div>
                <strong>Conflicto de concurrencia (HTTP 409):</strong>
                <div>@Model.ErrorConcurrencia</div>
            </div>
        </div>
        <div class="mt-2">
            <a asp-page="/Comercios/Editar" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm">
                Recargar registro ahora
            </a>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorGeneral))
{
    <div class="alert alert-danger small py-2 mb-3">
        @Model.ErrorGeneral
    </div>
}

<div class="card border-0 shadow-sm rounded-3" style="max-width: 760px;">
    <div class="card-body p-4">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <!-- Sello de modificación oculto para control de concurrencia optimista -->
            <input type="hidden" asp-for="Comercio.SelloModificacion" />

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Comercio.RazonSocial" class="form-label small fw-semibold">Razón Social *</label>
                    <input asp-for="Comercio.RazonSocial" class="form-control form-control-sm" />
                    <span asp-validation-for="Comercio.RazonSocial" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Comercio.NombreFantasia" class="form-label small fw-semibold">Nombre de Fantasía *</label>
                    <input asp-for="Comercio.NombreFantasia" class="form-control form-control-sm" />
                    <span asp-validation-for="Comercio.NombreFantasia" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">RUT (No editable)</label>
                    <input class="form-control form-control-sm" value="@Model.RutOriginal" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="Comercio.Email" class="form-label small fw-semibold">Correo Electrónico *</label>
                    <input asp-for="Comercio.Email" class="form-control form-control-sm" />
                    <span asp-validation-for="Comercio.Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Comercio.Telefono" class="form-label small fw-semibold">Teléfono *</label>
                    <input asp-for="Comercio.Telefono" class="form-control form-control-sm" />
                    <span asp-validation-for="Comercio.Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Comercio.Direccion" class="form-label small fw-semibold">Dirección *</label>
                    <input asp-for="Comercio.Direccion" class="form-control form-control-sm" />
                    <span asp-validation-for="Comercio.Direccion" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" asp-for="Comercio.Activo" id="comercioActivo" />
                <label class="form-check-label small fw-semibold" for="comercioActivo">Comercio habilitado para operar</label>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <!-- Botón de prueba para simular colisión 409 durante la defensa -->
                <button type="submit" asp-page-handler="SimularConflicto" class="btn btn-outline-warning btn-sm" title="Prueba para evaluar manejo de 409">
                    Simular Conflicto 409 (Demo)
                </button>
                <div class="d-flex gap-2">
                    <a asp-page="/Comercios/Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
                    <button type="submit" class="btn btn-dark btn-sm px-3">Guardar Cambios</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
