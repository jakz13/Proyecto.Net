@page
@model UltimaMilla.Backoffice.Pages.Envios.IndexModel
@{
    ViewData["Title"] = "Gestión de Envíos y Trazabilidad";
}

<!-- Encabezado Principal -->
<div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h4 fw-bold text-dark mb-0">Gestión de Envíos y Trazabilidad</h1>
        <partial name="_BotonAyuda" model='"Identificación y gestión integral de envíos. Permite declarar formalmente envíos extraviados (UC-43) cuando no pueden ser ubicados tras la gestión correspondiente (en depósito o en tránsito), registrar el evento en el historial completo de auditoría (RF-11, RF-12), emitir aviso automático al comercio remitente y asociar la incidencia correspondiente."' />
    </div>
</div>

<!-- Mensajes de Alerta -->
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 text-dark border-success-subtle shadow-sm" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success flex-shrink-0" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <div>@Model.MensajeExito</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 text-dark border-danger-subtle shadow-sm" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger flex-shrink-0" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div>@Model.MensajeError</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Métricas Superiores de Envíos -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
            <span class="text-secondary small fw-semibold mb-1">Total Registrados</span>
            <div class="h3 fw-bold mb-0 text-dark">@Model.TotalRegistrados</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
            <span class="text-secondary small fw-semibold mb-1">En Depósito</span>
            <div class="h3 fw-bold mb-0 text-info">@Model.TotalEnDeposito</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
            <span class="text-secondary small fw-semibold mb-1">En Tránsito</span>
            <div class="h3 fw-bold mb-0 text-primary">@Model.TotalEnTransito</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white">
            <span class="text-secondary small fw-semibold mb-1">Extraviados</span>
            <div class="h3 fw-bold mb-0 text-danger">@Model.TotalExtraviados</div>
        </div>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <label for="filtroEstado" class="visually-hidden">Estado</label>
                <select id="filtroEstado" name="estadoFiltro" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="Todos" selected="@(Model.EstadoFiltro == "Todos")">Todos los estados</option>
                    <option value="CandidatosExtravio" selected="@(Model.EstadoFiltro == "CandidatosExtravio")">Candidatos a Extravío (En depósito / En tránsito)</option>
                    <option value="EnDeposito" selected="@(Model.EstadoFiltro == "EnDeposito")">En Depósito</option>
                    <option value="EnTransito" selected="@(Model.EstadoFiltro == "EnTransito")">En Tránsito</option>
                    <option value="Extraviado" selected="@(Model.EstadoFiltro == "Extraviado")">Extraviados</option>
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label for="filtroBusqueda" class="visually-hidden">Búsqueda</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" id="filtroBusqueda" name="busqueda" class="form-control border-start-0" placeholder="Buscar por código de tracking, destinatario, dirección o comercio..." value="@Model.Busqueda" />
                </div>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark btn-sm flex-grow-1">Buscar</button>
                @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.EstadoFiltro != "Todos")
                {
                    <a asp-page="/Envios/Index" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros">Limpiar</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla Principal de Envíos -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tablaEnvios">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th class="ps-3 py-3">Código / Fecha</th>
                        <th class="py-3">Comercio</th>
                        <th class="py-3">Destinatario y Dirección</th>
                        <th class="py-3">Ruta / Repartidor</th>
                        <th class="py-3">Estado</th>
                        <th class="text-end pe-3 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model.EnvioLista.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-secondary">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-2 text-muted" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="8" y1="12" x2="16" y2="12"></line>
                                </svg>
                                <div>No se encontraron envíos con los filtros especificados.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var envio in Model.EnvioLista)
                        {
                            var esCandidatoExtravio = envio.Estado == UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.EnDeposito ||
                                                     envio.Estado == UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.EnTransito;

                            <tr>
                                <td class="ps-3 py-3">
                                    <div class="fw-bold text-dark font-monospace">@envio.CodigoSeguimiento</div>
                                    <div class="text-secondary small">@envio.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold text-dark">@(envio.ComercioNombre ?? "Comercio General")</div>
                                    <div class="text-secondary small">@(envio.PesoKg > 0 ? $"{envio.PesoKg} kg" : "")</div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold text-dark">@envio.NombreDestinatario</div>
                                    <div class="text-secondary small text-truncate" style="max-width: 260px;" title="@envio.DireccionDestino">
                                        @envio.DireccionDestino
                                    </div>
                                </td>
                                <td class="py-3">
                                    @if (!string.IsNullOrEmpty(envio.HojaDeRutaNumero))
                                    {
                                        <div class="fw-semibold text-dark">@envio.HojaDeRutaNumero</div>
                                        <div class="text-secondary small">@(envio.RepartidorNombre ?? "Sin asignar")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin asignar a ruta</span>
                                    }
                                </td>
                                <td class="py-3">
                                    @switch (envio.Estado)
                                    {
                                        case UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.Entregado:
                                            <span class="estado-entregado">Entregado</span>
                                            break;
                                        case UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.Extraviado:
                                            <span class="estado-fallo">Extraviado</span>
                                            @if (!string.IsNullOrEmpty(envio.IncidenciaAsociadaNumero))
                                            {
                                                <div class="mt-1">
                                                    <a asp-page="/Incidencias/Index" asp-route-busqueda="@envio.IncidenciaAsociadaNumero" class="small text-secondary font-monospace text-decoration-none" title="Ver incidencia operativa">
                                                        @envio.IncidenciaAsociadaNumero
                                                    </a>
                                                </div>
                                            }
                                            break;
                                        case UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.NoEntregado:
                                            <span class="estado-fallo">No Entregado</span>
                                            break;
                                        case UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.Admitido:
                                            <span class="estado-intermedio">Admitido</span>
                                            break;
                                        case UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.EnDeposito:
                                            <span class="estado-intermedio">En Depósito</span>
                                            break;
                                        case UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.AsignadoARuta:
                                            <span class="estado-intermedio">Asignado a Ruta</span>
                                            break;
                                        case UltimaMilla.Frontend.Contracts.Enums.EstadoEnvioDto.EnTransito:
                                            <span class="estado-intermedio">En Tránsito</span>
                                            break;
                                        default:
                                            <span class="estado-intermedio">@envio.Estado</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3 py-3">
                                    <div class="d-inline-flex align-items-center gap-1 justify-content-end">
                                        @if (esCandidatoExtravio)
                                        {
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-danger p-1 px-2 d-inline-flex align-items-center justify-content-center"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top"
                                                    title="Declarar Extraviado"
                                                    aria-label="Declarar Extraviado"
                                                    onclick="abrirModalExtravio('@envio.Id', '@envio.CodigoSeguimiento', '@(envio.ComercioNombre ?? "Comercio General")', '@envio.NombreDestinatario', '@envio.Estado')">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                                </svg>
                                            </button>
                                        }
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-secondary p-1 px-2 d-inline-flex align-items-center justify-content-center text-dark"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Historial de Trazabilidad"
                                                aria-label="Historial de Trazabilidad"
                                                onclick="abrirModalHistorial('@envio.Id', '@envio.CodigoSeguimiento')">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <polyline points="12 6 12 12 16 14"></polyline>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal 1: Declarar Envío Extraviado (UC-43) con dimensiones estables y sin saltos -->
<div class="modal fade" id="modalDeclararExtravio" tabindex="-1" aria-labelledby="tituloModalExtravio" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="DeclararExtraviado" id="formDeclararExtravio">
                <input type="hidden" asp-for="DeclaracionInput.EnvioId" id="inputExtravioEnvioId" />
                <input type="hidden" asp-for="DeclaracionInput.CodigoSeguimiento" id="inputExtravioCodigo" />

                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title fs-6 fw-bold d-flex align-items-center gap-2" id="tituloModalExtravio">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        Declarar Envío Extraviado
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Ficha resumen del envío seleccionado -->
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-secondary d-block">Código de Tracking:</span>
                                <span class="fw-bold text-dark font-monospace" id="lblExtravioCodigo">-</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-secondary d-block">Estado Operativo Actual:</span>
                                <span class="badge bg-warning-subtle border border-warning-subtle fw-semibold" id="lblExtravioEstadoActual" style="color: #92400E !important;">-</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-secondary d-block">Comercio Remitente:</span>
                                <span class="fw-semibold text-dark" id="lblExtravioComercio">-</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-secondary d-block">Destinatario:</span>
                                <span class="fw-semibold text-dark" id="lblExtravioDestinatario">-</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="selectMotivoExtravio" class="form-label small fw-semibold text-dark">
                            Motivo del Extravío <span class="text-danger">*</span>
                        </label>
                        <select asp-for="DeclaracionInput.MotivoExtravio" id="selectMotivoExtravio" class="form-select form-select-sm" required>
                            <option value="">Seleccione el motivo de la no ubicación...</option>
                            <option value="No aparece en rendición física del repartidor">No aparece en rendición física del repartidor</option>
                            <option value="Bulto no localizado en depósito tras clasificación">Bulto no localizado en depósito tras clasificación</option>
                            <option value="Discrepancia en carga de vehículo no resuelta">Discrepancia en carga de vehículo no resuelta</option>
                            <option value="Paquete perdido en trayecto durante distribución">Paquete perdido en trayecto durante distribución</option>
                            <option value="Otro motivo operativo de extravío">Otro motivo operativo de extravío</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="txtObservacionesExtravio" class="form-label small fw-semibold text-dark">
                            Observaciones de la Gestión de Búsqueda <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="DeclaracionInput.ObservacionesDetalladas" id="txtObservacionesExtravio" class="form-control form-control-sm" rows="3" placeholder="Detalle las gestiones realizadas para intentar ubicar el paquete (muelles revisados, contacto con el chofer, etc.)..." required></textarea>
                    </div>

                    <div class="p-3 border rounded-3 bg-white mb-2">
                        <span class="small fw-semibold text-dark d-block mb-2">Acciones Operativas Complementarias</span>
                        
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="DeclaracionInput.CrearIncidenciaOperativa" id="chkCrearIncidencia" checked onchange="toggleSeleccionIncidenciaExistente()" />
                            <label class="form-check-label small text-dark" for="chkCrearIncidencia">
                                Generar automáticamente una incidencia operativa de severidad Alta para seguimiento
                            </label>
                        </div>

                        <div class="mb-2 ps-4" id="bloqueIncidenciaExistente" style="display: none;">
                            <label for="selectIncidenciaExistente" class="form-label small text-secondary">
                                O asociar a una incidencia abierta existente:
                            </label>
                            <select asp-for="DeclaracionInput.NumeroIncidenciaExistente" id="selectIncidenciaExistente" class="form-select form-select-sm">
                                <option value="">(Ninguna - no asociar a existente)</option>
                                @foreach (var inc in Model.IncidenciasAbiertas)
                                {
                                    <option value="@inc.NumeroIncidencia">@inc.NumeroIncidencia - @inc.Tipo (@inc.Severidad) - @inc.Descripcion.Substring(0, Math.Min(40, inc.Descripcion.Length))...</option>
                                }
                            </select>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="DeclaracionInput.NotificarComercio" id="chkNotificarComercio" checked />
                            <label class="form-check-label small text-dark" for="chkNotificarComercio">
                                Emitir aviso inmediato al comercio según sus canales configurados (webhook / email)
                            </label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-3 border-top d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-danger px-4 fw-semibold d-inline-flex align-items-center gap-2">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Confirmar Declaración de Extravío
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Historial de Trazabilidad Completo y Mapa de Seguimiento -->
<div class="modal fade" id="modalHistorialTrazabilidad" tabindex="-1" aria-labelledby="tituloModalHistorial" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <div>
                        <h5 class="modal-title fs-6 fw-bold mb-0" id="tituloModalHistorial">Línea de Vida y Mapa de Seguimiento del Envío</h5>
                        <div class="text-white-50 small font-monospace" id="lblHistorialCodigo">Cargando...</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-3 align-items-stretch">
                    <!-- Columna izquierda: Mapa Leaflet de parada y unidad de reparto -->
                    <div class="col-12 col-lg-6 d-flex">
                        <div class="card border shadow-none rounded-3 w-100 h-100 d-flex flex-column">
                            <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                                <span class="small fw-bold text-uppercase text-secondary">Mapa de Ubicación y Ruta</span>
                                <span class="small text-muted" id="lblSubtituloMapaEnvio">Parada y recorrido</span>
                            </div>
                            <div class="card-body p-0 flex-grow-1">
                                <div id="mapaHistorialEnvioLeaflet" class="um-mapa-leaflet" style="height: 320px;"></div>
                            </div>
                            <div class="card-footer bg-white py-2 px-3 border-top d-flex flex-wrap gap-3 small" style="font-size: 0.72rem;">
                                <span class="d-inline-flex align-items-center gap-1 text-secondary">
                                    <span class="d-inline-block rounded-1" style="width: 10px; height: 10px; background-color: #0F172A;"></span> Depósito
                                </span>
                                <span class="d-inline-flex align-items-center gap-1 text-secondary">
                                    <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background-color: #1D4ED8;"></span> Parada de entrega
                                </span>
                                <span class="d-inline-flex align-items-center gap-1 text-secondary">
                                    <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background-color: #15803D;"></span> Camión de reparto
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Columna derecha: Historial de eventos -->
                    <div class="col-12 col-lg-6 d-flex">
                        <div class="card border shadow-none rounded-3 w-100 h-100">
                            <div class="card-header bg-white py-2 px-3 border-bottom">
                                <span class="small fw-bold text-uppercase text-secondary">Eventos Históricos de Auditoría</span>
                            </div>
                            <div class="card-body p-3" style="max-height: 360px; overflow-y: auto;">
                                <div id="cargandoHistorial" class="text-center py-4">
                                    <div class="spinner-border spinner-border-sm text-secondary" role="status">
                                        <span class="visually-hidden">Cargando historial...</span>
                                    </div>
                                    <div class="text-secondary small mt-2">Consultando registros históricos de auditoría...</div>
                                </div>

                                <div id="contenedorHistorial" style="display: none;">
                                    <div class="position-relative ps-4" id="listaEventosTimeline" style="border-left: 2px solid #dee2e6;">
                                        <!-- Se puebla dinámicamente con JavaScript -->
                                    </div>
                                </div>

                                <div id="errorHistorial" class="alert alert-warning small mb-0" style="display: none;">
                                    No se pudieron cargar los eventos históricos del envío seleccionado.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light py-2 px-3 border-top">
                <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var catalogoEnviosVista = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EnvioLista));
        // Función para abrir y pre-cargar el modal de declaración de extravío
        function abrirModalExtravio(envioId, codigoSeguimiento, comercio, destinatario, estadoActual) {
            document.getElementById('inputExtravioEnvioId').value = envioId;
            document.getElementById('inputExtravioCodigo').value = codigoSeguimiento;
            document.getElementById('lblExtravioCodigo').innerText = codigoSeguimiento;
            document.getElementById('lblExtravioComercio').innerText = comercio;
            document.getElementById('lblExtravioDestinatario').innerText = destinatario;
            
            var estadoBadge = document.getElementById('lblExtravioEstadoActual');
            estadoBadge.innerText = estadoActual;

            document.getElementById('selectMotivoExtravio').selectedIndex = 0;
            document.getElementById('txtObservacionesExtravio').value = '';
            document.getElementById('chkCrearIncidencia').checked = true;
            document.getElementById('chkNotificarComercio').checked = true;
            toggleSeleccionIncidenciaExistente();

            var modalElemento = document.getElementById('modalDeclararExtravio');
            var modalInstancia = bootstrap.Modal.getOrCreateInstance(modalElemento);
            modalInstancia.show();
        }

        // Alternar visualización del selector de incidencias existentes
        function toggleSeleccionIncidenciaExistente() {
            var chkCrear = document.getElementById('chkCrearIncidencia');
            var bloqueExistente = document.getElementById('bloqueIncidenciaExistente');
            if (chkCrear.checked) {
                bloqueExistente.style.display = 'none';
            } else {
                bloqueExistente.style.display = 'block';
            }
        }

        // Consultar y renderizar línea de vida histórica en modal
        function abrirModalHistorial(envioId, codigoSeguimiento) {
            document.getElementById('lblHistorialCodigo').innerText = codigoSeguimiento;
            var cargando = document.getElementById('cargandoHistorial');
            var contenedor = document.getElementById('contenedorHistorial');
            var error = document.getElementById('errorHistorial');
            var timeline = document.getElementById('listaEventosTimeline');

            cargando.style.display = 'block';
            contenedor.style.display = 'none';
            error.style.display = 'none';
            timeline.innerHTML = '';

            var modalElemento = document.getElementById('modalHistorialTrazabilidad');
            var modalInstancia = bootstrap.Modal.getOrCreateInstance(modalElemento);
            modalInstancia.show();

            // Renderizar mapa Leaflet con parada de entrega y camión (si está en ruta) una vez abierto el modal
            setTimeout(function () {
                if (window.MapasUltimaMilla && Array.isArray(catalogoEnviosVista)) {
                    var envioSel = catalogoEnviosVista.find(function (e) {
                        return String(e.Id || e.id).toLowerCase() === String(envioId).toLowerCase();
                    });
                    if (envioSel) {
                        window.MapasUltimaMilla.renderizarMapaSeguimientoEnvio('mapaHistorialEnvioLeaflet', envioSel);
                    }
                }
            }, 240);

            fetch('?handler=Historial&id=' + encodeURIComponent(envioId))
                .then(function(response) {
                    if (!response.ok) throw new Error('Error de red');
                    return response.json();
                })
                .then(function(eventos) {
                    cargando.style.display = 'none';
                    if (!eventos || eventos.length === 0) {
                        timeline.innerHTML = '<div class="text-secondary small">No hay eventos registrados para este envío.</div>';
                        contenedor.style.display = 'block';
                        return;
                    }

                    var html = '';
                    eventos.forEach(function(evento) {
                        var fechaFormateada = new Date(evento.fechaHora).toLocaleString();
                        var esExtraviado = evento.nuevoEstado === 10 || evento.nuevoEstado === 'Extraviado';

                        html += '<div class="position-relative mb-4 pb-1">';
                        // Punto del timeline
                        var puntoColor = esExtraviado ? '#dc3545' : '#0d6efd';
                        html += '<div class="position-absolute rounded-circle" style="left: -29px; top: 2px; width: 14px; height: 14px; background-color: ' + puntoColor + '; border: 3px solid #fff; box-shadow: 0 0 0 1px #ced4da;"></div>';

                        html += '<div class="d-flex justify-content-between align-items-baseline mb-1">';
                        html += '  <span class="fw-bold small text-dark">' + escapeHtml(evento.descripcionEvento) + '</span>';
                        html += '  <span class="text-secondary small font-monospace">' + fechaFormateada + '</span>';
                        html += '</div>';

                        html += '<div class="small text-secondary mb-1">Registrado por: <strong class="text-dark">' + escapeHtml(evento.usuario || 'Sistema') + '</strong></div>';

                        if (evento.motivoDetalle) {
                            html += '<div class="small bg-light border rounded p-2 mb-1 text-dark"><strong>Motivo:</strong> ' + escapeHtml(evento.motivoDetalle) + '</div>';
                        }

                        if (evento.numeroIncidenciaAsociada) {
                            html += '<div class="small text-danger mb-1"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path></svg>Incidencia Operativa: <strong>' + escapeHtml(evento.numeroIncidenciaAsociada) + '</strong></div>';
                        }

                        if (evento.notificacionEnviada) {
                            html += '<div class="small text-success"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1"><polyline points="20 6 9 17 4 12"></polyline></svg>Aviso al comercio remitente emitido correctamente</div>';
                        }

                        html += '</div>';
                    });

                    timeline.innerHTML = html;
                    contenedor.style.display = 'block';
                })
                .catch(function(err) {
                    cargando.style.display = 'none';
                    error.style.display = 'block';
                });
        }

        function escapeHtml(texto) {
            if (!texto) return '';
            var div = document.createElement('div');
            div.innerText = texto;
            return div.innerHTML;
        }
    </script>
}
