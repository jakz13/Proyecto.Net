@page "/login"
@layout LoginLayout
@using System.Net
@inject HttpClient Http
@inject ITokenStore TokenStore
@inject NavigationManager Navegador

<PageTitle>Portal del Comercio — Ingresar</PageTitle>

<div class="card border-0 shadow-sm rounded-3" style="max-width: 440px; width: 100%;">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-dark text-white rounded-circle mb-3"
                 style="width: 48px; height: 48px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
            </div>
            <h1 class="h4 fw-bold mb-1">Acceso al Portal del Comercio</h1>
            <p class="text-muted small mb-0">Ingrese con su correo y contraseña.</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger small py-2" role="alert">@error</div>
        }

        <EditForm Model="modelo" OnValidSubmit="IngresarAsync" FormName="login-comercio">
            <div class="mb-3">
                <label class="form-label small fw-semibold" for="email">Correo electrónico</label>
                <InputText id="email" class="form-control" type="email" autocomplete="username" @bind-Value="modelo.Email" />
            </div>
            <div class="mb-4">
                <label class="form-label small fw-semibold" for="password">Contraseña</label>
                <InputText id="password" class="form-control" type="password" autocomplete="current-password" @bind-Value="modelo.Password" />
            </div>
            <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold" disabled="@enCurso">
                @(enCurso ? "Ingresando…" : "Iniciar Sesión")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly CredencialesModelo modelo = new();
    private string? error;
    private bool enCurso;

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "baja")]
    public string? Baja { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Baja == "1")
            error = "El operador dio de baja a este comercio: se cerró su sesión y no puede realizar más acciones. Comuníquese con el operador logístico.";

        // Entrar al login equivale a empezar de cero: se descarta cualquier token anterior (sesión cerrada o vencida)
        await TokenStore.EliminarTokenAsync();
    }

    private async Task IngresarAsync()
    {
        error = null;
        enCurso = true;
        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/v1/auth/login", new { modelo.Email, modelo.Password });

            if (respuesta.StatusCode == HttpStatusCode.Unauthorized)
            {
                error = "Correo o contraseña incorrectos.";
                return;
            }
            if (respuesta.StatusCode == HttpStatusCode.Locked)
            {
                error = "Cuenta bloqueada temporalmente por intentos fallidos. Intente más tarde.";
                return;
            }
            if (respuesta.StatusCode == HttpStatusCode.Forbidden)
            {
                error = "Este comercio u operador se encuentra dado de baja. Comuníquese con el operador logístico.";
                return;
            }
            if (!respuesta.IsSuccessStatusCode)
            {
                error = "No se pudo iniciar sesión. Verifique sus datos e intente nuevamente.";
                return;
            }

            var resultado = await respuesta.Content.ReadFromJsonAsync<RespuestaLogin>();
            if (resultado is null || string.IsNullOrWhiteSpace(resultado.Token))
            {
                error = "Respuesta inválida del servidor.";
                return;
            }

            var perfilNormalizado = (resultado.Perfil ?? string.Empty).Trim();
            if (!perfilNormalizado.Equals("Comercio", StringComparison.OrdinalIgnoreCase) &&
                !perfilNormalizado.Equals("Administrador de Comercio", StringComparison.OrdinalIgnoreCase) &&
                !perfilNormalizado.Equals("ComercioAdmin", StringComparison.OrdinalIgnoreCase))
            {
                error = "Este portal es exclusivo para usuarios administradores de comercios clientes.";
                return;
            }

            await TokenStore.GuardarTokenAsync(resultado.Token);
            // Recarga completa para que todo el portal arranque ya con la sesión
            Navegador.NavigateTo("/", forceLoad: true);
        }
        catch
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            enCurso = false;
        }
    }

    private sealed class CredencialesModelo
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private sealed record RespuestaLogin(string Token, string Perfil);
}
