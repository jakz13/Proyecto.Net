@page "/cuenta-corriente"
@using System.Globalization
@using UltimaMilla.Frontend.Contracts.Modelos.Liquidaciones
@inject ICuentaCorrienteApi CuentaApi

<PageTitle>Portal del Comercio — Cuenta Corriente</PageTitle>

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">Cuenta Corriente y Liquidaciones</h1>
    <p class="text-muted small mb-0">Saldo con su operador, movimientos recientes y liquidaciones de los envíos entregados.</p>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger py-2 px-3 small rounded-3" role="alert">@mensajeError</div>
}

@if (cargando)
{
    <div class="text-secondary small">Cargando...</div>
}
else if (cuenta is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="text-muted small fw-semibold text-uppercase">Saldo adeudado</div>
                <div class="h2 fw-bold mb-0 @(cuenta.Saldo > 0 ? "text-danger" : "text-success")">@Formato(cuenta.Saldo)</div>
                <div class="small text-secondary mt-1">@(cuenta.Saldo > 0 ? "Pendiente de pago al operador" : "Sin deuda")</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="text-muted small fw-semibold text-uppercase">Liquidaciones</div>
                <div class="h2 fw-bold mb-0 text-dark">@liquidaciones.Count</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 px-4 border-bottom"><h2 class="h6 fw-bold mb-0">Movimientos recientes</h2></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 small">
                        <thead class="table-light"><tr><th class="ps-4">Fecha</th><th>Concepto</th><th class="pe-4 text-end">Monto</th></tr></thead>
                        <tbody>
                            @if (cuenta.Movimientos.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-secondary py-3">Sin movimientos.</td></tr>
                            }
                            @foreach (var m in cuenta.Movimientos)
                            {
                                <tr>
                                    <td class="ps-4">@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td>@m.Concepto</td>
                                    <td class="pe-4 text-end @(m.Monto < 0 ? "text-success" : "")">@Formato(m.Monto)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 px-4 border-bottom"><h2 class="h6 fw-bold mb-0">Liquidaciones</h2></div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 small">
                        <thead class="table-light"><tr><th class="ps-4">Período</th><th>Envíos</th><th>Estado</th><th class="pe-4 text-end">Total</th></tr></thead>
                        <tbody>
                            @if (liquidaciones.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-secondary py-3">Todavía no hay liquidaciones.</td></tr>
                            }
                            @foreach (var l in liquidaciones)
                            {
                                <tr>
                                    <td class="ps-4">@l.PeriodoDesde.ToString("dd/MM") – @l.PeriodoHasta.ToString("dd/MM/yyyy")</td>
                                    <td>@l.CantidadEnvios</td>
                                    <td><span class="badge text-bg-secondary">@l.Estado</span></td>
                                    <td class="pe-4 text-end fw-semibold">@Formato(l.MontoTotal)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CuentaCorrienteDto? cuenta;
    private List<LiquidacionDto> liquidaciones = new();
    private string? mensajeError;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cuenta = await CuentaApi.ObtenerCuentaCorrienteAsync();
            liquidaciones = (await CuentaApi.ListarLiquidacionesAsync()).ToList();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo cargar la cuenta corriente: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private string Formato(decimal monto) => $"{cuenta?.Moneda ?? "UYU"} {monto.ToString("N2", CultureInfo.GetCultureInfo("es-UY"))}";
}
