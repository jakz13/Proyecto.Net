@page "/cuenta-corriente"
@using System.Globalization
@using UltimaMilla.Frontend.Contracts.Modelos.Liquidaciones
@inject ICuentaCorrienteApi CuentaApi
@inject IIdentidadVisualApi IdentidadApi

<PageTitle>Portal del Comercio — Cuenta Corriente</PageTitle>

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">Cuenta Corriente y Liquidaciones</h1>
    <p class="text-muted small mb-0">Saldo con @(string.IsNullOrWhiteSpace(nombreOperador) ? "su operador" : nombreOperador), movimientos recientes y liquidaciones de los envíos entregados. Cada operador lleva su propia cuenta.</p>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger py-2 px-3 small rounded-3" role="alert">@mensajeError</div>
}

@if (cargando)
{
    <div class="text-secondary small">Cargando...</div>
}
else if (cuenta is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="text-muted small fw-semibold text-uppercase">Saldo adeudado</div>
                <div class="h2 fw-bold mb-0 @(cuenta.Saldo > 0 ? "text-danger" : "text-success")">@Formato(cuenta.Saldo)</div>
                <div class="small text-secondary mt-1">@(cuenta.Saldo > 0 ? "Pendiente de pago al operador" : "Sin deuda")</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="text-muted small fw-semibold text-uppercase">Liquidaciones</div>
                <div class="h2 fw-bold mb-0 text-dark">@liquidaciones.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3">
                <div class="text-muted small fw-semibold text-uppercase">Movimientos Registrados</div>
                <div class="h2 fw-bold mb-0 text-dark">@cuenta.Movimientos.Count</div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros de Cuenta Corriente y Liquidaciones -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Fecha Desde</label>
                    <input type="date" class="form-control form-control-sm" @bind="filtroFechaDesde" />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Fecha Hasta</label>
                    <input type="date" class="form-control form-control-sm" @bind="filtroFechaHasta" />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Buscar por concepto</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Ej: Envío, Cobranza, Ajuste..." @bind="filtroConcepto" @bind:event="oninput" />
                </div>
                <div class="col-12 col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">Estado Liquidación</label>
                    <select class="form-select form-select-sm" @bind="filtroEstadoLiquidacion">
                        <option value="">Todos los estados</option>
                        <option value="Emitida">Emitida</option>
                        <option value="Pagada">Pagada</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Anulada">Anulada</option>
                    </select>
                </div>
                <div class="col-12 col-md-1 d-flex">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100" @onclick="LimpiarFiltros" title="Limpiar todos los filtros">
                        Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 fw-bold mb-0">Movimientos recientes</h2>
                    <span class="badge bg-light text-secondary border font-monospace">@MovimientosFiltrados.Count de @cuenta.Movimientos.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 small">
                        <thead class="table-light"><tr><th class="ps-4">Fecha</th><th>Concepto</th><th class="pe-4 text-end">Monto</th></tr></thead>
                        <tbody>
                            @if (MovimientosFiltrados.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-secondary py-4">
                                        @(cuenta.Movimientos.Count == 0 ? "Sin movimientos registrados." : "No se encontraron movimientos con los filtros aplicados.")
                                    </td>
                                </tr>
                            }
                            @foreach (var m in MovimientosFiltrados)
                            {
                                <tr>
                                    <td class="ps-4">@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td>@m.Concepto</td>
                                    <td class="pe-4 text-end @(m.Monto < 0 ? "text-success" : "")">@Formato(m.Monto)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 fw-bold mb-0">Liquidaciones</h2>
                    <span class="badge bg-light text-secondary border font-monospace">@LiquidacionesFiltradas.Count de @liquidaciones.Count</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 small">
                        <thead class="table-light"><tr><th class="ps-4">Período</th><th>Envíos</th><th>Estado</th><th class="text-end">Subtotal</th><th class="text-end">IVA</th><th class="pe-4 text-end">Total</th></tr></thead>
                        <tbody>
                            @if (LiquidacionesFiltradas.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-secondary py-4">
                                        @(liquidaciones.Count == 0 ? "Todavía no hay liquidaciones emitidas." : "No se encontraron liquidaciones con los filtros aplicados.")
                                    </td>
                                </tr>
                            }
                            @foreach (var l in LiquidacionesFiltradas)
                            {
                                <tr>
                                    <td class="ps-4">@l.PeriodoDesde.ToString("dd/MM") – @l.PeriodoHasta.ToString("dd/MM/yyyy")</td>
                                    <td>@l.CantidadEnvios</td>
                                    <td><span class="badge text-bg-secondary">@l.Estado</span></td>
                                    <td class="text-end">@Formato(l.Subtotal)</td>
                                    <td class="text-end">@Formato(l.Iva)</td>
                                    <td class="pe-4 text-end fw-semibold">@Formato(l.MontoTotal)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private CuentaCorrienteDto? cuenta;
    private List<LiquidacionDto> liquidaciones = new();
    private string? mensajeError;
    private bool cargando = true;
    private string? nombreOperador;

    // Estados de filtrado
    private DateTime? filtroFechaDesde;
    private DateTime? filtroFechaHasta;
    private string? filtroConcepto;
    private string? filtroEstadoLiquidacion;

    private IReadOnlyList<MovimientoCuentaCorrienteDto> MovimientosFiltrados
    {
        get
        {
            if (cuenta == null || cuenta.Movimientos == null) return Array.Empty<MovimientoCuentaCorrienteDto>();

            var consulta = cuenta.Movimientos.AsEnumerable();

            if (filtroFechaDesde.HasValue)
            {
                consulta = consulta.Where(m => m.Fecha.Date >= filtroFechaDesde.Value.Date);
            }

            if (filtroFechaHasta.HasValue)
            {
                consulta = consulta.Where(m => m.Fecha.Date <= filtroFechaHasta.Value.Date);
            }

            if (!string.IsNullOrWhiteSpace(filtroConcepto))
            {
                var termino = filtroConcepto.Trim();
                consulta = consulta.Where(m => m.Concepto.Contains(termino, StringComparison.OrdinalIgnoreCase));
            }

            return consulta.ToList();
        }
    }

    private IReadOnlyList<LiquidacionDto> LiquidacionesFiltradas
    {
        get
        {
            var consulta = liquidaciones.AsEnumerable();

            if (filtroFechaDesde.HasValue)
            {
                var desde = DateOnly.FromDateTime(filtroFechaDesde.Value);
                consulta = consulta.Where(l => l.PeriodoHasta >= desde);
            }

            if (filtroFechaHasta.HasValue)
            {
                var hasta = DateOnly.FromDateTime(filtroFechaHasta.Value);
                consulta = consulta.Where(l => l.PeriodoDesde <= hasta);
            }

            if (!string.IsNullOrWhiteSpace(filtroEstadoLiquidacion))
            {
                consulta = consulta.Where(l => string.Equals(l.Estado, filtroEstadoLiquidacion, StringComparison.OrdinalIgnoreCase));
            }

            return consulta.ToList();
        }
    }

    private void LimpiarFiltros()
    {
        filtroFechaDesde = null;
        filtroFechaHasta = null;
        filtroConcepto = null;
        filtroEstadoLiquidacion = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cuenta = await CuentaApi.ObtenerCuentaCorrienteAsync();
            liquidaciones = (await CuentaApi.ListarLiquidacionesAsync()).ToList();
            try
            {
                nombreOperador = (await IdentidadApi.ObtenerIdentidadActualAsync()).NombreComercial;
            }
            catch
            {
                // El nombre del operador es informativo: sin él la cuenta se muestra igual
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo cargar la cuenta corriente: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private string Formato(decimal monto) => $"{cuenta?.Moneda ?? "UYU"} {monto.ToString("N2", CultureInfo.GetCultureInfo("es-UY"))}";
}
