@page "/retiros"
@using UltimaMilla.Frontend.Contracts.Modelos.Retiros
@inject IRetirosApi RetirosApi
@inject TiempoRealEnviosServicio TiempoReal
@implements IDisposable
@inject IEnviosApi EnviosApi

<PageTitle>Portal del Comercio — Retiros en domicilio</PageTitle>

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">Retiros en domicilio</h1>
    <p class="text-muted small mb-0">
        Pida que el operador retire uno o más bultos en el domicilio de su comprador (cambios y devoluciones) y los haga llegar a su comercio.
        El comprador puede seguir el retiro con el mismo enlace público que usa para sus envíos.
    </p>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success d-flex justify-content-between align-items-center" role="status">
        <span>@mensajeExito</span>
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => mensajeExito = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
        <span>@mensajeError</span>
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => mensajeError = null"></button>
    </div>
}

@* Devoluciones: los envíos ya entregados se ofrecen para pedir su retiro por devolución, con los datos del comprador ya cargados *@
<div class="card border-0 shadow-sm mb-4" id="tarjetaDevoluciones">
    <div class="card-header bg-white fw-bold">Devolver un envío ya entregado</div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            Elija un envío entregado: el formulario de retiro se completa con los datos de su comprador y el operador pasa a buscar los bultos por su domicilio.
        </p>
        @if (cargandoEntregados)
        {
            <div class="text-muted small">Cargando envíos entregados...</div>
        }
        else if (entregados.Count == 0)
        {
            <div class="text-muted small">Todavía no tiene envíos entregados.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>Envío</th><th>Comprador</th><th>Domicilio</th><th>Fecha</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var envio in entregados)
                        {
                            <tr>
                                <td class="font-monospace small">@envio.CodigoSeguimiento</td>
                                <td class="small">@envio.NombreDestinatario</td>
                                <td class="small text-muted">@envio.DireccionDestino</td>
                                <td class="small">@envio.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-dark btn-sm" disabled="@(preparandoDevolucion == envio.Id)" @onclick="() => PrepararDevolucionAsync(envio)">
                                        Pedir retiro por devolución
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">Solicitar un retiro</div>
            <div class="card-body">
                <EditForm Model="solicitud" OnValidSubmit="SolicitarAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Quién entrega los bultos</label>
                        <InputText class="form-control form-control-sm" @bind-Value="solicitud.NombreContacto" placeholder="Nombre y apellido" />
                        <ValidationMessage For="@(() => solicitud.NombreContacto)" class="text-danger small" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Teléfono</label>
                            <InputText class="form-control form-control-sm" @bind-Value="solicitud.TelefonoContacto" />
                            <ValidationMessage For="@(() => solicitud.TelefonoContacto)" class="text-danger small" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Correo</label>
                            <InputText class="form-control form-control-sm" @bind-Value="solicitud.EmailContacto" />
                            <ValidationMessage For="@(() => solicitud.EmailContacto)" class="text-danger small" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-7">
                            <label class="form-label small fw-semibold">Calle</label>
                            <InputText class="form-control form-control-sm" @bind-Value="solicitud.Calle" />
                            <ValidationMessage For="@(() => solicitud.Calle)" class="text-danger small" />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-semibold">Número</label>
                            <InputText class="form-control form-control-sm" @bind-Value="solicitud.Numero" />
                            <ValidationMessage For="@(() => solicitud.Numero)" class="text-danger small" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Ciudad</label>
                        <InputText class="form-control form-control-sm" @bind-Value="solicitud.Ciudad" />
                        <ValidationMessage For="@(() => solicitud.Ciudad)" class="text-danger small" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Motivo del retiro</label>
                        <InputText class="form-control form-control-sm" @bind-Value="solicitud.Motivo" placeholder="Cambio de talle, producto defectuoso..." />
                        <ValidationMessage For="@(() => solicitud.Motivo)" class="text-danger small" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Fecha pedida (opcional)</label>
                            <InputDate class="form-control form-control-sm" @bind-Value="solicitud.FechaSolicitada" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Ventana horaria (opcional)</label>
                            <select class="form-select form-select-sm" @bind="franjaSeleccionadaTexto">
                                <option value="">Cualquier franja disponible</option>
                                @foreach (var franja in franjasDisponibles)
                                {
                                    <option value="@franja.Id">@franja.VentanaTexto</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-semibold">Bultos a retirar</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AgregarBulto">Agregar bulto</button>
                    </div>
                    @for (var i = 0; i < solicitud.Bultos.Count; i++)
                    {
                        var bulto = solicitud.Bultos[i];
                        var indice = i;
                        <div class="border rounded-3 p-2 mb-2 bg-light">
                            <div class="d-flex gap-2 mb-1">
                                <InputText class="form-control form-control-sm" @bind-Value="bulto.Descripcion" placeholder="Descripción" />
                                @if (solicitud.Bultos.Count > 1)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" aria-label="Quitar bulto" @onclick="() => QuitarBulto(indice)">×</button>
                                }
                            </div>
                            <div class="row g-1">
                                <div class="col-3"><InputNumber class="form-control form-control-sm" @bind-Value="bulto.Peso" placeholder="kg" /></div>
                                <div class="col-3"><InputNumber class="form-control form-control-sm" @bind-Value="bulto.Alto" placeholder="alto cm" /></div>
                                <div class="col-3"><InputNumber class="form-control form-control-sm" @bind-Value="bulto.Ancho" placeholder="ancho cm" /></div>
                                <div class="col-3"><InputNumber class="form-control form-control-sm" @bind-Value="bulto.Profundo" placeholder="prof. cm" /></div>
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn btn-marca w-100 mt-2" disabled="@enviando">
                        @(enviando ? "Enviando..." : "Solicitar retiro")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Mis retiros (@retiros.Count)</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CargarAsync">Actualizar</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr><th>Código</th><th>Domicilio</th><th>Motivo</th><th class="text-end">Tarifa</th><th>Estado</th><th></th></tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Cargando...</td></tr>
                        }
                        else if (retiros.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Todavía no solicitó retiros.</td></tr>
                        }
                        @foreach (var retiro in retiros)
                        {
                            <tr>
                                <td><span class="badge bg-light text-secondary border font-monospace">@retiro.CodigoSeguimiento</span></td>
                                <td>@retiro.DireccionRetiro<div class="text-muted">@retiro.CantidadBultos bulto(s)</div></td>
                                <td>@retiro.Motivo</td>
                                <td class="text-end">$ @retiro.Tarifa.ToString("N2")</td>
                                <td><span class="badge bg-dark">@retiro.Estado</span></td>
                                <td class="text-end">
                                    @if (retiro.Estado is "Solicitado" or "NoRetirado")
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => CancelarAsync(retiro.Id)">Cancelar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private SolicitarRetiroDto solicitud = new();
    private List<RetiroResumenDto> retiros = new();
    private List<FranjaRetiroDisponibleDto> franjasDisponibles = new();
    private string franjaSeleccionadaTexto = string.Empty;
    private bool cargando = true;
    private bool enviando;
    private string? mensajeExito;
    private string? mensajeError;
    private List<EnvioDto> entregados = new();
    private bool cargandoEntregados = true;
    private Guid? preparandoDevolucion;

    private CancellationTokenSource? _refrescoPendiente;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        await CargarEntregadosAsync();
    }

    private async Task CargarEntregadosAsync()
    {
        cargandoEntregados = true;
        try
        {
            var pagina = await EnviosApi.ListarEnviosAsync(new FiltroEnviosDto
            {
                Estado = EstadoEnvioDto.Entregado,
                Pagina = 1,
                TamanoPagina = 20,
                SoloEnviosPropiosComercio = true
            });
            entregados = pagina.Elementos.ToList();
        }
        catch (ApiExcepcion)
        {
            entregados = new List<EnvioDto>();
        }
        finally
        {
            cargandoEntregados = false;
        }
    }

    /// <summary>Completa el formulario de retiro con los datos del comprador y los bultos del envío entregado (motivo: devolución).</summary>
    private async Task PrepararDevolucionAsync(EnvioDto resumen)
    {
        preparandoDevolucion = resumen.Id;
        mensajeError = null;
        try
        {
            var envio = await EnviosApi.ObtenerPorIdAsync(resumen.Id) ?? resumen;
            var (calle, numero, ciudad) = SepararDireccion(envio.DireccionDestino);

            var cantidad = Math.Max(1, envio.BultosIdentificaciones?.Count ?? 1);
            var pesoPorBulto = envio.PesoKg is > 0 ? Math.Round(envio.PesoKg.Value / cantidad, 2) : 1m;

            solicitud = new SolicitarRetiroDto
            {
                NombreContacto = envio.NombreDestinatario,
                TelefonoContacto = envio.TelefonoDestinatario,
                Calle = calle,
                Numero = numero,
                Ciudad = ciudad,
                Motivo = $"Devolución del envío {envio.CodigoSeguimiento}",
                // Un mismo envío no genera dos retiros por devolución: el segundo pedido devuelve el primero
                ReferenciaExterna = $"DEV-{envio.CodigoSeguimiento}",
                Bultos = Enumerable.Range(1, cantidad)
                    .Select(i => new BultoRetiroSolicitudDto
                    {
                        Descripcion = envio.BultosIdentificaciones is { Count: > 0 } ids ? $"Devolución {ids[i - 1]}" : $"Devolución {envio.CodigoSeguimiento}",
                        Peso = pesoPorBulto
                    })
                    .ToList()
            };
            mensajeExito = $"Completamos el retiro con los datos del envío {envio.CodigoSeguimiento}. Revise los bultos y confirme con \"Solicitar retiro\".";
        }
        catch (ApiExcepcion ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            preparandoDevolucion = null;
        }
    }

    /// <summary>"Av. Italia 3456, Montevideo" → calle, número y ciudad. Lo que no se puede separar queda en la calle para que la persona lo corrija.</summary>
    private static (string Calle, string Numero, string Ciudad) SepararDireccion(string direccion)
    {
        var texto = (direccion ?? string.Empty).Trim();
        var ciudad = "Montevideo";
        var coma = texto.LastIndexOf(',');
        if (coma > 0)
        {
            ciudad = texto[(coma + 1)..].Trim();
            texto = texto[..coma].Trim();
        }

        var espacio = texto.LastIndexOf(' ');
        if (espacio > 0 && texto[(espacio + 1)..].Any(char.IsDigit))
            return (texto[..espacio].Trim(), texto[(espacio + 1)..].Trim(), ciudad);

        return (texto, string.Empty, ciudad);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            TiempoReal.RetiroCambioEstado += AlCambiarEstadoRetiro;
            await TiempoReal.IniciarAsync();
        }
    }

    private async Task AlCambiarEstadoRetiro(string codigoSeguimiento, string estado)
    {
        _refrescoPendiente?.Cancel();
        var cts = _refrescoPendiente = new CancellationTokenSource();
        try
        {
            await Task.Delay(600, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await CargarAsync(silencioso: true);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TiempoReal.RetiroCambioEstado -= AlCambiarEstadoRetiro;
        _refrescoPendiente?.Cancel();
    }

    private Task CargarAsync() => CargarAsync(silencioso: false);

    private async Task CargarAsync(bool silencioso)
    {
        if (!silencioso)
            cargando = true;
        try
        {
            var pagina = await RetirosApi.ListarDelComercioAsync();
            retiros = pagina.Items.ToList();
            if (pagina.FranjasDisponibles is { Count: > 0 })
                franjasDisponibles = pagina.FranjasDisponibles.ToList();
        }
        catch (ApiExcepcion ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AgregarBulto() => solicitud.Bultos.Add(new BultoRetiroSolicitudDto());

    private void QuitarBulto(int indice)
    {
        if (solicitud.Bultos.Count > 1)
            solicitud.Bultos.RemoveAt(indice);
    }

    private async Task SolicitarAsync()
    {
        enviando = true;
        mensajeError = null;
        try
        {
            solicitud.FranjaHorariaId = Guid.TryParse(franjaSeleccionadaTexto, out var fid) && fid != Guid.Empty ? fid : null;
            var resultado = await RetirosApi.SolicitarAsync(solicitud);
            mensajeExito = $"Retiro {resultado.CodigoSeguimiento} solicitado. Tarifa: $ {resultado.Tarifa:N2}. El comprador puede seguirlo con ese código en el enlace público de seguimiento.";
            solicitud = new SolicitarRetiroDto();
            franjaSeleccionadaTexto = string.Empty;
            await CargarAsync();
        }
        catch (ApiExcepcion ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task CancelarAsync(Guid id)
    {
        mensajeError = null;
        try
        {
            await RetirosApi.CancelarDelComercioAsync(id, "Cancelado por el comercio");
            mensajeExito = "El retiro se canceló.";
            await CargarAsync();
        }
        catch (ApiExcepcion ex)
        {
            mensajeError = ex.Message;
        }
    }
}
