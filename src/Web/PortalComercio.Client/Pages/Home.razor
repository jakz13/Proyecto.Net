@page "/"
@inject IEnviosApi EnviosApi
@inject NavigationManager Navegador

<PageTitle>Portal del Comercio — Tablero</PageTitle>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h4 fw-bold mb-1">Tablero de Gestión Logística</h1>
        <p class="text-muted small mb-0">Resumen y estado de las órdenes de despacho de su comercio.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-marca btn-sm d-inline-flex align-items-center gap-1" @onclick='() => Navegador.NavigateTo("envios/nuevo")'>
            <Icono Nombre="plus" Tamano="14" />
            <span>Nuevo Envío</span>
        </button>
    </div>
</div>

<!-- Métricas y Números Destacados (KPIs) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold text-uppercase">Total Envíos</div>
            <div class="h2 fw-bold mb-0 text-dark">@totalEnvios</div>
            <div class="small text-secondary mt-1">Registrados</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold text-uppercase">En Tránsito</div>
            <div class="h2 fw-bold mb-0 text-warning">@enTransito</div>
            <div class="small text-secondary mt-1">En reparto activo</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold text-uppercase">Entregados</div>
            <div class="h2 fw-bold mb-0 text-success">@entregados</div>
            <div class="small text-secondary mt-1">Concretados</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3">
            <div class="text-muted small fw-semibold text-uppercase">En Depósito</div>
            <div class="h2 fw-bold mb-0 text-primary">@enDeposito</div>
            <div class="small text-secondary mt-1">Por salir a ruta</div>
        </div>
    </div>
</div>

<!-- Envíos Recientes -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h2 class="h6 fw-bold mb-0">Envíos Recientes</h2>
        <a href="envios" class="small text-decoration-none fw-semibold">Ver todos &rarr;</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Código</th>
                    <th>Destinatario</th>
                    <th>Dirección</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (estaCargando)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <span class="spinner-border spinner-border-sm me-2"></span>Cargando métricas...
                        </td>
                    </tr>
                }
                else if (enviosRecientes.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No hay envíos registrados aún.</td>
                    </tr>
                }
                else
                {
                    @foreach (var envio in enviosRecientes)
                    {
                        <tr>
                            <td class="fw-bold font-monospace small">@envio.CodigoSeguimiento</td>
                            <td>@envio.NombreDestinatario</td>
                            <td class="text-muted small">@envio.DireccionDestino</td>
                            <td class="small">@envio.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <BadgeEstadoEnvio Estado="@envio.Estado" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private bool estaCargando = true;
    private int totalEnvios = 0;
    private int enTransito = 0;
    private int entregados = 0;
    private int enDeposito = 0;
    private List<EnvioDto> enviosRecientes = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarMetricas();
    }

    private async Task CargarMetricas()
    {
        estaCargando = true;
        try
        {
            var resultado = await EnviosApi.ListarEnviosAsync(new FiltroEnviosDto { Pagina = 1, TamanoPagina = 20 });
            totalEnvios = resultado.TotalRegistros;
            enTransito = resultado.Elementos.Count(e => e.Estado == EstadoEnvioDto.EnTransito);
            entregados = resultado.Elementos.Count(e => e.Estado == EstadoEnvioDto.Entregado);
            enDeposito = resultado.Elementos.Count(e => e.Estado == EstadoEnvioDto.EnDeposito);
            enviosRecientes = resultado.Elementos.Take(5).ToList();
        }
        catch
        {
            // Evita bloquear la carga inicial si la API backend aún no responde en modo sin mocks
            totalEnvios = 0;
            enTransito = 0;
            entregados = 0;
            enDeposito = 0;
            enviosRecientes = new();
        }
        finally
        {
            estaCargando = false;
        }
    }
}
