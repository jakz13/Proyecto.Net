@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject IWebAssemblyHostEnvironment EntornoHost
@inject MockContextoOperador ContextoOperador

@if (EntornoHost.IsDevelopment())
{
    <div class="banner-demo-dev d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-warning text-dark me-2">DEMO MODO DEV</span>
            <span>Simulador de Multitenancy de Operadores:</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="selectorOperadorPortal" class="form-label mb-0 small text-muted">Operador activo:</label>
            <select id="selectorOperadorPortal" class="form-select form-select-sm" style="width: auto;"
                    value="@ContextoOperador.OperadorActivo.OperadorId"
                    @onchange="CambiarOperador">
                @foreach (var operador in ContextoOperador.ListarOperadores())
                {
                    <option value="@operador.OperadorId">@operador.NombreComercial (@operador.OperadorId)</option>
                }
            </select>
        </div>
    </div>
}

@code {
    [Parameter]
    public EventCallback AlCambiar { get; set; }

    private async Task CambiarOperador(ChangeEventArgs e)
    {
        var nuevoId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(nuevoId))
        {
            ContextoOperador.SeleccionarOperador(nuevoId);
            await AlCambiar.InvokeAsync();
        }
    }
}
