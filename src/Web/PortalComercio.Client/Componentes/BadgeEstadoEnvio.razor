@using UltimaMilla.Frontend.Contracts.Enums

<span class="@ObtenerClaseCssPorEstado(Estado) @(EsGrande ? "fs-6" : "")" role="status">
    @ObtenerTextoLegiblePorEstado(Estado)
</span>

@code {
    [Parameter, EditorRequired]
    public EstadoEnvioDto Estado { get; set; }

    [Parameter]
    public bool EsGrande { get; set; } = false;

    private static string ObtenerClaseCssPorEstado(EstadoEnvioDto estado) => estado switch
    {
        EstadoEnvioDto.Entregado => "estado-entregado",
        EstadoEnvioDto.NoEntregado or EstadoEnvioDto.Extraviado => "estado-fallo",
        _ => "estado-intermedio"
    };

    private static string ObtenerTextoLegiblePorEstado(EstadoEnvioDto estado) => estado switch
    {
        EstadoEnvioDto.Admitido => "Admitido",
        EstadoEnvioDto.EnDeposito => "En depósito",
        EstadoEnvioDto.AsignadoARuta => "Asignado a ruta",
        EstadoEnvioDto.EnTransito => "En tránsito",
        EstadoEnvioDto.Entregado => "Entregado",
        EstadoEnvioDto.NoEntregado => "No entregado",
        EstadoEnvioDto.Reprogramado => "Reprogramado",
        EstadoEnvioDto.EnDevolucion => "En devolución",
        EstadoEnvioDto.Devuelto => "Devuelto",
        EstadoEnvioDto.Extraviado => "Extraviado",
        _ => estado.ToString()
    };
}
