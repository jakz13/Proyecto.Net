<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Auth"
             x:Class="UltimaMilla.Mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Inicio de Sesión - Operaciones en Terreno"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout
            Spacing="18"
            Padding="20,28"
            VerticalOptions="Center"
            MaximumWidthRequest="440">

            <!-- Tarjeta Central Elevada estilo Backoffice Login con Barra Superior de Acento -->
            <Border
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{DynamicResource CardBorderColor}"
                BackgroundColor="#FFFFFF"
                Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="14" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <!-- Barra Superior Corporativa Dual (PrimaryColor + SecondaryColor) -->
                    <Grid ColumnDefinitions="2*, *" HeightRequest="6">
                        <BoxView Grid.Column="0" Color="{DynamicResource PrimaryColor}" />
                        <BoxView Grid.Column="1" Color="{DynamicResource SecondaryColor}" />
                    </Grid>

                    <!-- Cabecera Oscura de Marca del Operador (Alineada con Sidebar/Header del Backoffice) -->
                    <Border StrokeThickness="0"
                            StrokeShape="Rectangle"
                            BackgroundColor="{DynamicResource HeaderBackgroundColor}"
                            Padding="24,20,24,18">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Grid HeightRequest="64" WidthRequest="64" HorizontalOptions="Center">
                                <!-- Si el operador tiene Logo (URL, Ruta o Base64) -->
                                <Border IsVisible="{Binding TieneLogoUrl}"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{DynamicResource SecondaryColor}"
                                        StrokeThickness="2"
                                        BackgroundColor="#FFFFFF"
                                        HeightRequest="64"
                                        WidthRequest="64"
                                        Padding="4"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Image Source="{Binding LogoSource}"
                                           Aspect="AspectFit"
                                           HeightRequest="52"
                                           WidthRequest="52"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Fallback: Cuadro Redondeado con Iniciales del Operador -->
                                <Border IsVisible="{Binding MostrarIniciales}"
                                        StrokeShape="RoundRectangle 14"
                                        Stroke="{DynamicResource SecondaryColor}"
                                        StrokeThickness="2"
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        HeightRequest="64"
                                        WidthRequest="64"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding InicialesOperador}"
                                           TextColor="#FFFFFF"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding NombreOperador}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="#FFFFFF" />

                            <Border BackgroundColor="{DynamicResource SecondaryColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="10,3"
                                    HorizontalOptions="Center">
                                <Label Text="PLATAFORMA DE OPERACIONES EN TERRENO"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Línea divisoria en SecondaryColor como en la cabecera del Backoffice -->
                    <BoxView HeightRequest="2" Color="{DynamicResource SecondaryColor}" />

                    <!-- Cuerpo del Formulario Empresarial -->
                    <VerticalStackLayout Spacing="16" Padding="24,22,24,24">

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Acceso de Personal Operativo"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="Ingrese sus credenciales corporativas para sincronizar su jornada."
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>

                        <!-- Campo Usuario / Email -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CORREO ELECTRÓNICO / USUARIO"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />

                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1.2"
                                    BackgroundColor="#FFFFFF"
                                    Padding="12,0"
                                    HeightRequest="46">
                                <Entry Placeholder="repartidor@gmail.com"
                                       Text="{Binding Usuario}"
                                       Keyboard="Email"
                                       ClearButtonVisibility="WhileEditing"
                                       IsEnabled="{Binding IsNotBusy}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo Contraseña -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="CONTRASEÑA"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />

                            <Border StrokeShape="RoundRectangle 8"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1.2"
                                    BackgroundColor="#FFFFFF"
                                    Padding="12,0"
                                    HeightRequest="46">
                                <Entry Placeholder="Ingrese su contraseña"
                                       Text="{Binding Password}"
                                       IsPassword="True"
                                       ClearButtonVisibility="WhileEditing"
                                       IsEnabled="{Binding IsNotBusy}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Mensajes de Estado / Error -->
                        <Border IsVisible="{Binding HasError}"
                                BackgroundColor="#FEF2F2"
                                Stroke="#FCA5A5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,8">
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="#B91C1C"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <Border IsVisible="{Binding HasStatus}"
                                BackgroundColor="#F0FDF4"
                                Stroke="#86EFAC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,8">
                            <Label Text="{Binding StatusMessage}"
                                   TextColor="#15803D"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <!-- Indicador de Carga -->
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{DynamicResource PrimaryColor}"
                            HorizontalOptions="Center" />

                        <!-- Botón Principal Ingresar -->
                        <Button
                            Text="Iniciar Sesión"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="8"
                            HeightRequest="48"
                            Margin="0,2,0,0" />

                        <!-- Botón Ingreso con Biometría -->
                        <Button
                            Text="Ingresar con Biometría"
                            Command="{Binding LoginConBiometriaCommand}"
                            IsVisible="{Binding PuedeUsarBiometria}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{DynamicResource SecondarySoftBackground}"
                            TextColor="{DynamicResource SecondaryColor}"
                            BorderColor="{DynamicResource SecondaryColor}"
                            BorderWidth="1.5"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="8"
                            HeightRequest="44" />

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
