<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Auth"
             x:Class="UltimaMilla.Mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Acceso Repartidor"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="{DynamicResource PaddingLogin}"
            VerticalOptions="Center">

            <!-- Encabezado / Branding -->
            <Label
                Text="📦 Última Milla"
                FontSize="{DynamicResource FontSizeLoginTitulo}"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#0D6EFD" />

            <Label
                Text="Ingreso a Operación de Calle"
                FontSize="16"
                HorizontalOptions="Center"
                TextColor="{AppThemeBinding Light=#6C757D, Dark=#ADB5BD}" />

            <!-- Contenedor del Formulario -->
            <Border
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2C}"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                Padding="{DynamicResource PaddingTarjetaLogin}"
                Margin="0,10,0,0">

                <VerticalStackLayout Spacing="16">

                    <!-- Campo Usuario -->
                    <Label
                        Text="Usuario / Email"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#212529, Dark=#E9ECEF}" />

                    <Entry
                        Placeholder="repartidor@operador.com"
                        Text="{Binding Usuario}"
                        Keyboard="Email"
                        ClearButtonVisibility="WhileEditing"
                        IsEnabled="{Binding IsNotBusy}" />

                    <!-- Campo Contraseña -->
                    <Label
                        Text="Contraseña"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light=#212529, Dark=#E9ECEF}" />

                    <Entry
                        Placeholder="••••••••"
                        Text="{Binding Password}"
                        IsPassword="True"
                        ClearButtonVisibility="WhileEditing"
                        IsEnabled="{Binding IsNotBusy}" />

                    <!-- Mensajes de Estado / Error -->
                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="#DC3545"
                        FontSize="13"
                        HorizontalOptions="Center"
                        IsVisible="{Binding ErrorMessage, Converter={x:Null}}" />

                    <Label
                        Text="{Binding StatusMessage}"
                        TextColor="#198754"
                        FontSize="13"
                        HorizontalOptions="Center"
                        IsVisible="{Binding StatusMessage, Converter={x:Null}}" />

                    <!-- Indicador de Carga -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="#0D6EFD"
                        HorizontalOptions="Center" />

                    <!-- Botón de Iniciar Sesión -->
                    <Button
                        Text="Iniciar Sesión"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#0D6EFD"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="48"
                        Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
