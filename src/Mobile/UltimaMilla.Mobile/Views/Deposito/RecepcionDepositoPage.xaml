<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Deposito"
             xmlns:dtos="clr-namespace:UltimaMilla.Mobile.Models.DTOs"
             xmlns:controls="clr-namespace:UltimaMilla.Mobile.Controls"
             x:Class="UltimaMilla.Mobile.Views.Deposito.RecepcionDepositoPage"
             x:DataType="vm:RecepcionDepositoViewModel"
             Title="Recepción en Depósito"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding CargarEnviosAdmitidosCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="{DynamicResource EspaciadoSecciones}" Padding="{DynamicResource PaddingPagina}">

                <!-- ========================================================= -->
                <!-- CABECERA DE LA PANTALLA                                   -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Recepción en Depósito"
                               Style="{StaticResource H2Label}" />
                        <Label Text="Contraste de bultos declarados por comercio y verificación de ingreso al depósito."
                               Style="{StaticResource BodyLabel}" />

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,4" />

                        <!-- Mensaje de estado -->
                        <Label Text="{Binding MensajeEstado}"
                               Style="{StaticResource CaptionLabel}"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- SELECTOR / BÚSQUEDA DE ENVÍO ADMITIDO                     -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}" IsVisible="{Binding SinEnvioSeleccionado}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Buscar o Seleccionar Envío Admitido" Style="{StaticResource H3Label}" />

                        <!-- Campo de Búsqueda -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    Stroke="{StaticResource InputBorder}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,0"
                                    HeightRequest="44"
                                    BackgroundColor="{StaticResource InputBackground}">
                                <Entry Text="{Binding FiltroBusqueda, Mode=TwoWay}"
                                       Placeholder="Código de seguimiento o destinatario"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       ReturnCommand="{Binding AplicarFiltroCommand}"
                                       ClearButtonVisibility="WhileEditing"
                                       VerticalOptions="Center" />
                            </Border>

                            <Button Grid.Column="1"
                                    Text="Buscar"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AplicarFiltroCommand}"
                                    HeightRequest="44"
                                    Padding="14,0"
                                    FontSize="13" />
                        </Grid>

                        <!-- Botón Escaneo Rápido para identificar envío por bulto -->
                        <Button Text="Escanear Bulto con Cámara"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding EscanearConCamaraCommand}"
                                HeightRequest="46"
                                FontSize="13"
                                FontAttributes="Bold" />

                        <!-- Lista de Envíos Admitidos Disponibles -->
                        <Label Text="Envíos Admitidos Disponibles" Style="{StaticResource CaptionLabel}" Margin="0,6,0,0" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EnviosFiltrados}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:EnvioAdmitidoMobileDto">
                                    <Border BackgroundColor="#FFFFFF"
                                            Stroke="{StaticResource CardBorder}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecepcionDepositoViewModel}}, Path=SeleccionarEnvioCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="3">
                                            <Label Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding CodigoSeguimiento}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Primary}" />

                                            <Border Grid.Row="0" Grid.Column="1"
                                                    BackgroundColor="#EFF6FF"
                                                    Stroke="Transparent"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="8,2">
                                                <Label Text="{Binding CantidadBultos, StringFormat='{0} bulto(s)'}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#1D4ED8" />
                                            </Border>

                                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding NombreDestinatario}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource TextSecondary}" />

                                            <Label Grid.Row="2" Grid.Column="0"
                                                   Text="{Binding DireccionDestino}"
                                                   Style="{StaticResource CaptionLabel}" />

                                            <Label Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding PesoTotal, StringFormat='{0:F1} kg'}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextMuted}"
                                                   HorizontalOptions="End" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- DETALLE Y CONTRASTE DEL ENVÍO SELECCIONADO                -->
                <!-- ========================================================= -->
                <VerticalStackLayout IsVisible="{Binding TieneEnvioSeleccionado}" Spacing="{DynamicResource EspaciadoSecciones}">

                    <!-- Tarjeta de Resumen del Envío Activo -->
                    <Border Style="{StaticResource CardView}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding EnvioSeleccionado.CodigoSeguimiento}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}" />

                                <Button Grid.Column="1"
                                        Text="Cambiar Envío"
                                        Command="{Binding LimpiarEnvioSeleccionadoCommand}"
                                        BackgroundColor="#F1F5F9"
                                        TextColor="#334155"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="32"
                                        Padding="10,0"
                                        CornerRadius="6" />
                            </Grid>

                            <Label Text="{Binding EnvioSeleccionado.NombreDestinatario, StringFormat='Destinatario: {0}'}"
                                   FontAttributes="Bold"
                                   FontSize="13" />

                            <Label Text="{Binding EnvioSeleccionado.DireccionDestino, StringFormat='Dirección: {0}'}"
                                   Style="{StaticResource CaptionLabel}" />

                            <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,4" />

                            <!-- Barra y Texto de Progreso de Verificación -->
                            <FlexLayout Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="SpaceBetween"
                                        AlignItems="Center">
                                <Label Text="Progreso de Recepción" Style="{StaticResource H3Label}" />
                                <Label Text="{Binding ResumenProgresoTexto}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </FlexLayout>

                            <ProgressBar Progress="{Binding ProgresoRecepcion}"
                                         ProgressColor="{StaticResource Primary}"
                                         HeightRequest="8" />

                            <!-- Botón Escaneo Cámara para el envío actual -->
                            <Button Text="Escanear Bulto con Cámara"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding EscanearConCamaraCommand}"
                                    HeightRequest="46"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Margin="0,4,0,0" />

                            <!-- Input Manual de Bulto -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                <Border Grid.Column="0"
                                        Stroke="{StaticResource InputBorder}"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12,0"
                                        HeightRequest="44"
                                        BackgroundColor="{StaticResource InputBackground}">
                                    <Entry Text="{Binding CodigoEscaneoInput, Mode=TwoWay}"
                                           Placeholder="Código del bulto"
                                           PlaceholderColor="{StaticResource TextMuted}"
                                           TextColor="{StaticResource TextPrimary}"
                                           ReturnCommand="{Binding ValidarCodigoManualCommand}"
                                           ClearButtonVisibility="WhileEditing"
                                           VerticalOptions="Center" />
                                </Border>
                                <Button Grid.Column="1"
                                        Text="Validar"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ValidarCodigoManualCommand}"
                                        HeightRequest="44"
                                        Padding="16,0"
                                        FontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de Bultos Declarados para el Envío -->
                    <Border Style="{StaticResource CardView}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Bultos Declarados por el Comercio" Style="{StaticResource H3Label}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding BultosDeclarados}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BultoRecepcionItemViewModel">
                                        <Border BackgroundColor="{Binding CardBgColor}"
                                                Stroke="{Binding CardBorderColor}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="12">
                                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                                                <Label Grid.Row="0" Grid.Column="0"
                                                       Text="{Binding Identificacion}"
                                                       FontAttributes="Bold"
                                                       FontSize="14"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       VerticalOptions="Center" />

                                                <Border Grid.Row="0" Grid.Column="1"
                                                        BackgroundColor="{Binding BadgeColor}"
                                                        Stroke="Transparent"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="8,3"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding EstadoTexto}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding BadgeTextColor}" />
                                                </Border>

                                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8">
                                                    <Label Text="{Binding Peso, StringFormat='Peso: {0:F1} kg'}"
                                                           Style="{StaticResource CaptionLabel}" />
                                                    <Label Text="{Binding Alto, StringFormat='· Alto: {0:F0} cm'}"
                                                           Style="{StaticResource CaptionLabel}" />
                                                    <Label Text="{Binding Ancho, StringFormat='· Ancho: {0:F0} cm'}"
                                                           Style="{StaticResource CaptionLabel}" />
                                                </HorizontalStackLayout>

                                                <!-- Botón para alternar daño -->
                                                <Button Grid.Row="1" Grid.Column="1"
                                                        Text="{Binding TextoBotonDanado}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecepcionDepositoViewModel}}, Path=AlternarDanadoBultoCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{Binding FondoBotonDanado}"
                                                        TextColor="{Binding TextoColorBotonDanado}"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        HeightRequest="30"
                                                        Padding="8,0"
                                                        CornerRadius="6" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de Bultos Sobrantes Detectados -->
                    <Border Style="{StaticResource CardView}" IsVisible="{Binding TieneSobrantes}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Bultos Sobrantes Detectados" Style="{StaticResource H3Label}" TextColor="{StaticResource Danger}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding BultosSobrantes}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border BackgroundColor="#FEF2F2"
                                                Stroke="#FCA5A5"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="10,6">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Text="{Binding .}" FontAttributes="Bold" FontSize="13" TextColor="#7F1D1D" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="Sobrante" FontSize="11" FontAttributes="Bold" TextColor="#B91C1C" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Panel de Registro de Discrepancias -->
                    <Border Style="{StaticResource CardView}" IsVisible="{Binding ModoDiscrepanciaActivo}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Registro Documental de Discrepancia"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="#92400E" />

                            <Label Text="Tipo de Discrepancia" Style="{StaticResource CaptionLabel}" />
                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#FFFFFF"
                                    Padding="10,0"
                                    HeightRequest="44">
                                <Picker SelectedItem="{Binding TipoDiscrepancia}"
                                        Title="Seleccione el tipo de discrepancia">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Faltante</x:String>
                                            <x:String>Sobrante</x:String>
                                            <x:String>Bulto Dañado</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>

                            <Label Text="Observaciones Documentales (Obligatorio con discrepancia)" Style="{StaticResource CaptionLabel}" />
                            <Border Stroke="{StaticResource InputBorder}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#FFFFFF"
                                    Padding="10"
                                    HeightRequest="80">
                                <Editor Text="{Binding ObservacionesDiscrepancia, Mode=TwoWay}"
                                        Placeholder="Detalle documental de la discrepancia para auditoría..."
                                        PlaceholderColor="{StaticResource TextMuted}"
                                        FontSize="12" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Botón para abrir sección de discrepancias si aún no está activa -->
                    <Button Text="Reportar Discrepancia / Daño"
                            Command="{Binding ActivarModoDiscrepanciaCommand}"
                            IsVisible="{Binding ModoNormalActivo}"
                            BackgroundColor="#FEF3C7"
                            TextColor="#92400E"
                            FontSize="12"
                            FontAttributes="Bold"
                            HeightRequest="40"
                            CornerRadius="8" />

                    <!-- ========================================================= -->
                    <!-- BOTONES DE CONFIRMACIÓN DE RECEPCIÓN                      -->
                    <!-- ========================================================= -->
                    <VerticalStackLayout Spacing="10" Margin="0,6,0,24">
                        <!-- Confirmar Sin Discrepancia -->
                        <Button Text="Confirmar Recepción en Depósito"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding ConfirmarRecepcionCommand}"
                                IsEnabled="{Binding PuedeConfirmarSinDiscrepancia}"
                                IsVisible="{Binding ModoNormalActivo}"
                                HeightRequest="52"
                                FontSize="14" />

                        <!-- Confirmar Con Discrepancia -->
                        <Button Text="Confirmar Recepción con Discrepancia"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmarRecepcionConDiscrepanciaCommand}"
                                IsEnabled="{Binding PuedeConfirmarConDiscrepancia}"
                                IsVisible="{Binding ModoDiscrepanciaActivo}"
                                BackgroundColor="#D97706"
                                HeightRequest="52"
                                FontSize="14" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
