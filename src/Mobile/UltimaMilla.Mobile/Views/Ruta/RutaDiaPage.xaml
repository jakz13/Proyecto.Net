<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Ruta"
             xmlns:controls="clr-namespace:UltimaMilla.Mobile.Controls"
             x:Class="UltimaMilla.Mobile.Views.Ruta.RutaDiaPage"
             x:DataType="vm:RutaDiaViewModel"
             Title="Mi Ruta"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto, *">

        <!-- ========================================================= -->
        <!-- CABECERA: TÍTULO, BADGE INTERACTIVO Y BARRA DE PROGRESO   -->
        <!-- ========================================================= -->
        <Border Grid.Row="0"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="0,0,0,1"
                StrokeShape="Rectangle"
                BackgroundColor="{StaticResource CardBackground}"
                Padding="{DynamicResource PaddingCabeceraRuta}">

            <VerticalStackLayout Spacing="12">
                <!-- Banner Informativo: Ruta en precarga (Liberada) -->
                <Border IsVisible="{Binding RecorridoNoIniciado}"
                        BackgroundColor="#FEF3C7"
                        Stroke="#F59E0B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,10"
                        Margin="0,0,0,2">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#D97706" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Pendiente de Carga en Depósito: La hoja de ruta está en estado Liberada. Escanee y confirme los bultos en la pestaña Carga para pasar los envíos a En Tránsito."
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#92400E"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Selector de Hojas de Ruta del Repartidor (múltiples rutas del día) -->
                <Border IsVisible="{Binding TieneMultiplesRutas}"
                        BackgroundColor="#F8FAFC"
                        Stroke="#CBD5E1"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,6"
                        Margin="0,0,0,2">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="Ruta activa:"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#334155"
                               VerticalOptions="Center" />
                        <Picker Grid.Column="1"
                                ItemsSource="{Binding HojasDeRutaDisponibles}"
                                ItemDisplayBinding="{Binding TituloSelector}"
                                SelectedItem="{Binding HojaDeRutaSeleccionada}"
                                FontSize="12"
                                TextColor="#0F172A"
                                Title="Seleccionar Ruta"
                                VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="Actualizar"
                                Command="{Binding ActualizarRutasServidorCommand}"
                                BackgroundColor="#0F172A"
                                TextColor="White"
                                FontSize="11"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                HeightRequest="32"
                                Padding="8,0" />
                    </Grid>
                </Border>

                <!-- Fila Superior: Título institucional y badges.
                     FlexLayout con Wrap: si los badges no entran al lado del título (pantallas angostas)
                     bajan a la línea siguiente en vez de aplastar el texto. -->
                <FlexLayout Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="SpaceBetween"
                            AlignItems="Center"
                            AlignContent="Start">
                    <VerticalStackLayout Spacing="2" Margin="0,0,8,4">
                        <Label Text="Hoja de Ruta"
                               Style="{StaticResource H2Label}" />

                        <Label Text="{Binding FechaHojaRuta, StringFormat='Fecha de operaciones: {0}'}"
                               Style="{StaticResource CaptionLabel}"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- Indicadores Flotantes Interactivos: GPS en Vivo y Conectividad -->
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,0,0,4">
                        <!-- Badge GPS en Vivo / SignalR -->
                        <Border BackgroundColor="{Binding TrackingBadgeBgColor}"
                                Stroke="{Binding TrackingBadgeBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="10,5"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AlternarTrackingGpsCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView WidthRequest="8"
                                         HeightRequest="8"
                                         CornerRadius="4"
                                         Color="{Binding TrackingDotColor}"
                                         VerticalOptions="Center" />
                                <Label Text="{Binding EstadoTrackingTexto}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{Binding TrackingBadgeTextColor}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Modo Offline / En Línea -->
                        <Border BackgroundColor="{Binding BadgeConectividadBgColor}"
                                Stroke="{Binding BadgeConectividadBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="10,5"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding MostrarColaOfflineCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView WidthRequest="8"
                                         HeightRequest="8"
                                         CornerRadius="4"
                                         Color="{Binding IndicadorConexionDotColor}"
                                         VerticalOptions="Center" />
                                <Label Text="{Binding TextoBadgeConectividad}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{Binding BadgeConectividadTextColor}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Botón Cerrar Sesión -->
                        <Border BackgroundColor="#F1F5F9"
                                Stroke="#CBD5E1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="10,5"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CerrarSesionCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Cerrar Sesión"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#334155"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </FlexLayout>

                <!-- Barra de Progreso Dinámica -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="{Binding ResumenProgresoTexto}"
                               Style="{StaticResource CaptionLabel}"
                               FontAttributes="Bold" />

                        <Label Grid.Column="1"
                               Text="{Binding ProgresoPorcentajeTexto}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </Grid>

                    <ProgressBar x:Name="RutaProgressBar"
                                 Progress="{Binding ProgresoRuta}"
                                 ProgressColor="{StaticResource Primary}"
                                 HeightRequest="8" />
                </VerticalStackLayout>

                <!-- Acción Operativa: Optimización del Orden de Paradas (Vecino Más Cercano + 2-Opt) -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Optimizar Ruta"
                            Command="{Binding OptimizarRutaCommand}"
                            BackgroundColor="#0F172A"
                            TextColor="White"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="38"
                            Padding="12,0" />

                    <Button Grid.Column="1"
                            IsVisible="{Binding MostrarResumenOptimizacion}"
                            Text="Restaurar Orden Inicial"
                            Command="{Binding RestaurarOrdenEstandarCommand}"
                            BackgroundColor="#F1F5F9"
                            TextColor="#334155"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="38"
                            Padding="10,0" />
                </Grid>

                <!-- Tarjeta de Resumen Comparativo de Optimización de Ruta -->
                <Border IsVisible="{Binding MostrarResumenOptimizacion}"
                        BackgroundColor="#F8FAFC"
                        Stroke="#93C5FD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Resumen de Optimización de Ruta"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="Ocultar"
                                    Command="{Binding OcultarResumenOptimizacionCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#64748B"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    HeightRequest="26"
                                    Padding="4,0" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#CBD5E1" />

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Criterio Estándar de Despacho:"
                                   FontSize="12"
                                   TextColor="#475569" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ResumenCriterioEstandarTexto}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="Ruta Optimizada (Heurística 2-Opt):"
                                   FontSize="12"
                                   TextColor="#1E40AF"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ResumenRutaOptimizadaTexto}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#1E40AF" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#CBD5E1" />

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Ahorro Medido en Recorrido:"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ResumenAhorroRecorridoTexto}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="Tiempo Estimado Reducido:"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ResumenTiempoReducidoTexto}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />
                        </Grid>

                        <Label Text="{Binding ResumenSecuenciaAplicadaTexto, StringFormat='Secuencia aplicada: {0}'}"
                               FontSize="11"
                               TextColor="#475569"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ========================================================= -->
        <!-- CONTENIDO PRINCIPAL: PARADAS Y ESTADO DE RUTAS           -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1">
            <!-- Estado Vacío: Sin Ruta Asignada o Todas Finalizadas -->
            <ScrollView IsVisible="{Binding SinRutaAsignada}">
                <VerticalStackLayout Spacing="16"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Padding="24">
                    <Border Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#F8FAFC"
                            Padding="24"
                            MaximumWidthRequest="400">
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Label Text="Hoja de ruta finalizada. No posee nuevas rutas asignadas por el momento."
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Las entregas y retornos de su última hoja de ruta han sido completados y rendidos en depósito. Si la central le asigna un nuevo viaje, toque el botón a continuación para sincronizar."
                                   FontSize="12"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Buscar Nueva Ruta Asignada"
                                    Command="{Binding ActualizarRutasServidorCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HeightRequest="46"
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- LISTA DE PARADAS (DENTRO DE REFRESHVIEW CON HIJO SCROLLABLE ÚNICO DIRECTO) -->
            <RefreshView IsVisible="{Binding HayRutaAsignada}"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding ActualizarRutasServidorCommand}">
                <CollectionView ItemsSource="{Binding Paradas}"
                                SelectionMode="None"
                                Margin="{DynamicResource MargenListaParadas}">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ParadaItemViewModel">
                    <Border Style="{StaticResource CardView}"
                            Margin="0,0,0,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=IrAParadaCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <!-- Fila 1: Secuencia de Parada, Dirección y Badge de Estado -->
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        BackgroundColor="#EFF6FF"
                                        Stroke="#BFDBFE"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Orden, StringFormat='Parada {0}'}"
                                               TextColor="{StaticResource Primary}"
                                               FontAttributes="Bold"
                                               FontSize="12" />
                                        <Label Text="{Binding TipoTexto}"
                                               TextColor="{StaticResource Primary}"
                                               FontAttributes="Bold"
                                               FontSize="11" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding Direccion}"
                                       Style="{StaticResource H3Label}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       VerticalOptions="Center" />

                                <Border Grid.Column="2"
                                        BackgroundColor="{Binding EstadoBgColor}"
                                        Stroke="{Binding EstadoBorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding EstadoTextoBadge}"
                                           TextColor="{Binding EstadoTextColor}"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <!-- Fila 2: Metadatos Estructurados (Zona, Geocerca/Distancia, Destinatario, Bultos, Horario) -->
                            <VerticalStackLayout Spacing="6">
                                <FlexLayout Wrap="Wrap"
                                            Direction="Row"
                                            JustifyContent="SpaceBetween"
                                            AlignItems="Center">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Margin="0,0,8,2">
                                        <Label Text="Zona:"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="{Binding Ciudad}"
                                               Style="{StaticResource CaptionLabel}" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Border IsVisible="{Binding MostrarBadgeGeocerca}"
                                                BackgroundColor="{Binding GeocercaBgColor}"
                                                Stroke="{Binding GeocercaBorderColor}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding GeocercaTextoBadge}"
                                                   TextColor="{Binding GeocercaTextColor}"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />
                                        </Border>

                                        <Label IsVisible="{Binding MostrarDistanciaGeocerca}"
                                               Text="{Binding DistanciaFormateadaTexto}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextSecondary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </FlexLayout>

                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0,2,0,0">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="Destinatario"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding Destinatario}"
                                               Style="{StaticResource CaptionLabel}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Carga"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding CantidadBultos, StringFormat='{0} bultos'}"
                                               Style="{StaticResource CaptionLabel}"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="1">
                                        <Label Text="Horario"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding HoraEstimada, StringFormat='{0} hs'}"
                                               Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Divisor Estructural Sutil -->
                            <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,2" />

                            <!-- Fila 3: Accesos Rápidos Ergonómicos -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="Navegar"
                                        Style="{StaticResource QuickMapButton}"
                                        HorizontalOptions="Fill"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=NavegarAParadaCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="1"
                                        Text="Ver Detalle"
                                        Style="{StaticResource SmallActionButton}"
                                        HorizontalOptions="Fill"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=IrAParadaCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <VerticalStackLayout Spacing="12" Padding="0,10,0,30">
                            <!-- Botón Prominente de Finalizar / Rendir Hoja de Ruta -->
                            <Button Text="Finalizar Hoja de Ruta (Retorno a Depósito)"
                                    Command="{Binding FinalizarHojaDeRutaCommand}"
                                    BackgroundColor="#15803D"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HeightRequest="50"
                                    CornerRadius="10"
                                    IsVisible="{Binding PuedeFinalizarRuta}" />

                            <Button Text="Actualizar Rutas con Servidor"
                                    Command="{Binding ActualizarRutasServidorCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#334155"
                                    BorderColor="#CBD5E1"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="42"
                                    CornerRadius="8" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>

    </Grid>

</ContentPage>
