<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Ruta"
             x:Class="UltimaMilla.Mobile.Views.Ruta.RutaDiaPage"
             x:DataType="vm:RutaDiaViewModel"
             Title="Mi Ruta"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto, *">

        <!-- ========================================================= -->
        <!-- CABECERA: TÍTULO, BADGE INTERACTIVO Y BARRA DE PROGRESO   -->
        <!-- ========================================================= -->
        <Border Grid.Row="0"
                Stroke="{StaticResource CardBorder}"
                StrokeThickness="0,0,0,1"
                StrokeShape="Rectangle"
                BackgroundColor="{StaticResource CardBackground}"
                Padding="20,16">

            <VerticalStackLayout Spacing="12">
                <!-- Fila Superior: Título institucional y Modo Offline -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Hoja de Ruta"
                               Style="{StaticResource H2Label}" />

                        <Label Text="{Binding FechaHojaRuta, StringFormat='Fecha de operaciones: {0}'}"
                               Style="{StaticResource CaptionLabel}"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <!-- Indicador Flotante Interactivo: Modo Offline / En Línea -->
                    <Border Grid.Column="1"
                            BackgroundColor="{Binding BadgeConectividadBgColor}"
                            Stroke="{Binding BadgeConectividadBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="10,5"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MostrarColaOfflineCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView WidthRequest="8"
                                     HeightRequest="8"
                                     CornerRadius="4"
                                     Color="{Binding IndicadorConexionDotColor}"
                                     VerticalOptions="Center" />
                            <Label Text="{Binding TextoBadgeConectividad}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{Binding BadgeConectividadTextColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Barra de Progreso Dinámica -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="{Binding ResumenProgresoTexto}"
                               Style="{StaticResource CaptionLabel}"
                               FontAttributes="Bold" />

                        <Label Grid.Column="1"
                               Text="{Binding ProgresoPorcentajeTexto}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </Grid>

                    <ProgressBar x:Name="RutaProgressBar"
                                 Progress="{Binding ProgresoRuta}"
                                 ProgressColor="{StaticResource Primary}"
                                 HeightRequest="8" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- ========================================================= -->
        <!-- LISTA DE PARADAS (TARJETAS CORPORATIVAS Y ERGONÓMICAS)    -->
        <!-- ========================================================= -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Paradas}"
                        SelectionMode="None"
                        Margin="16,12,16,16">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ParadaItemViewModel">
                    <Border Style="{StaticResource CardView}"
                            Margin="0,0,0,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=IrAParadaCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="10">

                            <!-- Fila 1: Secuencia de Parada, Dirección y Badge de Estado -->
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        BackgroundColor="#EFF6FF"
                                        Stroke="#BFDBFE"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Orden, StringFormat='Parada {0}'}"
                                           TextColor="{StaticResource Primary}"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding Direccion}"
                                       Style="{StaticResource H3Label}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center" />

                                <Border Grid.Column="2"
                                        BackgroundColor="{Binding EstadoBgColor}"
                                        Stroke="{Binding EstadoBorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding EstadoTextoBadge}"
                                           TextColor="{Binding EstadoTextColor}"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                </Border>
                            </Grid>

                            <!-- Fila 2: Metadatos Estructurados (Zona, Destinatario, Bultos, Horario) -->
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="Zona:"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Label Text="{Binding Ciudad}"
                                           Style="{StaticResource CaptionLabel}" />
                                </HorizontalStackLayout>

                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="16" Margin="0,2,0,0">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="Destinatario"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding Destinatario}"
                                               Style="{StaticResource CaptionLabel}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Carga"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding CantidadBultos, StringFormat='{0} bultos'}"
                                               Style="{StaticResource CaptionLabel}"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="1">
                                        <Label Text="Horario"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding HoraEstimada, StringFormat='{0} hs'}"
                                               Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Divisor Estructural Sutil -->
                            <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,2" />

                            <!-- Fila 3: Accesos Rápidos Ergonómicos -->
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Text="Llamar"
                                        Style="{StaticResource QuickCallButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=LlamarClienteCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="1"
                                        Text="Navegar"
                                        Style="{StaticResource QuickMapButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=NavegarAParadaCommand}"
                                        CommandParameter="{Binding .}" />

                                <BoxView Grid.Column="2" Color="Transparent" />

                                <Button Grid.Column="3"
                                        Text="Ver Detalle"
                                        Style="{StaticResource SmallActionButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=IrAParadaCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
