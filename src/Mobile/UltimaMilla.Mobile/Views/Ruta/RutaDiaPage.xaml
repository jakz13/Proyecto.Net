<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Ruta"
             xmlns:controls="clr-namespace:UltimaMilla.Mobile.Controls"
             xmlns:components="clr-namespace:UltimaMilla.Mobile.Views.Components"
             x:Class="UltimaMilla.Mobile.Views.Ruta.RutaDiaPage"
             x:DataType="vm:RutaDiaViewModel"
             Title="Mi Ruta"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource PageBackground}">

    <Shell.TitleView>
        <components:CorporateTitleView />
    </Shell.TitleView>

    <Grid RowDefinitions="2, Auto, *">

        <!-- Línea de acento inferior de la cabecera estilo Backoffice -->
        <BoxView Grid.Row="0" HeightRequest="2" Color="{DynamicResource SecondaryColor}" />

        <!-- ========================================================= -->
        <!-- CABECERA OPERATIVA: KPIs, PROGRESO Y TELEMETRÍA GPS       -->
        <!-- ========================================================= -->
        <Border Grid.Row="1"
                Stroke="{DynamicResource CardBorderColor}"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                BackgroundColor="#FFFFFF"
                Padding="16,12">

            <VerticalStackLayout Spacing="10">

                <!-- Banner Informativo: Ruta en precarga (Liberada) -->
                <Border IsVisible="{Binding RecorridoNoIniciado}"
                        BackgroundColor="#FEF3C7"
                        Stroke="#F59E0B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8">
                    <Grid ColumnDefinitions="4, *" ColumnSpacing="8" VerticalOptions="Center">
                        <BoxView WidthRequest="4" CornerRadius="2" Color="#D97706" VerticalOptions="Fill" />
                        <Label Grid.Column="1"
                               Text="Pendiente de Carga en Deposito: La hoja de ruta esta en estado Liberada. Escanee y confirme los bultos en la pestana Carga para pasar los envios a En Transito."
                               FontSize="11.5"
                               FontAttributes="Bold"
                               TextColor="#92400E"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Selector de Hojas de Ruta del Repartidor (múltiples rutas del día) -->
                <Border IsVisible="{Binding TieneMultiplesRutas}"
                        BackgroundColor="#F8FAFC"
                        Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,6">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="RUTA ACTIVA:"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#475569"
                               VerticalOptions="Center" />
                        <Picker Grid.Column="1"
                                ItemsSource="{Binding HojasDeRutaDisponibles}"
                                ItemDisplayBinding="{Binding TituloSelector}"
                                SelectedItem="{Binding HojaDeRutaSeleccionada}"
                                FontSize="12"
                                TextColor="#0F172A"
                                Title="Seleccionar Ruta"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Fila de Título de Sección y Botones Herramientas / Sincronizar -->
                <FlexLayout Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="SpaceBetween"
                            AlignItems="Center"
                            AlignContent="Start">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,0,8,4">
                        <BoxView WidthRequest="4"
                                 HeightRequest="20"
                                 CornerRadius="2"
                                 Color="{DynamicResource SecondaryColor}"
                                 VerticalOptions="Center" />
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Hoja de Ruta Operativa"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="{Binding FechaHojaRuta, StringFormat='Jornada: {0}'}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,0,0,4">
                        <!-- Menú de Opciones y Telemetría Corporativo -->
                        <Button Text="Herramientas y Telemetria ▾"
                                Command="{Binding AlternarMenuHerramientasCommand}"
                                BackgroundColor="{DynamicResource SecondarySoftBackground}"
                                TextColor="{DynamicResource SecondaryColor}"
                                BorderColor="{DynamicResource SecondaryColor}"
                                BorderWidth="1.2"
                                FontSize="11"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="32"
                                MinimumHeightRequest="30"
                                Padding="10,0"
                                VerticalOptions="Center" />

                        <!-- Acción Unificada de Sincronización -->
                        <Button Text="Sincronizar"
                                Command="{Binding ActualizarRutasServidorCommand}"
                                BackgroundColor="{DynamicResource SecondaryColor}"
                                TextColor="#FFFFFF"
                                FontSize="11"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="32"
                                MinimumHeightRequest="30"
                                Padding="12,0"
                                VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </FlexLayout>

                <!-- Tarjetas KPI de Resumen (Estilo _TarjetaMetrica.cshtml del Backoffice) -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <!-- KPI 1: Total Paradas -->
                    <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                        <Grid ColumnDefinitions="4, *" Padding="0,8,8,8" ColumnSpacing="8">
                            <BoxView Grid.Column="0" WidthRequest="4" Color="{DynamicResource PrimaryColor}" VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="TOTAL PARADAS"
                                       FontSize="9.5"
                                       FontAttributes="Bold"
                                       TextColor="#64748B" />
                                <Label Text="{Binding TotalParadasCount}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- KPI 2: Pendientes -->
                    <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                        <Grid ColumnDefinitions="4, *" Padding="0,8,8,8" ColumnSpacing="8">
                            <BoxView Grid.Column="0" WidthRequest="4" Color="{DynamicResource SecondaryColor}" VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="PENDIENTES"
                                       FontSize="9.5"
                                       FontAttributes="Bold"
                                       TextColor="#64748B" />
                                <Label Text="{Binding ParadasPendientesCount}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource SecondaryColor}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- KPI 3: Completadas -->
                    <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                        <Grid ColumnDefinitions="4, *" Padding="0,8,8,8" ColumnSpacing="8">
                            <BoxView Grid.Column="0" WidthRequest="4" Color="#16A34A" VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="COMPLETADAS"
                                       FontSize="9.5"
                                       FontAttributes="Bold"
                                       TextColor="#64748B" />
                                <Label Text="{Binding ParadasCompletadasCount}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#15803D" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Barra de Progreso Dinámica -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="{Binding ResumenProgresoTexto}"
                               FontSize="11.5"
                               FontAttributes="Bold"
                               TextColor="#475569" />

                        <Label Grid.Column="1"
                               Text="{Binding ProgresoPorcentajeTexto}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource PrimaryColor}" />
                    </Grid>

                    <ProgressBar x:Name="RutaProgressBar"
                                 Progress="{Binding ProgresoRuta}"
                                 ProgressColor="{DynamicResource SecondaryColor}"
                                 HeightRequest="8" />
                </VerticalStackLayout>

                <!-- Panel de Telemetría GPS en Vivo con Acento Lateral en SecondaryColor -->
                <Border BackgroundColor="#F8FAFC"
                        Stroke="{DynamicResource CardBorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Grid ColumnDefinitions="4, *, Auto" ColumnSpacing="8" Padding="0,7,8,7">
                        <BoxView Grid.Column="0" WidthRequest="4" Color="{DynamicResource SecondaryColor}" VerticalOptions="Fill" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding UltimaCoordenadaTexto}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="{Binding UltimoEstadoServidorTexto}"
                                   FontSize="10.5"
                                   TextColor="#475569" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="Forzar Envio GPS Ahora"
                                Command="{Binding ForzarEnvioGpsAhoraCommand}"
                                BackgroundColor="{DynamicResource SecondaryColor}"
                                TextColor="#FFFFFF"
                                FontSize="10.5"
                                FontAttributes="Bold"
                                CornerRadius="6"
                                HeightRequest="32"
                                MinimumHeightRequest="30"
                                Padding="9,0"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Acción Operativa: Optimización del Orden de Paradas -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Optimizar Ruta"
                            Command="{Binding OptimizarRutaCommand}"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            TextColor="#FFFFFF"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="36"
                            MinimumHeightRequest="34"
                            Padding="12,0" />

                    <Button Grid.Column="1"
                            IsVisible="{Binding MostrarResumenOptimizacion}"
                            Text="Restaurar Orden Inicial"
                            Command="{Binding RestaurarOrdenEstandarCommand}"
                            BackgroundColor="{DynamicResource SecondarySoftBackground}"
                            TextColor="{DynamicResource SecondaryColor}"
                            BorderColor="{DynamicResource SecondaryColor}"
                            BorderWidth="1.5"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="36"
                            MinimumHeightRequest="34"
                            Padding="10,0" />
                </Grid>

                <!-- Tarjeta de Resumen Comparativo de Optimización de Ruta -->
                <Border IsVisible="{Binding MostrarResumenOptimizacion}"
                        BackgroundColor="#F8FAFC"
                        Stroke="{DynamicResource PrimaryColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Resumen de Optimizacion de Ruta"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="Ocultar"
                                    Command="{Binding OcultarResumenOptimizacionCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#64748B"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    HeightRequest="26"
                                    MinimumHeightRequest="24"
                                    Padding="4,0" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#CBD5E1" />

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Criterio Estandar de Despacho:"
                                   FontSize="11.5"
                                   TextColor="#475569" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ResumenCriterioEstandarTexto}"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="Ruta Optimizada (Heuristica 2-Opt):"
                                   FontSize="11.5"
                                   TextColor="{DynamicResource PrimaryColor}"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ResumenRutaOptimizadaTexto}"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryColor}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#CBD5E1" />

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Ahorro Medido en Recorrido:"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ResumenAhorroRecorridoTexto}"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="Tiempo Estimado Reducido:"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ResumenTiempoReducidoTexto}"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#15803D" />
                        </Grid>

                        <Label Text="{Binding ResumenSecuenciaAplicadaTexto, StringFormat='Secuencia aplicada: {0}'}"
                               FontSize="11"
                               TextColor="#475569"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ========================================================= -->
        <!-- CONTENIDO PRINCIPAL: PARADAS Y ESTADO DE RUTAS           -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2">
            <!-- Estado Vacío: Sin Ruta Asignada o Todas Finalizadas -->
            <ScrollView IsVisible="{Binding SinRutaAsignada}">
                <VerticalStackLayout Spacing="16"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Padding="20">
                    <Border Stroke="{DynamicResource CardBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#FFFFFF"
                            Padding="24"
                            MaximumWidthRequest="400">
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="Hoja de ruta finalizada. No posee nuevas rutas asignadas por el momento."
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Las entregas y retornos de su ultima hoja de ruta han sido completados y rendidos en deposito. Si la central le asigna un nuevo viaje, toque el boton a continuacion para sincronizar."
                                   FontSize="12"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Buscar Nueva Ruta Asignada"
                                    Command="{Binding ActualizarRutasServidorCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    CornerRadius="8"
                                    HeightRequest="46"
                                    Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- LISTA DE PARADAS (ESTILO PANEL-ESTANDAR DEL BACKOFFICE) -->
            <RefreshView IsVisible="{Binding HayRutaAsignada}"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding ActualizarRutasServidorCommand}">
                <CollectionView ItemsSource="{Binding Paradas}"
                                SelectionMode="None"
                                Margin="14,12,14,16">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParadaItemViewModel">
                            <Border Style="{StaticResource CardView}"
                                    Padding="0"
                                    Margin="0,0,0,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=IrAParadaCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="0">
                                    <!-- Cabecera de la Tarjeta estilo .panel-estandar-header del Backoffice -->
                                    <Border StrokeThickness="0"
                                            StrokeShape="Rectangle"
                                            BackgroundColor="#F8FAFC"
                                            Padding="12,9">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <!-- Badge de Orden y Tipo con SecondaryColor -->
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{DynamicResource SecondarySoftBackground}"
                                                    Stroke="{DynamicResource SecondaryColor}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="8,3"
                                                    VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="5">
                                                    <Label Text="{Binding Orden, StringFormat='PARADA #{0}'}"
                                                           TextColor="{DynamicResource SecondaryColor}"
                                                           FontAttributes="Bold"
                                                           FontSize="10.5" />
                                                    <Label Text="{Binding TipoTexto}"
                                                           TextColor="{DynamicResource PrimaryColor}"
                                                           FontAttributes="Bold"
                                                           FontSize="10" />
                                                </HorizontalStackLayout>
                                            </Border>

                                            <!-- Código de Seguimiento -->
                                            <Label Grid.Column="1"
                                                   Text="{Binding CodigoSeguimiento}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource PrimaryColor}"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />

                                            <!-- Badge de Estado Unificado -->
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{Binding EstadoBgColor}"
                                                    Stroke="{Binding EstadoBorderColor}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="9,3"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding EstadoTextoBadge}"
                                                       TextColor="{Binding EstadoTextColor}"
                                                       FontSize="10.5"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                                    <!-- Cuerpo de la Tarjeta -->
                                    <VerticalStackLayout Spacing="8" Padding="14,12">
                                        <Label Text="{Binding Direccion}"
                                               FontSize="15.5"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />

                                        <FlexLayout Wrap="Wrap"
                                                    Direction="Row"
                                                    JustifyContent="SpaceBetween"
                                                    AlignItems="Center">
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center" Margin="0,0,8,2">
                                                <Label Text="ZONA:"
                                                       FontSize="10.5"
                                                       FontAttributes="Bold"
                                                       TextColor="#64748B" />
                                                <Label Text="{Binding Ciudad}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#334155" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Border IsVisible="{Binding MostrarBadgeGeocerca}"
                                                        BackgroundColor="{Binding GeocercaBgColor}"
                                                        Stroke="{Binding GeocercaBorderColor}"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="8,2"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding GeocercaTextoBadge}"
                                                           TextColor="{Binding GeocercaTextColor}"
                                                           FontSize="10.5"
                                                           FontAttributes="Bold" />
                                                </Border>

                                                <Label IsVisible="{Binding MostrarDistanciaGeocerca}"
                                                       Text="{Binding DistanciaFormateadaTexto}"
                                                       FontSize="10.5"
                                                       FontAttributes="Bold"
                                                       TextColor="#475569"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </FlexLayout>

                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="14" Margin="0,2,0,0">
                                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="DESTINATARIO"
                                                       FontSize="9.5"
                                                       FontAttributes="Bold"
                                                       TextColor="#64748B" />
                                                <Label Text="{Binding Destinatario}"
                                                       FontSize="12.5"
                                                       FontAttributes="Bold"
                                                       TextColor="#1E293B"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="BULTOS"
                                                       FontSize="9.5"
                                                       FontAttributes="Bold"
                                                       TextColor="#64748B" />
                                                <Label Text="{Binding CantidadBultos, StringFormat='{0} u.'}"
                                                       FontSize="12.5"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource SecondaryColor}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2" Spacing="1">
                                                <Label Text="ESTIMADO"
                                                       FontSize="9.5"
                                                       FontAttributes="Bold"
                                                       TextColor="#64748B" />
                                                <Label Text="{Binding HoraEstimada, StringFormat='{0} hs'}"
                                                       FontSize="12.5"
                                                       FontAttributes="Bold"
                                                       TextColor="#334155" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" Margin="0,2" />

                                        <!-- Pie de Acciones de la Tarjeta -->
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                            <Button Grid.Column="0"
                                                    Text="Navegar en Mapa"
                                                    BackgroundColor="{DynamicResource SecondarySoftBackground}"
                                                    TextColor="{DynamicResource SecondaryColor}"
                                                    BorderColor="{DynamicResource SecondaryColor}"
                                                    BorderWidth="1.2"
                                                    FontAttributes="Bold"
                                                    FontSize="12.5"
                                                    CornerRadius="8"
                                                    HeightRequest="38"
                                                    MinimumHeightRequest="36"
                                                    Padding="10,0"
                                                    HorizontalOptions="Fill"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=NavegarAParadaCommand}"
                                                    CommandParameter="{Binding .}" />

                                            <Button Grid.Column="1"
                                                    Text="Gestionar Parada"
                                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                                    TextColor="#FFFFFF"
                                                    FontAttributes="Bold"
                                                    FontSize="12.5"
                                                    CornerRadius="8"
                                                    HeightRequest="38"
                                                    MinimumHeightRequest="36"
                                                    Padding="10,0"
                                                    HorizontalOptions="Fill"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RutaDiaViewModel}}, Path=IrAParadaCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <VerticalStackLayout Spacing="10" Padding="0,8,0,28">
                            <!-- Botón Prominente de Finalizar / Rendir Hoja de Ruta -->
                            <Button Text="Finalizar Hoja de Ruta (Retorno a Deposito)"
                                    Command="{Binding FinalizarHojaDeRutaCommand}"
                                    BackgroundColor="#15803D"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    FontSize="13.5"
                                    HeightRequest="48"
                                    CornerRadius="8"
                                    IsVisible="{Binding PuedeFinalizarRuta}" />

                            <Button Text="Sincronizar Rutas e Identidad Visual"
                                    Command="{Binding ActualizarRutasServidorCommand}"
                                    BackgroundColor="{DynamicResource SecondarySoftBackground}"
                                    TextColor="{DynamicResource SecondaryColor}"
                                    BorderColor="{DynamicResource SecondaryColor}"
                                    BorderWidth="1.2"
                                    FontAttributes="Bold"
                                    FontSize="12.5"
                                    HeightRequest="42"
                                    CornerRadius="8" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- ========================================================= -->
        <!-- OVERLAY 1: MENÚ DESPLEGABLE "HERRAMIENTAS Y TELEMETRÍA"   -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="{Binding MostrarMenuHerramientas}"
              BackgroundColor="#66000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarModalesCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="#FFFFFF"
                    Stroke="{DynamicResource SecondaryColor}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Margin="18,48,18,20"
                    VerticalOptions="Start"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="400"
                    Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 14,14,0,0"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            Padding="16,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Herramientas y Telemetria"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Cerrar"
                                    Command="{Binding CerrarModalesCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#E2E8F0"
                                    FontSize="11.5"
                                    FontAttributes="Bold"
                                    HeightRequest="28"
                                    Padding="6,0"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="6" Padding="12,12">
                        <!-- Opción 1: Análisis de Batería -->
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirModalBateriaCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Analisis de Bateria"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="Muestreo adaptativo y consumo en jornada"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{DynamicResource SecondaryColor}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Opción 2: Estado de Rastreo GPS y Geocercas -->
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirModalGpsGeocercasCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Estado de Rastreo y Geocercas"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="Telemetria GPS e historial de eventos de parada"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{DynamicResource SecondaryColor}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Opción 3: Optimizar Orden 2-Opt -->
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EjecutarOptimizacionDesdeMenuCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Optimizar Orden (2-Opt)"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="Calculo heuristico de distancia y tiempo estimado"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{DynamicResource SecondaryColor}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Opción 4: Alternar Conexión Simulada -->
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AlternarModoOfflineDesdeMenuCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Modo Fuera de Linea"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="Alternar conexion simulada para operar con base local"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{DynamicResource SecondaryColor}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Opción 5: Rendir Hoja de Ruta -->
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RendirHojaDeRutaDesdeMenuCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Rendir Hoja de Ruta"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                    <Label Text="Informar retorno y llegada al deposito de origen"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{DynamicResource SecondaryColor}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- OVERLAY 2: MODAL 1 - ANÁLISIS DE BATERÍA Y MUESTREO       -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="{Binding MostrarModalBateria}"
              BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarModalesCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="#FFFFFF"
                    Stroke="{DynamicResource SecondaryColor}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Margin="18,30,18,30"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="420"
                    Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <ScrollView MaximumHeightRequest="560">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 14,14,0,0"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                Padding="16,12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Analisis de Bateria y Muestreo Adaptativo"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="✕"
                                        Command="{Binding CerrarModalesCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#FFFFFF"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        HeightRequest="30"
                                        WidthRequest="30"
                                        Padding="0" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="12" Padding="16,14">
                            <!-- Nivel y Estado de Batería -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding NivelBateriaPct, StringFormat='{0}%'}"
                                           FontSize="26"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"
                                           VerticalOptions="Center" />
                                    <Border BackgroundColor="{DynamicResource SecondarySoftBackground}"
                                            Stroke="{DynamicResource SecondaryColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,2"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding EstadoBateriaTexto}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource SecondaryColor}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding ConsumoEstimadoMahTexto}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#64748B"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Barra de Nivel de Batería -->
                            <ProgressBar Progress="{Binding NivelBateriaProgreso}"
                                         ProgressColor="{DynamicResource SecondaryColor}"
                                         HeightRequest="8" />

                            <!-- Grilla de Métricas Clave (2 Columnas) -->
                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="8" ColumnSpacing="8">
                                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="MODO DE MUESTREO" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding ModoMuestreoActualTexto}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="INTERVALO DINAMICO" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding IntervaloDinamicoSegundosTexto}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="AHORRO ENERGETICO" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding AhorroEnergeticoEstimadoTexto}" FontSize="12" FontAttributes="Bold" TextColor="#16A34A" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="LECTURAS EN JORNADA" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding LecturasGpsJornadaCount}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Tabla de Reglas de Muestreo Adaptativo -->
                            <Label Text="REGLAS DE MUESTREO ADAPTATIVO"
                                   FontSize="10.5"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   Margin="0,4,0,0" />

                            <VerticalStackLayout Spacing="6">
                                <!-- Regla 1: Batería > 50% -->
                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="{DynamicResource SecondaryColor}"
                                        StrokeThickness="1"
                                        BackgroundColor="#F8FAFC"
                                        Padding="10,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <BoxView WidthRequest="4" HeightRequest="24" CornerRadius="2" Color="{DynamicResource SecondaryColor}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="Bateria superior al 50%" FontSize="11.5" FontAttributes="Bold" TextColor="#0F172A" />
                                            <Label Text="Intervalo cada 15 s (Alta frecuencia)" FontSize="10.5" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding EsTramoBateriaAlto}"
                                                BackgroundColor="{DynamicResource SecondaryColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="6,2">
                                            <Label Text="ACTIVA" FontSize="9" FontAttributes="Bold" TextColor="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Regla 2: Batería 20% - 50% -->
                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="{DynamicResource SecondaryColor}"
                                        StrokeThickness="1"
                                        BackgroundColor="#F8FAFC"
                                        Padding="10,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <BoxView WidthRequest="4" HeightRequest="24" CornerRadius="2" Color="{DynamicResource PrimaryColor}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="Bateria entre 20% y 50%" FontSize="11.5" FontAttributes="Bold" TextColor="#0F172A" />
                                            <Label Text="Intervalo cada 45 s (Frecuencia media)" FontSize="10.5" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding EsTramoBateriaMedio}"
                                                BackgroundColor="{DynamicResource SecondaryColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="6,2">
                                            <Label Text="ACTIVA" FontSize="9" FontAttributes="Bold" TextColor="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Regla 3: Batería < 20% -->
                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="{DynamicResource SecondaryColor}"
                                        StrokeThickness="1"
                                        BackgroundColor="#F8FAFC"
                                        Padding="10,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <BoxView WidthRequest="4" HeightRequest="24" CornerRadius="2" Color="#DC2626" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="Bateria menor al 20%" FontSize="11.5" FontAttributes="Bold" TextColor="#0F172A" />
                                            <Label Text="Intervalo cada 120 s (Modo ahorro critico)" FontSize="10.5" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding EsTramoBateriaBajo}"
                                                BackgroundColor="{DynamicResource SecondaryColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="6,2">
                                            <Label Text="ACTIVA" FontSize="9" FontAttributes="Bold" TextColor="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Botón de Cierre -->
                            <Button Text="Cerrar Analisis"
                                    Command="{Binding CerrarModalesCommand}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HeightRequest="42"
                                    CornerRadius="8"
                                    Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- OVERLAY 3: MODAL 2 - ESTADO DE RASTREO GPS Y GEOCERCAS    -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="{Binding MostrarModalGpsGeocercas}"
              BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarModalesCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="#FFFFFF"
                    Stroke="{DynamicResource SecondaryColor}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Margin="18,24,18,24"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="420"
                    Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <ScrollView MaximumHeightRequest="580">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 14,14,0,0"
                                BackgroundColor="{DynamicResource PrimaryColor}"
                                Padding="16,12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Estado de Rastreo GPS y Geocercas"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="✕"
                                        Command="{Binding CerrarModalesCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#FFFFFF"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        HeightRequest="30"
                                        WidthRequest="30"
                                        Padding="0" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Spacing="12" Padding="16,14">
                            <!-- Badge de Estado de Transmisión -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Label Text="TRANSMISION EN TIEMPO REAL" FontSize="10" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding EstadoGpsBadgeBgColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="8,3">
                                    <Label Text="{Binding EstadoGpsBadgeTexto}"
                                           FontSize="10.5"
                                           FontAttributes="Bold"
                                           TextColor="{Binding EstadoGpsBadgeTextColor}" />
                                </Border>
                            </Grid>

                            <!-- Coordenadas, Precisión y Último Envío -->
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,10">
                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="8" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="ULTIMA COORDENADA" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding UltimaCoordenadaModalTexto}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="PRECISION ESTIMADA" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding PrecisionGpsModalTexto}" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                        <Label Text="HORA ULTIMO ENVIO AL SERVIDOR" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                        <Label Text="{Binding HoraUltimoEnvioTexto}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Indicadores de Histéresis de Geocercas -->
                            <Label Text="PARAMETROS DE HISTERESIS (DETECCION DE PARADA)"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   Margin="0,2,0,0" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="#F0FDF4" Stroke="#BBF7D0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="RADIO DE ENTRADA" FontSize="9" FontAttributes="Bold" TextColor="#166534" />
                                        <Label Text="{Binding RadioEntradaTexto}" FontSize="13" FontAttributes="Bold" TextColor="#15803D" />
                                        <Label Text="Dispara llegada a geocerca" FontSize="9.5" TextColor="#4B5563" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="RADIO DE SALIDA" FontSize="9" FontAttributes="Bold" TextColor="#1E40AF" />
                                        <Label Text="{Binding RadioSalidaTexto}" FontSize="13" FontAttributes="Bold" TextColor="#1D4ED8" />
                                        <Label Text="Evita falsos rebotes" FontSize="9.5" TextColor="#4B5563" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Historial de Transiciones de Geocerca -->
                            <Label Text="EVENTOS DE GEOCERCA REGISTRADOS HOY"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   Margin="0,4,0,0" />

                            <!-- Estado Vacío -->
                            <Border IsVisible="{Binding SinEventosGeocerca}"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="14,12">
                                <Label Text="Sin transiciones de geocerca registradas en esta jornada"
                                       FontSize="11.5"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                            </Border>

                            <!-- Lista de Eventos -->
                            <VerticalStackLayout IsVisible="{Binding TieneEventosGeocerca}" Spacing="6">
                                <BindableLayout.ItemsSource>
                                    <Binding Path="EventosGeocercaJornada" />
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventoGeocercaItemViewModel">
                                        <Border StrokeShape="RoundRectangle 6"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                BackgroundColor="#F8FAFC"
                                                Padding="10,6">
                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding HoraTexto}" FontSize="11" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding CodigoSeguimiento}" FontSize="11.5" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                <Border Grid.Column="2" BackgroundColor="{Binding TipoEventoBadgeBg}" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="6,2" VerticalOptions="Center">
                                                    <Label Text="{Binding TipoEventoTexto}" FontSize="9.5" FontAttributes="Bold" TextColor="{Binding TipoEventoBadgeTextColor}" />
                                                </Border>
                                                <Label Grid.Column="3" IsVisible="{Binding TienePermanencia}" Text="{Binding PermanenciaTexto}" FontSize="10.5" TextColor="#64748B" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Botones de Acción -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0,6,0,0">
                                <Button Grid.Column="0"
                                        Text="Forzar Lectura GPS"
                                        Command="{Binding ForzarLecturaGpsDesdeModalCommand}"
                                        BackgroundColor="{DynamicResource SecondaryColor}"
                                        TextColor="#FFFFFF"
                                        FontAttributes="Bold"
                                        FontSize="11.5"
                                        HeightRequest="42"
                                        CornerRadius="8" />

                                <Button Grid.Column="1"
                                        Text="Cerrar Panel"
                                        Command="{Binding CerrarModalesCommand}"
                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                        TextColor="#FFFFFF"
                                        FontAttributes="Bold"
                                        FontSize="11.5"
                                        HeightRequest="42"
                                        CornerRadius="8" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- OVERLAY 4: MODAL 3 - OPTIMIZACIÓN DEL ORDEN (2-OPT)       -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="{Binding MostrarModalOptimizacion}"
              BackgroundColor="#80000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarModalesCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="#FFFFFF"
                    Stroke="{DynamicResource SecondaryColor}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Margin="18,30,18,30"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="420"
                    Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 14,14,0,0"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            Padding="16,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Optimizacion del Orden de Paradas (2-Opt)"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="✕"
                                    Command="{Binding DescartarOptimizacionModalCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#FFFFFF"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    Padding="0" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="12" Padding="16,14">
                        <Label Text="{Binding MensajeAvisoOptimizacion}"
                               FontSize="12"
                               TextColor="#475569" />

                        <!-- Resumen Comparativo: Original vs Optimizada -->
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,10">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Ruta Original (Despacho):" FontSize="11.5" TextColor="#64748B" />
                                    <Label Grid.Column="1" Text="{Binding OptimizacionRutaOriginalTexto}" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#CBD5E1" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Ruta Optimizada (2-Opt):" FontSize="11.5" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                    <Label Grid.Column="1" Text="{Binding OptimizacionRutaOptimizadaTexto}" FontSize="12.5" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Métricas Destacadas de Ahorro en SecondaryColor -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource SecondarySoftBackground}" Stroke="{DynamicResource SecondaryColor}" StrokeThickness="1.2" StrokeShape="RoundRectangle 8" Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="KM AHORRADOS" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                    <Label Text="{Binding OptimizacionKmReducidosTexto}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource SecondaryColor}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="{DynamicResource SecondarySoftBackground}" Stroke="{DynamicResource SecondaryColor}" StrokeThickness="1.2" StrokeShape="RoundRectangle 8" Padding="10,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="MINUTOS ESTIMADOS" FontSize="9.5" FontAttributes="Bold" TextColor="#64748B" />
                                    <Label Text="{Binding OptimizacionMinutosReducidosTexto}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource SecondaryColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Botones de Acción -->
                        <VerticalStackLayout Spacing="8" Margin="0,6,0,0">
                            <Button Text="Aplicar Nuevo Orden Optimizador"
                                    Command="{Binding AplicarOptimizacionDesdeModalCommand}"
                                    IsEnabled="{Binding PuedeAplicarOptimizacion}"
                                    BackgroundColor="{DynamicResource SecondaryColor}"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HeightRequest="44"
                                    CornerRadius="8" />

                            <Button Text="Descartar y Mantener Orden Actual"
                                    Command="{Binding DescartarOptimizacionModalCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    BorderColor="#CBD5E1"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="38"
                                    CornerRadius="8" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- BANNER / TOAST CORPORATIVO FLOTANTE                       -->
        <!-- ========================================================= -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                IsVisible="{Binding MostrarToast}"
                BackgroundColor="{Binding ToastBgColor}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                Padding="16,10"
                Margin="20,12,20,0"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                ZIndex="999">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.25" />
            </Border.Shadow>
            <Label Text="{Binding MensajeToast}"
                   TextColor="#FFFFFF"
                   FontAttributes="Bold"
                   FontSize="12.5"
                   HorizontalTextAlignment="Center" />
        </Border>

        <!-- ========================================================= -->
        <!-- OVERLAY 5: MODAL 4 - FINALIZACIÓN Y RENDICIÓN DE RUTA     -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="{Binding MostrarModalFinalizarRuta}"
              BackgroundColor="#80000000"
              ZIndex="998">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarModalFinalizarRutaCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="#FFFFFF"
                    Stroke="{DynamicResource SecondaryColor}"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 16"
                    Margin="18,30,18,30"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="420"
                    Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 14,14,0,0"
                            BackgroundColor="{DynamicResource PrimaryColor}"
                            Padding="16,12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Rendicion y Cierre de Hoja de Ruta"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="X"
                                    Command="{Binding CerrarModalFinalizarRutaCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#FFFFFF"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    Padding="0" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="12" Padding="16,14">
                        <Label Text="Resumen de jornada para cierre formal de operaciones y retorno a deposito."
                               FontSize="12"
                               TextColor="#475569" />

                        <!-- Grid de 3 KPIs de Cierre -->
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="#F0FDF4" Stroke="#86EFAC" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="ENTREGADAS" FontSize="9" FontAttributes="Bold" TextColor="#166534" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding KpiEntregasExitosasCount}" FontSize="20" FontAttributes="Bold" TextColor="#15803D" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="FALLIDAS" FontSize="9" FontAttributes="Bold" TextColor="#991B1B" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding KpiIntentosFallidosCount}" FontSize="20" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" BackgroundColor="{DynamicResource SecondarySoftBackground}" Stroke="{DynamicResource SecondaryColor}" StrokeThickness="1.2" StrokeShape="RoundRectangle 8" Padding="8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="A DEVOLVER" FontSize="9" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding KpiBultosRetornoCount}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource SecondaryColor}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Advertencia si aún hay paradas pendientes -->
                        <Border IsVisible="{Binding TieneParadasPendientesAlFinalizar}"
                                BackgroundColor="#FEF2F2"
                                Stroke="#FCA5A5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,10">
                            <Label Text="{Binding MensajeAdvertenciaPendientes}"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#991B1B" />
                        </Border>

                        <!-- Botones de Acción -->
                        <VerticalStackLayout Spacing="8" Margin="0,6,0,0">
                            <Button Text="Confirmar Cierre con Biometria"
                                    Command="{Binding ConfirmarCierreConBiometriaCommand}"
                                    BackgroundColor="{DynamicResource PrimaryColor}"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HeightRequest="44"
                                    CornerRadius="8" />

                            <Button Text="Volver a la Ruta"
                                    Command="{Binding CerrarModalFinalizarRutaCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#475569"
                                    BorderColor="#CBD5E1"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    HeightRequest="38"
                                    CornerRadius="8" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
