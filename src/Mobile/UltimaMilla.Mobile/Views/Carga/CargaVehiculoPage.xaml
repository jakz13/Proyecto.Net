<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Carga"
             xmlns:controls="clr-namespace:UltimaMilla.Mobile.Controls"
             x:Class="UltimaMilla.Mobile.Views.Carga.CargaVehiculoPage"
             x:DataType="vm:CargaVehiculoViewModel"
             Title="Control de Carga"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding ActualizarRutasServidorCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="{DynamicResource EspaciadoSecciones}" Padding="{DynamicResource PaddingPagina}">

                <!-- ========================================================= -->
                <!-- TARJETA DE RESUMEN DE VEHÍCULO Y RUTA                     -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Control de Carga en Vehículo"
                               Style="{StaticResource H2Label}" />
                        <Label Text="Verificación y escaneo de bultos asignados al móvil antes de iniciar la jornada."
                               Style="{StaticResource BodyLabel}" />

                        <BoxView HeightRequest="1" Color="{StaticResource CardBorder}" Margin="0,4" />

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="6">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Vehículo Asignado" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Patente}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Hoja de Ruta" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding NumeroRuta}" FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Capacidad" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding VehiculoTipo}" Style="{StaticResource BodyLabel}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Estado de Ruta" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding EstadoHojaDeRuta}" FontAttributes="Bold" TextColor="{StaticResource SecondaryDark}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Selector de Hojas de Ruta del Repartidor (múltiples rutas del día) -->
                        <Border IsVisible="{Binding TieneMultiplesRutas}"
                                BackgroundColor="#F8FAFC"
                                Stroke="#CBD5E1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,6"
                                Margin="0,6,0,0">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Text="Ruta:"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#334155"
                                       VerticalOptions="Center" />
                                <Picker Grid.Column="1"
                                        ItemsSource="{Binding HojasDeRutaDisponibles}"
                                        ItemDisplayBinding="{Binding TituloSelector}"
                                        SelectedItem="{Binding HojaDeRutaSeleccionada}"
                                        FontSize="12"
                                        TextColor="#0F172A"
                                        Title="Seleccionar Ruta"
                                        VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        Text="Actualizar"
                                        Command="{Binding ActualizarRutasServidorCommand}"
                                        BackgroundColor="#0F172A"
                                        TextColor="White"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        CornerRadius="6"
                                        HeightRequest="32"
                                        Padding="8,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            <!-- ========================================================= -->
            <!-- PROGRESO DE ESCANEO Y ALERTAS DE DISCREPANCIA             -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="10">
                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="SpaceBetween"
                                AlignItems="Center"
                                AlignContent="Start">
                        <Label Text="Progreso de Carga" Style="{StaticResource H3Label}" Margin="0,0,8,2" />
                        <Label Text="{Binding BultosCargados, StringFormat='{0} bultos cargados'}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               Margin="0,0,0,2" />
                    </FlexLayout>

                    <ProgressBar Progress="{Binding ProgresoEscaneo}"
                                 ProgressColor="{StaticResource Primary}"
                                 HeightRequest="8" />

                    <Label Text="{Binding ResumenEstadoTexto}"
                           Style="{StaticResource CaptionLabel}" />

                    <!-- Alerta de Discrepancia -->
                    <Border IsVisible="{Binding TieneDiscrepancias}"
                            BackgroundColor="#FEF3C7"
                            Stroke="#F59E0B"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Discrepancia en la Carga"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="#92400E" />
                            <Label Text="{Binding MensajeDiscrepancia, FallbackValue='Revise los bultos pendientes o sobrantes antes de despachar.'}"
                                   FontSize="11"
                                   TextColor="#78350F" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Botón Principal de Escaneo con Cámara -->
                    <Button Text="Escanear con Cámara"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding EscanearConCamaraCommand}"
                            HeightRequest="46"
                            FontSize="13"
                            FontAttributes="Bold"
                            Margin="0,4,0,0" />

                    <!-- Lector / Buscador Directo de Código de Bulto -->
                    <Label Text="Ingreso Manual o Lector Láser" Style="{StaticResource CaptionLabel}" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                Stroke="{StaticResource InputBorder}"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,0"
                                HeightRequest="44"
                                BackgroundColor="{StaticResource InputBackground}">
                            <Entry Text="{Binding CodigoEscaneoInput, Mode=TwoWay}"
                                   Placeholder="Código del bulto"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   TextColor="{StaticResource TextPrimary}"
                                   ReturnCommand="{Binding EscanearCodigoManualCommand}"
                                   ClearButtonVisibility="WhileEditing"
                                   VerticalOptions="Center" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="Validar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding EscanearCodigoManualCommand}"
                                HeightRequest="44"
                                Padding="16,0"
                                FontSize="13" />
                    </Grid>

                    <!-- Botones de Acción de Escaneo Auxiliares -->
                    <controls:AdaptiveRow Spacing="10" Margin="0,4,0,0">
                        <Button Text="Más Opciones"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding EscanearBultoCommand}"
                                HeightRequest="40"
                                FontSize="12" />

                        <Button Text="Actualizar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ActualizarCommand}"
                                HeightRequest="40"
                                FontSize="12" />
                    </controls:AdaptiveRow>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- SECCIÓN: BULTOS PENDIENTES DE ESCANEO -->
            <!-- ========================================================= -->
            <FlexLayout Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="SpaceBetween"
                        AlignItems="Center"
                        AlignContent="Start"
                        Margin="4,4,0,0">
                <Label Text="Bultos Pendientes de Escaneo"
                       Style="{StaticResource H3Label}" />
                <Label Text="{Binding BultosPendientes.Count, StringFormat='{0} pendiente(s)'}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Danger}" />
            </FlexLayout>

            <!-- Aviso cuando no hay bultos pendientes (Carga completada o ruta ya despachada) -->
            <Border IsVisible="{Binding SinBultosPendientes}"
                    BackgroundColor="#F8FAFC"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="16,14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="No hay bultos pendientes de escaneo. Carga completada."
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#166534" />
                    <Label Text="Todos los bultos asignados han sido verificados en el vehículo o la ruta ya fue despachada."
                           FontSize="12"
                           TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

            <!-- Lista de Bultos Pendientes -->
            <VerticalStackLayout IsVisible="{Binding TieneBultosPendientes}"
                                 BindableLayout.ItemsSource="{Binding BultosPendientes}"
                                 Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:BultoCargaItemViewModel">
                        <Border BackgroundColor="{Binding CardBgColor}"
                                Stroke="{Binding CardBorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CargaVehiculoViewModel}}, Path=TocarBultoPendienteCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding CodigoBulto}"
                                                  FontAttributes="Bold"
                                                  FontSize="15"
                                                  TextColor="{StaticResource TextPrimary}" />
                                            <Span Text="  " />
                                            <Span Text="{Binding ParadaOrden, StringFormat='(Parada {0})'}"
                                                  FontSize="13"
                                                  TextColor="{StaticResource TextMuted}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Border Grid.Row="0" Grid.Column="1"
                                        BackgroundColor="{Binding BadgeColor}"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="8,3"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding EstadoTexto}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{Binding BadgeTextColor}" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Destinatario}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" />

                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding Direccion}"
                                       Style="{StaticResource CaptionLabel}" />

                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding PesoKg, StringFormat='{0:F1} kg'}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ========================================================= -->
            <!-- SECCIÓN: BULTOS CARGADOS EN EL VEHÍCULO / EN DEVOLUCIÓN   -->
            <!-- ========================================================= -->
            <VerticalStackLayout IsVisible="{Binding TieneBultosCargados}" Spacing="10" Margin="0,8,0,0">
                <FlexLayout Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="SpaceBetween"
                            AlignItems="Center"
                            AlignContent="Start"
                            Margin="4,0,0,0">
                    <Label Text="Bultos Cargados en el Vehículo"
                           Style="{StaticResource H3Label}" />
                    <Label Text="{Binding BultosCargadosLista.Count, StringFormat='{0} cargado(s)'}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Success}" />
                </FlexLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BultosCargadosLista}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BultoCargaItemViewModel">
                            <Border BackgroundColor="{Binding CardBgColor}"
                                    Stroke="{Binding CardBorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="14">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding CodigoBulto}"
                                                      FontAttributes="Bold"
                                                      FontSize="15"
                                                      TextColor="{StaticResource TextPrimary}" />
                                                <Span Text="  " />
                                                <Span Text="{Binding ParadaOrden, StringFormat='(Parada {0})'}"
                                                      FontSize="13"
                                                      TextColor="{StaticResource TextMuted}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{Binding BadgeColor}"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,3"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding EstadoTexto}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding BadgeTextColor}" />
                                    </Border>

                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Destinatario}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="{StaticResource TextSecondary}" />

                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="{Binding Direccion}"
                                           Style="{StaticResource CaptionLabel}" />

                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="{Binding PesoKg, StringFormat='{0:F1} kg'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ========================================================= -->
            <!-- SECCIÓN: BULTOS SOBRANTES / DISCREPANCIAS -->
            <!-- ========================================================= -->
            <VerticalStackLayout IsVisible="{Binding TieneSobrantes}"
                                 Spacing="10"
                                 Margin="0,8,0,0">
                <Label Text="Bultos Sobrantes Detectados"
                       Style="{StaticResource H3Label}"
                       TextColor="{StaticResource Danger}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BultosSobrantes}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BultoCargaItemViewModel">
                            <Border BackgroundColor="#FEF2F2"
                                    Stroke="#FCA5A5"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="14">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding CodigoBulto}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="{StaticResource Danger}" />

                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="#FEE2E2"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,3">
                                        <Label Text="Sobrante"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Danger}" />
                                    </Border>

                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Direccion}"
                                           FontSize="12"
                                           TextColor="#7F1D1D" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ========================================================= -->
            <!-- BOTONES DE ACCIÓN PRINCIPAL (SALIDA / DESPACHO)           -->
            <!-- ========================================================= -->
            <VerticalStackLayout Spacing="8" Margin="0,12,0,24">
                <!-- Estado frente al depósito: sin ruta, esperando despacho o ruta despachada -->
                <Border BackgroundColor="#EFF6FF"
                        Stroke="#93C5FD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,10"
                        IsVisible="{Binding EsperandoDespacho}">
                    <Label Text="{Binding MensajeEstadoDespacho}"
                           FontSize="12"
                           TextColor="#1E3A8A" />
                </Border>

                <!-- Botón para informar la carga al depósito (el despacho lo hace el despachador) -->
                <Button Text="Confirmar carga"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding ConfirmarCargaCommand}"
                        IsEnabled="{Binding PuedeConfirmarCarga}"
                        IsVisible="{Binding EsRutaLiberada}"
                        HeightRequest="52"
                        FontSize="14" />

                <!-- Botón para iniciar recorrido: solo cuando el depósito despachó la ruta -->
                <Button Text="Iniciar Recorrido en Calle"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding IniciarRecorridoCommand}"
                        IsEnabled="{Binding PuedeIniciarRecorrido}"
                        IsVisible="{Binding EsRutaDespachada}"
                        HeightRequest="52"
                        FontSize="14" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>

</ContentPage>
