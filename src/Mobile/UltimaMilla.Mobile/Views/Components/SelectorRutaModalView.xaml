<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:UltimaMilla.Mobile.Views.Components"
             xmlns:models="clr-namespace:UltimaMilla.Mobile.Models.Local"
             x:Class="UltimaMilla.Mobile.Views.Components.SelectorRutaModalView"
             x:Name="SelectorRutaRoot"
             x:DataType="components:ISelectorRutaModalHost"
             IsVisible="{Binding MostrarModalSelectorRuta}">

    <Grid BackgroundColor="#990F172A" Padding="20">
        <!-- Capa transparente inferior para cerrar tocando fuera de la tarjeta -->
        <BoxView Color="Transparent">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarSelectorRutaCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border VerticalOptions="Center"
                HorizontalOptions="Fill"
                MaximumWidthRequest="440"
                MaximumHeightRequest="600"
                BackgroundColor="#FFFFFF"
                Stroke="{DynamicResource CardBorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20">
            <Border.Shadow>
                <Shadow Brush="#0F172A" Offset="0,10" Radius="24" Opacity="0.25" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Cabecera corporativa en PrimaryColor -->
                <Border Grid.Row="0"
                        BackgroundColor="{DynamicResource PrimaryColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20,20,0,0"
                        Padding="18,16">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Seleccionar hoja de ruta"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                            <Label Text="Elija la hoja de ruta activa para operar"
                                   FontSize="11.5"
                                   TextColor="#E2E8F0" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#33FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,5"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CerrarSelectorRutaCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Cerrar"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Lista de tarjetas seleccionables de rutas -->
                <ScrollView Grid.Row="1" Padding="14,14">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding HojasDeRutaDisponibles}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:HojaDeRutaSelectorItem">
                                <Border BackgroundColor="#FFFFFF"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14,12">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding EsSeleccionada}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryLight}" />
                                            <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference SelectorRutaRoot}, Path=BindingContext.SeleccionarRutaDelModalCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="6">
                                        <!-- Fila 1: Número de ruta + indicador Activa + Badge de estado -->
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding NumeroRuta}"
                                                       FontSize="14.5"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A"
                                                       VerticalOptions="Center" />
                                                <Border IsVisible="{Binding EsSeleccionada}"
                                                        BackgroundColor="{DynamicResource PrimaryColor}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="7,2"
                                                        VerticalOptions="Center">
                                                    <Label Text="Activa"
                                                           FontSize="9.5"
                                                           FontAttributes="Bold"
                                                           TextColor="#FFFFFF" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding EstadoBgColor}"
                                                    Stroke="{Binding EstadoBorderColor}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="8,3"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding EstadoDescripcion}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding EstadoTextColor}" />
                                            </Border>
                                        </Grid>

                                        <!-- Fila 2: Fecha y Patente -->
                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                            <Label Grid.Column="0"
                                                   Text="{Binding FechaTexto, StringFormat='Fecha: {0}'}"
                                                   FontSize="11.5"
                                                   TextColor="#475569" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding VehiculoTexto}"
                                                   FontSize="11.5"
                                                   FontAttributes="Bold"
                                                   TextColor="#334155"
                                                   HorizontalTextAlignment="End"
                                                   LineBreakMode="TailTruncation" />
                                        </Grid>

                                        <!-- Fila 3: Conteo de paradas pendientes y completadas -->
                                        <Label Text="{Binding ResumenParadasModalTexto}"
                                               FontSize="11.5"
                                               TextColor="#475569" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Pie con botón Cancelar -->
                <VerticalStackLayout Grid.Row="2" BackgroundColor="#F8FAFC" Spacing="0">
                    <BoxView HeightRequest="1" Color="#E2E8F0" />
                    <Grid Padding="14,12">
                        <Button Text="Cancelar"
                                Command="{Binding CerrarSelectorRutaCommand}"
                                BackgroundColor="#FFFFFF"
                                TextColor="#475569"
                                BorderColor="#CBD5E1"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                HeightRequest="42"
                                CornerRadius="10" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentView>
