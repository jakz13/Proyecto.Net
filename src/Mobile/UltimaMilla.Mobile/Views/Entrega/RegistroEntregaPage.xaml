<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Entrega"
             x:Class="UltimaMilla.Mobile.Views.Entrega.RegistroEntregaPage"
             x:DataType="vm:RegistroEntregaViewModel"
             Title="Confirmar Entrega"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="{DynamicResource EspaciadoSecciones}" Padding="{DynamicResource PaddingPagina}">

            <!-- ========================================================= -->
            <!-- TARJETA RESUMEN DEL ENVÍO / PARADA                        -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="Parada en Curso"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding ParadaSeleccionada.Direccion, FallbackValue='Bvar. España 2678, Pocitos'}"
                           Style="{StaticResource H3Label}" />

                    <Label Text="{Binding ParadaSeleccionada.Destinatario, FallbackValue='Destinatario: Lucía Fernández'}"
                           Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- FORMULARIO DE DATOS DEL RECEPTOR                          -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos de Quién Recibe"
                           Style="{StaticResource H3Label}" />

                    <!-- Nombre del Receptor -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre y Apellido *"
                               FontSize="13"
                               FontAttributes="Bold" />

                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding NombreReceptor}"
                                   Placeholder="Ej. María López"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Documento del Receptor -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Documento / C.I. *"
                               FontSize="13"
                               FontAttributes="Bold" />

                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding DocumentoReceptor}"
                                   Placeholder="Ej. 4.123.456-7"
                                   Keyboard="Numeric"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- ÁREA DE FIRMA DIGITAL EN PANTALLA                         -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="10">
                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="SpaceBetween"
                                AlignItems="Center"
                                AlignContent="Start">
                        <Label Text="Firma Digital en Pantalla *"
                               Style="{StaticResource H3Label}"
                               Margin="0,0,8,4" />

                        <HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
                            <Button Text="Firma Demo"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="36"
                                    Padding="10,0"
                                    FontSize="12"
                                    Command="{Binding SimularFirmaCommand}" />

                            <Button Text="Limpiar"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="36"
                                    Padding="10,0"
                                    FontSize="12"
                                    Command="{Binding LimpiarFirmaCommand}" />
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <Label Text="Dibuje la firma con el mouse o dedo en el recuadro blanco:"
                           Style="{StaticResource CaptionLabel}" />

                    <!-- Pad interactivo de dibujo con GraphicsView sin vistas superpuestas -->
                    <Border HeightRequest="160"
                            Stroke="{StaticResource InputBorder}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#FFFFFF"
                            Padding="0">
                        <GraphicsView x:Name="SignatureView"
                                      StartInteraction="OnSignatureStartInteraction"
                                      DragInteraction="OnSignatureDragInteraction"
                                      EndInteraction="OnSignatureEndInteraction"
                                      HeightRequest="160"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill" />
                    </Border>

                    <Label Text="{Binding FirmaStatusText}"
                           Style="{StaticResource CaptionLabel}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- FOTOGRAFÍA / EVIDENCIA DE ENTREGA                         -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Evidencia Fotográfica"
                           Style="{StaticResource H3Label}" />

                    <Label Text="Capture o adjunte una fotografía del bulto entregado o del remito conformado:"
                           Style="{StaticResource CaptionLabel}" />

                    <!-- Botón principal de captura cuando aún no hay fotografía -->
                    <Button Text="Capturar / Adjuntar Fotografía"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AbrirCamaraCommand}"
                            IsVisible="{Binding NoTieneFoto}" />

                    <!-- Contenedor de previsualización de miniatura cuando hay foto adjunta -->
                    <Border IsVisible="{Binding TieneFoto}"
                            BackgroundColor="#F8FAFC"
                            Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 12"
                            Padding="10">
                        <VerticalStackLayout Spacing="10">
                            <Border HeightRequest="180"
                                    Stroke="{StaticResource InputBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#FFFFFF"
                                    Padding="4">
                                <Image Source="{Binding FotoPreviewSource}"
                                       Aspect="AspectFit"
                                       HeightRequest="170"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                            </Border>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="Reemplazar Foto"
                                        Style="{StaticResource SecondaryButton}"
                                        HeightRequest="42"
                                        MinimumHeightRequest="40"
                                        Padding="12,6"
                                        FontSize="13"
                                        Command="{Binding AbrirCamaraCommand}" />

                                <Button Grid.Column="1"
                                        Text="Quitar Foto"
                                        Style="{StaticResource DangerOutlineButton}"
                                        HeightRequest="42"
                                        MinimumHeightRequest="40"
                                        Padding="12,6"
                                        FontSize="13"
                                        Command="{Binding QuitarFotoCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Indicador de estado de la evidencia fotográfica -->
                    <Border BackgroundColor="#F8FAFC"
                            Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,8">
                        <Label Text="{Binding FotoStatusText}"
                               Style="{StaticResource CaptionLabel}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- BOTÓN PRINCIPAL DE ACCIÓN: GUARDAR ENTREGA                -->
            <!-- ========================================================= -->
            <Button Text="Guardar Entrega"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding GuardarEntregaCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HeightRequest="52"
                    FontSize="16"
                    Margin="0,8,0,24" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
