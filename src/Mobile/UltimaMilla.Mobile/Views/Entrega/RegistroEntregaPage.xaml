<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Entrega"
             x:Class="UltimaMilla.Mobile.Views.Entrega.RegistroEntregaPage"
             x:DataType="vm:RegistroEntregaViewModel"
             Title="Confirmar Entrega"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="2, *">
        <BoxView Grid.Row="0" HeightRequest="2" Color="{DynamicResource SecondaryColor}" />

        <ScrollView Grid.Row="1" x:Name="FormularioScrollView">
            <VerticalStackLayout Spacing="14" Padding="14,12,14,24">

                <!-- ========================================================= -->
                <!-- TARJETA RESUMEN DEL ENVÍO / PARADA                        -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="Rectangle"
                                BackgroundColor="#F8FAFC"
                                Padding="14,10">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <BoxView WidthRequest="4" HeightRequest="18" CornerRadius="2" Color="{DynamicResource PrimaryColor}" VerticalOptions="Center" />
                                <Label Text="Parada en Curso"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryColor}" />
                            </HorizontalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <VerticalStackLayout Spacing="4" Padding="14,12">
                            <Label Text="{Binding ParadaSeleccionada.Direccion, FallbackValue='Direccion de destino'}"
                                   FontSize="15.5"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />

                            <Label Text="{Binding ParadaSeleccionada.Destinatario, FallbackValue='Destinatario del envio'}"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- BULTOS DE LA PARADA: ENTREGA TOTAL O PARCIAL              -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}" Padding="0" IsVisible="{Binding TieneVariosBultos}">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="Rectangle"
                                BackgroundColor="#F8FAFC"
                                Padding="14,10">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <BoxView WidthRequest="4" HeightRequest="18" CornerRadius="2" Color="{DynamicResource SecondaryColor}" VerticalOptions="Center" />
                                <Label Text="Bultos que se Entregan"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </HorizontalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <VerticalStackLayout Spacing="10" Padding="14,12">
                            <Label Text="Todos vienen marcados. Desmarque los que no se entregan ahora, o escanee un bulto para confirmarlo."
                                   FontSize="12"
                                   TextColor="#475569" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Bultos}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BultoEntregaItemViewModel">
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="{DynamicResource CardBorderColor}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="10,6">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Entregado, Mode=TwoWay}" Color="{DynamicResource PrimaryColor}" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding Codigo}" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="{Binding PesoTexto}" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="{Binding ResumenBultosTexto}"
                                   FontAttributes="Bold"
                                   FontSize="12.5"
                                   TextColor="{DynamicResource PrimaryColor}" />

                            <Button Text="Escanear Bulto"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding EscanearBultoCommand}"
                                    CornerRadius="8"
                                    HeightRequest="42"
                                    FontSize="13" />

                            <!-- Solo en entrega parcial: motivo de los bultos que quedan pendientes -->
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding EsEntregaParcial}">
                                <Label Text="MOTIVO DE LOS BULTOS NO ENTREGADOS *"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />
                                <Border Style="{StaticResource InputContainer}">
                                    <Picker ItemsSource="{Binding MotivosNoEntrega}"
                                            SelectedItem="{Binding MotivoSeleccionado, Mode=TwoWay}"
                                            Title="Seleccione el motivo" />
                                </Border>
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry Text="{Binding ObservacionesPendientes}"
                                           Placeholder="Observaciones (opcional)"
                                           ClearButtonVisibility="WhileEditing" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- FORMULARIO DE DATOS DEL RECEPTOR                          -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="Rectangle"
                                BackgroundColor="#F8FAFC"
                                Padding="14,10">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <BoxView WidthRequest="4" HeightRequest="18" CornerRadius="2" Color="{DynamicResource SecondaryColor}" VerticalOptions="Center" />
                                <Label Text="Datos de Quien Recibe"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </HorizontalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <VerticalStackLayout Spacing="12" Padding="14,12">
                            <!-- Nombre del Receptor -->
                            <VerticalStackLayout Spacing="5">
                                <Label Text="NOMBRE Y APELLIDO *"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />

                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="#CBD5E1"
                                        StrokeThickness="1.2"
                                        BackgroundColor="#FFFFFF"
                                        Padding="12,0"
                                        HeightRequest="44">
                                    <Entry Text="{Binding NombreReceptor}"
                                           Placeholder="Nombre completo del receptor"
                                           ClearButtonVisibility="WhileEditing" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Documento del Receptor -->
                            <VerticalStackLayout Spacing="5">
                                <Label Text="DOCUMENTO / C.I. *"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />

                                <Border StrokeShape="RoundRectangle 8"
                                        Stroke="#CBD5E1"
                                        StrokeThickness="1.2"
                                        BackgroundColor="#FFFFFF"
                                        Padding="12,0"
                                        HeightRequest="44">
                                    <Entry Text="{Binding DocumentoReceptor}"
                                           Placeholder="Documento de identidad"
                                           Keyboard="Numeric"
                                           ClearButtonVisibility="WhileEditing" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- ÁREA DE FIRMA DIGITAL EN PANTALLA                         -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="Rectangle"
                                BackgroundColor="#F8FAFC"
                                Padding="14,10">
                            <FlexLayout Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="SpaceBetween"
                                        AlignItems="Center">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <BoxView WidthRequest="4" HeightRequest="18" CornerRadius="2" Color="{DynamicResource SecondaryColor}" VerticalOptions="Center" />
                                    <Label Text="Firma Digital en Pantalla *"
                                           FontSize="14.5"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A" />
                                </HorizontalStackLayout>

                                <Button Text="Limpiar Firma"
                                        BackgroundColor="{DynamicResource SecondarySoftBackground}"
                                        TextColor="{DynamicResource SecondaryColor}"
                                        BorderColor="{DynamicResource SecondaryColor}"
                                        BorderWidth="1"
                                        FontAttributes="Bold"
                                        HeightRequest="30"
                                        MinimumHeightRequest="28"
                                        Padding="10,0"
                                        FontSize="11"
                                        CornerRadius="6"
                                        Command="{Binding LimpiarFirmaCommand}" />
                            </FlexLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <VerticalStackLayout Spacing="10" Padding="14,12">
                            <Label Text="Dibuje la firma con el dedo o puntero en el recuadro blanco:"
                                   FontSize="12"
                                   TextColor="#475569" />

                            <Border HeightRequest="180"
                                    Stroke="{DynamicResource SecondaryColor}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#FFFFFF"
                                    Padding="0">
                                <GraphicsView x:Name="FirmaGraphicsView"
                                              StartInteraction="OnSignatureStartInteraction"
                                              DragInteraction="OnSignatureDragInteraction"
                                              EndInteraction="OnSignatureEndInteraction"
                                              HeightRequest="180"
                                              HorizontalOptions="Fill"
                                              VerticalOptions="Fill" />
                            </Border>

                            <Label Text="{Binding FirmaStatusText}"
                                   FontSize="11.5"
                                   FontAttributes="Bold"
                                   TextColor="#475569"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- FOTOGRAFÍA / EVIDENCIA DE ENTREGA                         -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="Rectangle"
                                BackgroundColor="#F8FAFC"
                                Padding="14,10">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <BoxView WidthRequest="4" HeightRequest="18" CornerRadius="2" Color="{DynamicResource SecondaryColor}" VerticalOptions="Center" />
                                <Label Text="Evidencia Fotografica"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </HorizontalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <VerticalStackLayout Spacing="10" Padding="14,12">
                            <Label Text="Capture o adjunte una fotografia del bulto entregado o del remito conformado:"
                                   FontSize="12"
                                   TextColor="#475569" />

                            <Button Text="Capturar o Adjuntar Fotografia"
                                    Style="{StaticResource SecondaryButton}"
                                    CornerRadius="8"
                                    HeightRequest="44"
                                    Command="{Binding AbrirCamaraCommand}"
                                    IsVisible="{Binding NoTieneFoto}" />

                            <Border IsVisible="{Binding TieneFoto}"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="{DynamicResource CardBorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10">
                                <VerticalStackLayout Spacing="10">
                                    <Border HeightRequest="180"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#FFFFFF"
                                            Padding="4">
                                        <Image Source="{Binding FotoPreviewSource}"
                                               Aspect="AspectFit"
                                               HeightRequest="170"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />
                                    </Border>

                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                        <Button Grid.Column="0"
                                                Text="Reemplazar Foto"
                                                Style="{StaticResource SecondaryButton}"
                                                CornerRadius="8"
                                                HeightRequest="40"
                                                MinimumHeightRequest="38"
                                                Padding="12,6"
                                                FontSize="12.5"
                                                Command="{Binding AbrirCamaraCommand}" />

                                        <Button Grid.Column="1"
                                                Text="Quitar Foto"
                                                Style="{StaticResource DangerOutlineButton}"
                                                CornerRadius="8"
                                                HeightRequest="40"
                                                MinimumHeightRequest="38"
                                                Padding="12,6"
                                                FontSize="12.5"
                                                Command="{Binding QuitarFotoCommand}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="#F8FAFC"
                                    Stroke="{DynamicResource CardBorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,7">
                                <Label Text="{Binding FotoStatusText}"
                                       FontSize="11.5"
                                       FontAttributes="Bold"
                                       TextColor="#475569"
                                       HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- AUDITORÍA DE GEO-POSICIÓN Y FECHA/HORA                    -->
                <!-- ========================================================= -->
                <Border Style="{StaticResource CardView}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border StrokeThickness="0"
                                StrokeShape="Rectangle"
                                BackgroundColor="#F8FAFC"
                                Padding="14,10">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <BoxView WidthRequest="4" HeightRequest="18" CornerRadius="2" Color="{DynamicResource PrimaryColor}" VerticalOptions="Center" />
                                <Label Text="Auditoria de Captura en Terreno"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </HorizontalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="{DynamicResource CardBorderColor}" />

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto" ColumnSpacing="10" Padding="14,12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="POSICION GPS" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding PosicionGpsTexto, FallbackValue='Consultando GPS...'}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="#0F172A" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="FECHA Y HORA" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding FechaHoraCapturaTexto, FallbackValue='--/--/---- --:--:--'}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ========================================================= -->
                <!-- BOTÓN PRINCIPAL DE ACCIÓN: GUARDAR ENTREGA                -->
                <!-- ========================================================= -->
                <Button Text="{Binding TituloGuardar}"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding GuardarEntregaCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        CornerRadius="8"
                        HeightRequest="50"
                        FontSize="15"
                        Margin="0,6,0,20" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
