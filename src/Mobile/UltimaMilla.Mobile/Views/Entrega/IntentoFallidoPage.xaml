<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Entrega"
             x:Class="UltimaMilla.Mobile.Views.Entrega.IntentoFallidoPage"
             x:DataType="vm:IntentoFallidoViewModel"
             Title="Registrar Intento Fallido"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="{DynamicResource EspaciadoSecciones}" Padding="{DynamicResource PaddingFormulario}">

            <!-- ========================================================= -->
            <!-- 1. BANNER DE PROTOCOLO Y RESUMEN DE LA PARADA             -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource WarningNoticeCard}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <!-- Tag identificador de protocolo -->
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource DangerLight}"
                                Stroke="{StaticResource Danger}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                Padding="8,4"
                                VerticalOptions="Start">
                            <Label Text="INCIDENCIA"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource DangerText}" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Incidencia en Entrega"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="{StaticResource DangerText}" />
                            <Label Text="Registrar este intento fallido reprogramará la entrega o iniciará el retorno a la central de distribución."
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource WarningCardBorder}" Margin="0,2" />

                    <!-- Resumen del domicilio y destinatario -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Parada.Direccion, FallbackValue='Bvar. España 2678, Pocitos'}"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding Parada.Destinatario, StringFormat='Destinatario: {0}', FallbackValue='Destinatario: Lucía Fernández'}"
                               Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. SELECTOR DE MOTIVO DE NO ENTREGA                       -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Motivo del Fallo *"
                           Style="{StaticResource H3Label}" />

                    <Label Text="Seleccione la causa principal por la que no se pudo concretar:"
                           Style="{StaticResource CaptionLabel}" />

                    <!-- Selector con contenedor nativo -->
                    <Border Style="{StaticResource InputContainer}">
                        <Picker Title="Seleccione un motivo..."
                                ItemsSource="{Binding MotivosNoEntrega}"
                                SelectedItem="{Binding MotivoSeleccionado}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- 3. CAMPO DE OBSERVACIONES DEL REPARTIDOR                  -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Observaciones de la Visita *"
                           Style="{StaticResource H3Label}" />

                    <Label Text="Detalle lo sucedido en el domicilio (ej. ausencia de personas, local cerrado, etc.):"
                           Style="{StaticResource CaptionLabel}" />

                    <Border Style="{StaticResource EditorContainer}" HeightRequest="105">
                        <Editor Text="{Binding Observaciones}"
                                Placeholder="Escriba aquí los detalles obligatorios..."
                                AutoSize="Disabled" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- 4. EVIDENCIA FOTOGRÁFICA                                  -->
            <!-- ========================================================= -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Evidencia Fotográfica"
                           Style="{StaticResource H3Label}" />

                    <Label Text="Fotografíe la fachada o numeración para respaldar su presencia física en el punto de entrega."
                           Style="{StaticResource CaptionLabel}" />

                    <Button Text="Abrir Cámara para Evidencia"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding TomarFotoEvidenciaCommand}" />

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,8">
                        <Label Text="{Binding FotoStatusText}"
                               Style="{StaticResource CaptionLabel}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- 5. AUDITORÍA GEOGRÁFICA (GPS AUTOMÁTICO)                  -->
            <!-- ========================================================= -->
            <Border BackgroundColor="#F1F5F9"
                    Stroke="{StaticResource CardBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Auditoría GPS en terreno:"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding CoordenadasGps}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================= -->
            <!-- 6. BOTÓN PRINCIPAL: REGISTRAR INTENTO FALLIDO             -->
            <!-- ========================================================= -->
            <Button Text="Registrar Intento Fallido"
                    Style="{StaticResource DangerButton}"
                    HeightRequest="54"
                    FontSize="16"
                    CornerRadius="14"
                    Margin="0,8,0,16"
                    Command="{Binding RegistrarIncidenciaCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
