<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UltimaMilla.Mobile.ViewModels.Entrega"
             xmlns:models="clr-namespace:UltimaMilla.Mobile.Models.Local"
             xmlns:components="clr-namespace:UltimaMilla.Mobile.Views.Components"
             x:Class="UltimaMilla.Mobile.Views.Entrega.RegistroRetiroPage"
             x:Name="RegistroRetiroRoot"
             x:DataType="vm:RegistroRetiroViewModel"
             Title="Registrar Retiro"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="2, *">
        <BoxView Grid.Row="0" HeightRequest="2" Color="{DynamicResource SecondaryColor}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="{DynamicResource EspaciadoSecciones}" Padding="{DynamicResource PaddingPagina}">

            <!-- Resumen del retiro -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Retiro en domicilio"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="{Binding Parada.Direccion}"
                           Style="{StaticResource H3Label}" />
                    <Label Text="{Binding Parada.Destinatario, StringFormat='Contacto: {0}'}"
                           Style="{StaticResource CaptionLabel}" />
                    <Label Text="{Binding Parada.NotasComercio}"
                           Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Selector de modo en la parte superior (Retiro exitoso vs No se pudo retirar) -->
            <Border Style="{StaticResource CardView}" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="RESULTADO DE LA VISITA EN DOMICILIO"
                           FontSize="10.5"
                           FontAttributes="Bold"
                           TextColor="#64748B" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Retiro exitoso"
                                BackgroundColor="{Binding TabExitosoBgColor}"
                                TextColor="{Binding TabExitosoTextColor}"
                                BorderColor="{Binding TabExitosoBorderColor}"
                                BorderWidth="1.5"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                FontSize="13.5"
                                HeightRequest="44"
                                Command="{Binding SeleccionarModoRetiroExitosoCommand}" />

                        <Button Grid.Column="1"
                                Text="No se pudo retirar"
                                BackgroundColor="{Binding TabFalloBgColor}"
                                TextColor="{Binding TabFalloTextColor}"
                                BorderColor="{Binding TabFalloBorderColor}"
                                BorderWidth="1.5"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                FontSize="13.5"
                                HeightRequest="44"
                                Command="{Binding SeleccionarModoNoRetiradoCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ========================================================================= -->
            <!-- MODO: NO SE PUDO RETIRAR (VISIBLE DIRECTAMENTE ARRIBA SIN HACER SCROLL)   -->
            <!-- ========================================================================= -->
            <Border Style="{StaticResource CardView}" IsVisible="{Binding MostrarNoRealizado}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Motivo por el que no se pudo retirar *" Style="{StaticResource H3Label}" />
                    <Label Text="Seleccione el motivo del catálogo del operador y agregue observaciones si corresponde."
                           Style="{StaticResource CaptionLabel}" />

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="{DynamicResource CardBorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirSelectorMotivoCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="{Binding MotivoSelectorTexto}"
                                   FontSize="13.5"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{DynamicResource PrimaryLight}"
                                    Stroke="{DynamicResource PrimaryColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="8,4"
                                    VerticalOptions="Center">
                                <Label Text="Cambiar motivo"
                                       FontSize="10.5"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryColor}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Tarjetas corporativas de selección rápida del motivo -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MotivosModalOpciones}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:OpcionSeleccionableItem">
                                <Border BackgroundColor="#FFFFFF"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14,12">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding EsSeleccionada}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryLight}" />
                                            <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference RegistroRetiroRoot}, Path=BindingContext.SeleccionarMotivoDirectoCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding Texto}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                IsVisible="{Binding EsSeleccionada}"
                                                BackgroundColor="{DynamicResource PrimaryColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <Label Text="Seleccionado"
                                                   FontSize="9.5"
                                                   FontAttributes="Bold"
                                                   TextColor="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Observaciones (opcional)" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding ObservacionesNoRealizado}"
                                   Placeholder="Detalle adicional sobre el intento de retiro"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Confirmar retiro no realizado"
                            BackgroundColor="#DC2626"
                            TextColor="#FFFFFF"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Command="{Binding RegistrarNoRealizadoCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            HeightRequest="50"
                            FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <!-- Escaneo de los bultos a retirar -->
            <Border Style="{StaticResource CardView}" IsVisible="{Binding EsModoRetiroExitoso}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Bultos a retirar"
                           Style="{StaticResource H3Label}" />
                    <Label Text="Escanee cada bulto retirado: deben estar todos para registrar el retiro."
                           Style="{StaticResource CaptionLabel}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Bultos}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:BultoRetiroItemViewModel">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Codigo}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding EstadoTexto}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding ResumenBultosTexto}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Button Text="Escanear con cámara"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding EscanearConCamaraCommand}"
                            HeightRequest="44"
                            FontSize="13" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding CodigoManual, Mode=TwoWay}"
                                   Placeholder="Ingreso manual del código"
                                   ReturnCommand="{Binding ValidarCodigoManualCommand}"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="Validar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ValidarCodigoManualCommand}"
                                HeightRequest="44"
                                Padding="16,0"
                                FontSize="13" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Quién entrega los bultos -->
            <Border Style="{StaticResource CardView}" IsVisible="{Binding EsModoRetiroExitoso}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Datos de quien entrega los bultos"
                           Style="{StaticResource H3Label}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nombre y apellido *" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding NombreEntrega}"
                                   Placeholder="Nombre completo"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Documento (opcional)" FontSize="13" FontAttributes="Bold" />
                        <Border Style="{StaticResource InputContainer}">
                            <Entry Text="{Binding DocumentoEntrega}"
                                   Placeholder="Documento de identidad"
                                   Keyboard="Numeric"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Firma -->
            <Border Style="{StaticResource CardView}" IsVisible="{Binding EsModoRetiroExitoso}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Firma de quien entrega *"
                           Style="{StaticResource H3Label}" />
                    <Border HeightRequest="180"
                            Stroke="{StaticResource InputBorder}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#FFFFFF"
                            Padding="0">
                        <GraphicsView x:Name="FirmaGraphicsView"
                                      HeightRequest="180"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill" />
                    </Border>
                    <Button Text="Limpiar firma"
                            Style="{StaticResource DangerOutlineButton}"
                            HeightRequest="36"
                            Padding="14,0"
                            FontSize="12"
                            HorizontalOptions="Center"
                            Command="{Binding LimpiarFirmaCommand}" />
                    <Label Text="{Binding FirmaStatusText}"
                           Style="{StaticResource CaptionLabel}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Fotografía del estado de los bultos -->
            <Border Style="{StaticResource CardView}" IsVisible="{Binding EsModoRetiroExitoso}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Fotografía del estado de los bultos *"
                           Style="{StaticResource H3Label}" />

                    <Button Text="Capturar / Adjuntar fotografía"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AbrirCamaraCommand}"
                            IsVisible="{Binding NoTieneFoto}" />

                    <Border IsVisible="{Binding TieneFoto}"
                            BackgroundColor="#F8FAFC"
                            Stroke="{StaticResource CardBorder}"
                            StrokeThickness="1.2"
                            StrokeShape="RoundRectangle 12"
                            Padding="10">
                        <VerticalStackLayout Spacing="10">
                            <Image Source="{Binding FotoPreviewSource}"
                                   Aspect="AspectFit"
                                   HeightRequest="170" />
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="Reemplazar foto"
                                        Style="{StaticResource SecondaryButton}"
                                        HeightRequest="42"
                                        FontSize="13"
                                        Command="{Binding AbrirCamaraCommand}" />
                                <Button Grid.Column="1"
                                        Text="Quitar foto"
                                        Style="{StaticResource DangerOutlineButton}"
                                        HeightRequest="42"
                                        FontSize="13"
                                        Command="{Binding QuitarFotoCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding FotoStatusText}"
                           Style="{StaticResource CaptionLabel}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Auditoría de captura -->
            <Border Style="{StaticResource CardView}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Auditoría de captura" Style="{StaticResource H3Label}" />
                    <Label Text="{Binding PosicionGpsTexto}" FontAttributes="Bold" FontSize="12" />
                    <Label Text="{Binding FechaHoraCapturaTexto}" FontAttributes="Bold" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Acción principal de retiro exitoso -->
            <Button Text="Confirmar retiro"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding GuardarRetiroCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    IsVisible="{Binding EsModoRetiroExitoso}"
                    HeightRequest="52"
                    FontSize="16" />

            <BoxView HeightRequest="16" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <components:EvidenciaModalesOverlay Grid.Row="0"
                                            Grid.RowSpan="2"
                                            ZIndex="999" />
    </Grid>

</ContentPage>
