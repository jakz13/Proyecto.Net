<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UltimaMilla.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ruta="clr-namespace:UltimaMilla.Mobile.Views.Ruta"
    xmlns:carga="clr-namespace:UltimaMilla.Mobile.Views.Carga"
    Title="Última Milla Repartidor"
    Shell.TabBarBackgroundColor="#0F172A"
    Shell.TabBarForegroundColor="#FFFFFF"
    Shell.TabBarTitleColor="#FFFFFF"
    Shell.TabBarUnselectedColor="#94A3B8">

    <!-- ========================================================= -->
    <!-- NAVEGACIÓN PRINCIPAL: TABBAR INFERIOR MODERNO             -->
    <!-- ========================================================= -->
    <TabBar>
        <!-- Pestaña 1: Mi Ruta -->
        <Tab Title="Mi Ruta">
            <ShellContent
                Title="Mi Ruta"
                ContentTemplate="{DataTemplate ruta:RutaDiaPage}"
                Route="RutaDiaPage" />
        </Tab>

        <!-- Pestaña 2: Carga de Vehículo -->
        <Tab Title="Carga">
            <ShellContent
                Title="Carga"
                ContentTemplate="{DataTemplate carga:CargaVehiculoPage}"
                Route="CargaVehiculoPage" />
        </Tab>
    </TabBar>

</Shell>
