<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuracion base para produccion: se prohibe trafico en texto plano (HTTP) y se confia unicamente en CA del sistema -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Excepciones de trafico en texto plano acotadas estrictamente a desarrollo local -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Certificados de usuario admitidos exclusivamente durante sesiones de depuracion (Debug) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
