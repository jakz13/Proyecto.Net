<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#0D6EFD</Color>
    <Color x:Key="PrimaryDark">#0A58CA</Color>
    <Color x:Key="Secondary">#6C757D</Color>
    <Color x:Key="Success">#198754</Color>
    <Color x:Key="Warning">#FFC107</Color>
    <Color x:Key="Danger">#DC3545</Color>
    <Color x:Key="Light">#F8F9FA</Color>
    <Color x:Key="Dark">#212529</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="PageBackground">#F4F6F9</Color>
    <Color x:Key="TextPrimary">#212529</Color>
    <Color x:Key="TextSecondary">#6C757D</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
</ResourceDictionary>
