<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================================================================= -->
    <!-- DESIGN TOKENS: PALETA DE COLORES (Equivalente a :root variables)  -->
    <!-- ================================================================= -->

    <!-- Marca / Primarios -->
    <Color x:Key="Primary">#1D4ED8</Color>            <!-- Azul corporativo Backoffice -->
    <Color x:Key="PrimaryColor">#1D4ED8</Color>
    <Color x:Key="CorporatePrimaryColor">#1D4ED8</Color>
    <Color x:Key="PrimaryDark">#1E40AF</Color>        <!-- Azul oscuro para estados hover/active -->
    <Color x:Key="PrimaryLight">#EFF6FF</Color>       <!-- Tinte suave para fondos activos -->
    <Color x:Key="PrimaryLightColor">#EFF6FF</Color>
    <Color x:Key="PrimarySoftBackground">#EFF6FF</Color>

    <!-- Secundarios / Acentos -->
    <Color x:Key="Secondary">#F97316</Color>          <!-- Naranja acento Backoffice -->
    <Color x:Key="SecondaryColor">#F97316</Color>
    <Color x:Key="CorporateSecondaryColor">#F97316</Color>
    <Color x:Key="AccentColor">#F97316</Color>
    <Color x:Key="SecondaryDark">#EA580C</Color>
    <Color x:Key="SecondaryLight">#FFF7ED</Color>
    <Color x:Key="SecondaryLightColor">#FFF7ED</Color>
    <Color x:Key="SecondarySoftBackground">#FFF7ED</Color>

    <!-- Cabecera Corporativa Oscura (Backoffice Sidebar / Header) -->
    <Color x:Key="HeaderBackgroundColor">#0F172A</Color>
    <Color x:Key="HeaderTextColor">#FFFFFF</Color>

    <!-- Superficies y Fondos -->
    <Color x:Key="PageBackground">#F8FAFC</Color>     <!-- Fondo general de pantalla (Slate-50) -->
    <Color x:Key="CardBackground">#FFFFFF</Color>     <!-- Superficie de tarjeta blanca -->
    <Color x:Key="CardBorder">#E2E8F0</Color>         <!-- Borde sutil de tarjeta (Slate-200) -->
    <Color x:Key="CardBorderColor">#E2E8F0</Color>
    <Color x:Key="InputBackground">#FFFFFF</Color>    <!-- Fondo de inputs -->
    <Color x:Key="InputBorder">#CBD5E1</Color>        <!-- Borde de inputs (Slate-300) -->
    <Color x:Key="InputBorderFocused">#2563EB</Color>
    <Color x:Key="Neutral300">#CBD5E1</Color>
    <Color x:Key="Neutral400">#94A3B8</Color>
    <Color x:Key="PureWhite">#FFFFFF</Color>

    <!-- Tipografía / Textos -->
    <Color x:Key="TextPrimary">#0F172A</Color>        <!-- Texto principal de alto contraste (Slate-900) -->
    <Color x:Key="TextSecondary">#475569</Color>      <!-- Texto secundario descriptivo (Slate-600) -->
    <Color x:Key="TextMuted">#94A3B8</Color>          <!-- Texto atenuado/placeholders (Slate-400) -->
    <Color x:Key="TextInverse">#FFFFFF</Color>        <!-- Texto blanco sobre fondos oscuros/primarios -->

    <!-- Semánticos: Éxito (Entregado) -->
    <Color x:Key="Success">#16A34A</Color>            <!-- Verde éxito (Green-600) -->
    <Color x:Key="SuccessLight">#DCFCE7</Color>       <!-- Fondo badge verde claro -->
    <Color x:Key="SuccessText">#15803D</Color>        <!-- Texto badge verde oscuro -->

    <!-- Semánticos: Alerta / Pendiente -->
    <Color x:Key="Warning">#D97706</Color>            <!-- Ámbar (Amber-600) -->
    <Color x:Key="WarningLight">#FEF3C7</Color>       <!-- Fondo badge ámbar claro -->
    <Color x:Key="WarningText">#B45309</Color>

    <!-- Semánticos: Error / Fallido -->
    <Color x:Key="Danger">#DC2626</Color>             <!-- Rojo error (Red-600) -->
    <Color x:Key="DangerLight">#FEE2E2</Color>        <!-- Fondo badge rojo claro -->
    <Color x:Key="DangerText">#B91C1C</Color>

    <!-- Estado Offline / Red -->
    <Color x:Key="OfflineBadgeBg">#FEF2F2</Color>
    <Color x:Key="OfflineBadgeText">#991B1B</Color>
    <Color x:Key="OfflineBadgeBorder">#FCA5A5</Color>

    <!-- Semánticos: Variantes Oscuras para Pressed -->
    <Color x:Key="SuccessDark">#15803D</Color>
    <Color x:Key="WarningDark">#B45309</Color>
    <Color x:Key="DangerDark">#B91C1C</Color>

    <!-- Tarjetas de Alerta / Notas de Comercio -->
    <Color x:Key="WarningCardBg">#FFFBEB</Color>
    <Color x:Key="WarningCardBorder">#FDE68A</Color>

    <!-- Accesos Rápidos Ergonómicos -->
    <Color x:Key="PhoneActionBg">#DCFCE7</Color>
    <Color x:Key="PhoneActionBorder">#86EFAC</Color>
    <Color x:Key="PhoneActionText">#166534</Color>

    <Color x:Key="MapActionBg">#EFF6FF</Color>
    <Color x:Key="MapActionBorder">#BFDBFE</Color>
    <Color x:Key="MapActionText">#1D4ED8</Color>

    <!-- Barra de Progreso -->
    <Color x:Key="ProgressBarTrack">#E2E8F0</Color>

    <!-- Brushes utilitarios -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="CorporatePrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="CorporateSecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackground}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}"/>
</ResourceDictionary>
