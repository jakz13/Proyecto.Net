        <mxCell id="cli-mobile" parent="cli-grp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#234e52;strokeColor=#319795;fontColor=#ffffff;fontStyle=0;fontSize=10;" value="App Repartidor (.NET MAUI · MVVM)&#xa;• SQLite cifrado (offline-first + Sync)&#xa;• Entrega parcial bultos + Retiros&#xa;• Geocercas + Optimización 2-Opt&#xa;• SignalR + ForegroundSvc (Sin FCM)" vertex="1">
